function void BACE_accep_model (bundle *M,
                                bundles *known_models_array,
                                bundle *known_models_bundle)
    /*
       Function computes "probability" of the new model and checks if it is bigger than some random value drawn form U(0,1).
       *known_models_array	 - pointer to the array of (already estimated) models (for small k)
       *known_models_bundle - pointer to the bundle of (already estimated) models (for big k)
    */
    if (BACE_accept_prob(&M) > log(randgen1(u,0,1)))
        # We accept new model
        model = M.model
        if (inbundle(model, "bhat"))
            M.bhat = model.bhat
            M.bvar = model.bvar
            if (M.h_predict > 0)
                M.ess = model.ess
                M.XtXinv = model.XtXinv
            endif
        else
            M.bhat = M.bhat_tmp
            M.bvar = M.bvar_tmp
            if (M.h_predict > 0)
                M.ess = M.ess_new
            endif
        endif
        BACE_model_switch("ACCEPT", &M)
    else
        # We restore old model
        BACE_model_switch("RESTORE", &M)
    endif
end function

   but WITHOUT ANY WARRANTY; without even the implied warranty of
   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
   GNU General Public License for more details.

   You should have received a copy of the GNU General Public License
   along with this program. If not, see <http://www.gnu.org/licenses/>.
*/
function void BACE_collect_results (bundle *M, bundle *known_models,
                                    matrix *models_counter, matrix *models_lprob,
                                    matrices *models_estimates, matrices *models_structure,
                                    matrices *models_forecasts[null], matrices *models_yhat[null])
    /*
       Function collects results from MC3 experiment.
    */
    BACE_print_status("Collecting results", 0)
    matrix idx, var_idx, bhat, bvar, mod_struct, models_probs, tmp_var_idx
    matrices models_structure_rank, models_estimates_rank, cuts_estimates, cuts_estimates_rank
    scalar nr, mod_struct_sum
    scalar weight = 0
    scalar with_const = 0
    scalar yhat_shift = 0
    scalar yvals = M.model_type == "mlogit" ? nelem(M.yvals)-1 : 1
    if M.with_const == 1
        matrix bhat_avg = zeros(M.k+1, yvals)
        matrix bvar_avg = zeros(M.k+1, yvals)
        with_const = 1
    else
        matrix bhat_avg = zeros(M.k, yvals)
        matrix bvar_avg = zeros(M.k, yvals)
    endif
    matrix mod_sizes = zeros(M.k)
    matrix var_prob = zeros(1, M.k)
    # Marginal effects are defined for binary/ordered logit and probit.
    # The candidate regressors are kept in their original order.
    scalar do_mfx = M.limited_y && !M.multinomial && (M.estimator == "logit" || M.estimator == "probit")
    if do_mfx
        scalar mfx_ncat = M.ordered ? nelem(M.yvalues) : 2
        scalar mfx_ncuts = mfx_ncat - 1
        matrix mfx_sum = zeros(M.k, mfx_ncat)
        matrix mfx_binary = zeros(M.k, 1)
        # Read the candidate series in exactly the same order as estimation.
        # Automatic 0/1 detection is restricted to models without Y lags.
        # The latter require constructing the dynamic regressors separately.
        matrix mfx_X = {}
        if M.y_lag == 0
            list mfx_Xlist = selifc(M.var_numbers2[1,], ones(1, M.k))
            mfx_X = {mfx_Xlist}
        endif
        # Discrete changes require the same observations as the probabilities.
        if cols(mfx_X) == M.k && rows(mfx_X) == $nobs
            loop j=1..M.k
                matrix xcol = mfx_X[,j]
                # Require both 0 and 1 and no other value (including NA).
                if sum(xcol .= 0) > 0 && sum(xcol .= 1) > 0 && sum((xcol .= 0) + (xcol .= 1)) == rows(xcol)
                    mfx_binary[j] = 1
                endif
            endloop
        else
            mfx_X = {}
        endif
    endif
    if M.estimator == "logit" && !M.multinomial
        # ORs are meaningful for binary logit and proportional-odds ordered logit.
        # Ordered probit is excluded: exp(beta) is not an odds ratio in probit.
        # Accumulate the excess over OR=1 for included regressors.
        # Model weights and within-model standard errors are both accounted for.
        matrix or_extra_mean = zeros(M.k)
        matrix or_extra_second = zeros(M.k)
    endif
    if M.do_joint
        matrix jointness_m = zeros(M.k, M.k)
    endif
    if M.Npredict
        if M.limited_y && M.ordered
            Yhat_avg = zeros(M.Npredict, nelem(M.yvalues))
        elif M.limited_y && M.multinomial
            Yhat_avg = zeros(M.Npredict, nelem(M.yvals))
        else
            Yhat_avg = zeros(M.Npredict)
        endif
        Yhat_var_avg = zeros(M.Npredict)
    endif
    if M.limited_y && M.multinomial
        Yhat = zeros($nobs, yvals+1)
    elif M.limited_y && M.ordered
        Yhat = zeros($nobs, nelem(M.yvalues))
        matrix cutshat_avg = zeros(M.cuts)
        matrix cutsvar_avg = zeros(M.cuts)
    else
        Yhat = zeros($nobs)
    endif

    # We set the number of visited models
    M.post_n_models = nelem(known_models)
    if M.with_const == 0 && !(M.limited_y && M.ordered)
        M.post_n_models = xmin(M.post_n_models, 2^M.k-1)
    endif
    known_models = defbundle()

    # We select objects for accepted models only
    idx = selifr(seq(1, M.Nrep+1)', models_counter .> 0)
    M.post_n_models_accepted = nelem(idx)
    models_counter = models_counter[idx]
    models_estimates = models_estimates[idx]
    models_structure = models_structure[idx]
    if M.Npredict
        models_forecasts = models_forecasts[idx]
    endif
    models_yhat = models_yhat[idx]
    if M.limited_y && M.ordered
        cuts_estimates = array(nelem(models_counter))
        loop i=1..nelem(models_counter)
            cuts_estimates[i] = models_estimates[i][end-M.cuts+1:end,]
            if rows(models_estimates[i]) > M.cuts
                models_estimates[i] = models_estimates[i][1:end-M.cuts,]
            else
                models_estimates[i] = {}
            endif
        endloop
    endif

    # Models size cumulative distribution
    models_probs = mreverse(msortby(models_counter ~ idx ~ seq(1, M.post_n_models_accepted)', 1))
    M.models_probs_cum = cum(dsort(models_probs[,1]))

    # We build analytical and numerical rankings
    M.Nrank = xmin(M.Nrank, M.post_n_models_accepted)
    models_probs = models_probs[1:M.Nrank,]
    M.mod_nume_prob = models_probs[,1]
    M.mod_rank_prob = models_lprob[models_probs[,2]]
    models_structure_rank = models_structure[models_probs[,3]]
    models_estimates_rank = models_estimates[models_probs[,3]]
    if M.limited_y && M.ordered
        cuts_estimates_rank = cuts_estimates[models_probs[,3]]
    endif

    # We restore estimates for models in ranking
    loop i=1..M.Nrank
        var_idx = {}
        mod_struct = models_structure_rank[i]
        M.mod_rank[i] = mod_struct
        if M.with_const == 1
            var_idx = { 1 } ~ selifc(M.var_numbers2[2,], mod_struct)
        else
            if sum(mod_struct) != 0
                var_idx = selifc(M.var_numbers2[2,], mod_struct) - 1
            endif
        endif
        if nelem(models_estimates_rank[i])
            if M.model_type == "mlogit"
                var_idx = transp(mshape(var_idx', yvals*nelem(var_idx), 1))
            endif
            M.mod_rank_estimates[i] = models_estimates_rank[i][,1] ~ sqrt(models_estimates_rank[i][,2]) ~ transp(var_idx)
            if M.model_prior == 3
                M.mod_rank_bic[i] = -2 * (M.mod_rank_prob[i] - sum(mod_struct ? log(M.psi) : log(1-M.psi)))
            else
                M.mod_rank_bic[i] = -2 * (M.mod_rank_prob[i] - M.model_prior_log[sum(mod_struct)+1])
            endif
            if M.limited_y && M.ordered
                M.mod_rank_cuts_estimates[i] = cuts_estimates_rank[i][,1] ~ sqrt(cuts_estimates_rank[i][,2])
            endif
        endif
    endloop

    # We average over all accepted models
    if M.show_progress
        BACE_print_status("averaging", 0, 11, 1)
        scalar M.progress = ceil(nelem(models_counter)/100)
        percentage = M.progress
        flush
    endif
    loop i=1..nelem(models_counter)
        weight = models_counter[i]
        mod_struct = models_structure[i]
        mod_struct_sum = sum(mod_struct)

        # We set up vector with variables IDs
        if M.with_const == 1
            var_idx = { 1 } ~ selifc(M.var_numbers2[2,], mod_struct)
        else
            if mod_struct_sum
                var_idx = selifc(M.var_numbers2[2,], mod_struct) - 1
            else
                var_idx = {}
            endif
        endif

        if nelem(models_estimates[i])
            bhat = {}
            bhat = models_estimates[i][,1]
            if M.model_type == "mlogit"
                nr = with_const + mod_struct_sum
                bhat = mshape(bhat, nr, yvals)
                bvar = mshape(models_estimates[i][,2], nr, yvals)
                loop j=1..yvals
                    bhat_avg[var_idx, j] += weight * bhat[,j]
                    bvar_avg[var_idx, j] += weight * (bvar[,j] + bhat[,j] .^ 2)
                endloop
            else
                bhat_avg[var_idx] += weight * bhat
                bvar_avg[var_idx] += weight * (models_estimates[i][,2] + bhat .^ 2)
                if M.limited_y && M.ordered
                    bhat = cuts_estimates[i][,1]
                    cutshat_avg += weight * bhat
                    cutsvar_avg += weight * (cuts_estimates[i][,2] + bhat .^ 2)
                endif
            endif

            if M.estimator == "logit" && !M.multinomial && mod_struct_sum
                # In ordered logit, the cut-point estimates have already been removed
                # from models_estimates[i] before this loop.
                # Under the normal approximation for beta, exp(beta) is lognormal.
                # Excluded variables have OR=1, so only deviations from 1 are summed.
                matrix or_idx = selifc(seq(1, M.k), mod_struct)
                matrix or_beta = models_estimates[i][,1]
                matrix or_var = models_estimates[i][,2]
                if M.with_const == 1
                    # The always-included constant is the first coefficient.
                    or_beta = or_beta[2:]
                    or_var = or_var[2:]
                elif M.with_const == 2 && rows(or_beta) == mod_struct_sum + 1
                    # An automatically estimated constant can be placed last.
                    or_beta = or_beta[1:mod_struct_sum]
                    or_var = or_var[1:mod_struct_sum]
                endif
                if nelem(or_beta) != mod_struct_sum
                    funcerr "BACE: inconsistent coefficients in odds-ratio averaging"
                endif
                or_extra_mean[or_idx] += weight * (exp(or_beta + 0.5*or_var) - 1)
                or_extra_second[or_idx] += weight * (exp(2*or_beta + 2*or_var) - 1)
            endif

            if do_mfx && mod_struct_sum
                # Model-specific AMEs are weighted by the post-burn-in visits.
                # Coefficients for the ordered models exclude their cut points.
                matrix mfx_idx = selifc(seq(1, M.k), mod_struct)
                matrix mfx_beta = models_estimates[i][,1]
                if M.with_const == 1
                    mfx_beta = mfx_beta[2:]
                elif M.with_const == 2 && rows(mfx_beta) == mod_struct_sum + 1
                    mfx_beta = mfx_beta[1:mod_struct_sum]
                endif
                if nelem(mfx_beta) != mod_struct_sum
                    funcerr "BACE: inconsistent coefficients in marginal-effects averaging"
                endif

                matrix mfx_prob = models_yhat[i]
                if M.ordered && cols(mfx_prob) != mfx_ncat
                    funcerr "BACE: inconsistent ordered response probabilities for marginal effects"
                endif
                if !M.ordered && cols(mfx_prob) != 1
                    funcerr "BACE: inconsistent binary response probabilities for marginal effects"
                endif
                scalar mfx_nobs = rows(mfx_prob)
                # Profile of derivatives with respect to the linear index.
                # For ordered models, dPr(Y=c)/dx = beta*(f(c-1)-f(c)).
                matrix mfx_profile = zeros(1, mfx_ncat)
                matrix mfx_cdf = zeros(mfx_nobs, 1)
                if M.ordered
                    loop c=1..mfx_ncuts
                        mfx_cdf += mfx_prob[,c]
                        if M.estimator == "logit"
                            scalar mfx_density = sum(mfx_cdf .* (1 - mfx_cdf)) / mfx_nobs
                        else
                            # Pull extreme CDF values just inside (0,1) for qnorm.
                            matrix mfx_safe = 1.0e-12 + (1 - 2.0e-12)*mfx_cdf
                            scalar mfx_density = sum(dnorm(qnorm(mfx_safe))) / mfx_nobs
                        endif
                        mfx_profile[c] -= mfx_density
                        mfx_profile[c+1] += mfx_density
                    endloop
                else
                    mfx_cdf = mfx_prob[,1]
                    if M.estimator == "logit"
                        scalar mfx_density = sum(mfx_cdf .* (1 - mfx_cdf)) / mfx_nobs
                    else
                        matrix mfx_safe = 1.0e-12 + (1 - 2.0e-12)*mfx_cdf
                        scalar mfx_density = sum(dnorm(qnorm(mfx_safe))) / mfx_nobs
                    endif
                    mfx_profile[1] = -mfx_density
                    mfx_profile[2] = mfx_density
                endif

                loop j=1..mod_struct_sum
                    scalar ix = mfx_idx[j]
                    scalar beta = mfx_beta[j]
                    matrix mfx_contrib = beta * mfx_profile
                    if mfx_binary[ix] && nelem(mfx_X)
                        # For a 0/1 regressor, compare x=1 with x=0 for every
                        # observation and average the probability differences.
                        if rows(mfx_X) != mfx_nobs
                            funcerr "BACE: nonconformable observations for discrete marginal effects"
                        endif
                        matrix mfx_x = mfx_X[,ix]
                        mfx_contrib = zeros(1, mfx_ncat)
                        matrix mfx_cdf = zeros(mfx_nobs, 1)
                        if M.ordered
                            loop c=1..mfx_ncuts
                                mfx_cdf += mfx_prob[,c]
                                matrix mfx_safe = 1.0e-12 + (1 - 2.0e-12)*mfx_cdf
                                if M.estimator == "logit"
                                    matrix z = log(mfx_safe ./ (1 - mfx_safe))
                                    matrix p1 = logistic(z - beta*(1 - mfx_x))
                                    matrix p0 = logistic(z + beta*mfx_x)
                                else
                                    matrix z = qnorm(mfx_safe)
                                    matrix p1 = cnorm(z - beta*(1 - mfx_x))
                                    matrix p0 = cnorm(z + beta*mfx_x)
                                endif
                                scalar delta = sum(p1 - p0) / mfx_nobs
                                mfx_contrib[c] += delta
                                mfx_contrib[c+1] -= delta
                            endloop
                        else
                            matrix mfx_safe = 1.0e-12 + (1 - 2.0e-12)*mfx_prob[,1]
                            if M.estimator == "logit"
                                matrix z = log(mfx_safe ./ (1 - mfx_safe))
                                matrix p1 = logistic(z + beta*(1 - mfx_x))
                                matrix p0 = logistic(z - beta*mfx_x)
                            else
                                matrix z = qnorm(mfx_safe)
                                matrix p1 = cnorm(z + beta*(1 - mfx_x))
                                matrix p0 = cnorm(z - beta*mfx_x)
                            endif
                            scalar delta = sum(p1 - p0) / mfx_nobs
                            mfx_contrib[1] = -delta
                            mfx_contrib[2] = delta
                        endif
                    endif
                    mfx_sum[ix,] += weight * mfx_contrib
                endloop
            endif

            if mod_struct_sum
                mod_sizes[mod_struct_sum] += weight
            else
                M.empty_model_count = weight
            endif
            var_prob += weight * mod_struct
        endif

        # Yhat
        if M.y_lag
            yhat_shift = rows(Yhat) - rows(models_yhat[i])
            Yhat[1+yhat_shift:end] += weight * models_yhat[i]
        else
            Yhat += weight * models_yhat[i]
        endif

        if M.do_joint
            jointness_m = upper(jointness_m .+ weight * ((mod_struct .* mod_struct') .> 0))
        endif

        if M.Npredict
            if nelem(models_forecasts[i]) > 0
                if M.limited_y && (M.ordered || M.multinomial)
                    Yhat_avg += weight * models_forecasts[i][,1:end-1]
                else
                    Yhat_avg += weight * models_forecasts[i][,1]
                endif
                Yhat_var_avg += weight * models_forecasts[i][,end]
            endif
        endif

        # Flushing output - showing progress
        if M.show_progress && i == percentage
            BACE_show_progress(i, &percentage, M.progress, nelem(models_counter))
        endif
    endloop

    #############################################
    # We save collected results in the bundle M #
    #############################################

    # Coefficients and variances
    if M.with_const == 1
        M.bhat_avg = bhat_avg[2:,]
        M.bvar_avg = bvar_avg[2:,]
        M.consthat_avg = bhat_avg[1,]
        M.constvar_avg = bvar_avg[1,]
    else
        M.bhat_avg = bhat_avg
        M.bvar_avg = bvar_avg
    endif
    if M.limited_y && M.ordered
        M.cutshat_avg = cutshat_avg
        M.cutsvar_avg = cutsvar_avg
    endif

    # Probability of variables
    M.var_prob = var_prob
    if M.estimator == "logit" && !M.multinomial
        # Store unnormalised OR moments for BACE_summary().
        M.or_extra_mean = or_extra_mean
        M.or_extra_second = or_extra_second
    endif

    # Marginal effects are normalised and labelled in BACE_summary().
    if do_mfx
        M.mfx_sum = mfx_sum
        M.mfx_binary = mfx_binary
    endif

    # Jointness analysis
    if M.do_joint
        M.jointness_m = jointness_m
    endif

    # Forecasts
    if M.Npredict
        M.Yhat_avg = Yhat_avg
        M.Yhat_var_avg = Yhat_var_avg
    endif

    # Models size distribution
    M.mod_sizes = seq(1, M.k)' ~ mod_sizes
    if M.with_const == 1 || M.limited_y && M.ordered
        M.mod_sizes = {0} ~ M.empty_model_count | M.mod_sizes
    endif

    # Fitted values
    if M.y_lag
        M.Yhat = Yhat[M.y_lag+1:end]
    else
        M.Yhat = Yhat
    endif

    if M.show_progress
        printf "\n"
        BACE_print_status(null, 1, 22)
    else
        BACE_print_status(null, 1, 3)
    endif
end function

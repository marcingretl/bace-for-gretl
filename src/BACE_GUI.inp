function bundle BACE_GUI (series Y "Dependent variable",
                          int Y_AR_p[0::0] "Y lags",
                          list X_list[null] "List of independent variables (X)",
      int with_const[0:2:1] "Constant in model" {"Never", "Always", "Can be dropped"},
      int data_trans[0:2:0] "Data transformation" {"None", "Center", "Standarize"},
      int model_prior[1:2:1] "Model prior" {"Binomial", "Beta-Binomial"},
      int bic_type[1:3:1] "Bayesian information" {"BIC", "HBIC", "IBIC"},
      scalar avg_model_size[0::1] "Prior average model size",
      scalar alpha[0:1:0.6] "Significance level for the initial model",
      int Nrank[2::4] "Number of the top ranked models",
      int do_joint[0:7:0] "Jointness analysis" {"None", "Doppelhofer-Weeks Measure (DW1)", "Doppelhofer-Weeks Measure (DW2)", \
      "Ley-Steel Measure (LS1)", "Ley-Steel Measure (LS2)", "Strachan Measure (SM)", "Yule's Q Measure (YQ)", "Modified Yule's Q Measure (MYQ)"},
      int Npredict[0::0] "Number of out-of-sample forecasts",
      int Nrep[1e+06] "Total number of replications",
      int burn[0:99:10] "Percentage of burn-in draws",
      int verbosity[1:2:1] "Verbosity",
      bool show_progress[1] "Show overall progress",
      bool do_plot[1] "Plot graphs?")
    /*
       GUI-based function to carry out BACE analysis.
       Function is a wrapper to bundle-based BACE() interface.
    */
    # Basic parsing and checking
    bundle Options
    string Y_name = argname(Y)
    series @Y_name = Y
    scalar Options["Y_AR_p"] = 0
    scalar Options["with_const"] = with_const
    scalar Options["model_prior"] = model_prior
    scalar Options["avg_model_size"] = avg_model_size
    scalar Options["alpha"] = alpha
    scalar Options["Nrank"] = Nrank
    scalar Options["do_joint"] = do_joint
    scalar Options["Npredict"] = Npredict
    scalar Options["Nrep"] = Nrep
    scalar Options["burn"] = burn
    scalar Options["verbosity"] = verbosity
    scalar Options["show_progress"] = show_progress
    scalar Options["do_plot"] = do_plot    
    scalar Options["data_trans"] = data_trans
    scalar Options["bic_type"] = bic_type

    return BACE(@Y_name, X_list, Options)
end function

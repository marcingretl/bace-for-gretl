   but WITHOUT ANY WARRANTY; without even the implied warranty of
   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
   GNU General Public License for more details.

   You should have received a copy of the GNU General Public License
   along with this program. If not, see <http://www.gnu.org/licenses/>.
*/
function string BACE_bcheck (bundle UserOpts, bundle *M, scalar k)
/*
   This function checks options bundle and returns error message in
   any problem found.
   Parameters:

   UserOpts - bundle with user-defined options for BACE
   k - number of independent variables
    */
    string err = ""
    string separator = ", "
    scalar avg_model_size_tmp = 0
    scalar err2, arg_val, do_plot_tmp, do_show_progress, alpha_tmp
    bundle Options, Overloadable
    string arg_name, parameter_value
    strings Integers = defarray("Y_AR_p", "with_const", "model_prior", "Nrank",\
      "do_joint", "Npredict", "Nrep", "burn", "verbosity", "data_trans", "bic_type")
    strings Booleans = defarray("show_progress", "do_plot")
    strings Scalars = defarray("avg_model_size", "alpha", "binary_threshold")
    strings ModelTypes = defarray("linear", "logit", "probit", "poisson", "tobit", "intreg")
    strings BicTypes = defarray("BIC", "HBIC", "IBIC", "EBIC")
    strings ModelPriorTypes = defarray("none", "Binomial", "Beta-Binomial")
    strings ConstTypes = defarray("Never", "Always", "Can be dropped")
    strings DataTransTypes = defarray("none", "centering", "standarizing")
    strings OverloadableKeys
    if $sysinfo.gui_mode
        do_plot_tmp = 1
        do_show_progress = 1
    else
        do_plot_tmp = 0
        do_show_progress = 0
    endif
    Overloadable["bic_type"] = _(bic=1, hbic=2, ibic=3, ebic=4, valid=tolower(flatten(BicTypes, separator)))
    Overloadable["model_prior"] = _(none=0, binomial=1, betabinomial=2, valid=tolower(flatten(ModelPriorTypes, separator)))
    Overloadable["with_const"] = _(never=0, always=1, canbedropped=2, valid=tolower(flatten(ConstTypes, separator)))
    Overloadable["do_joint"] = _(none=0, dw1=1, dw2=2, ls1=3, ls2=4, sm=5, yq=6, myq=7, valid="none, DW1, DW2, LS1, LS2, SM, YQ, MYQ")
    Overloadable["data_trans"] = _(none=0, centering=1, standarizing=2, valid=tolower(flatten(DataTransTypes, separator)))
    Overloadable["model_type"] = _(linear=1, logit=2, probit=3, poisson=4, tobit=5, intreg=6, valid=tolower(flatten(ModelTypes, separator)))

    # We look for overloaded parameters and convert them into integers
    OverloadableKeys = getkeys(Overloadable)
    loop i=1..nelem(OverloadableKeys) --quiet
        arg_name = OverloadableKeys[i]
        if inbundle(UserOpts, arg_name)
            if typeof(UserOpts[arg_name]) == 4 && arg_name != "model_type"
                parameter_value = strsub(tolower(UserOpts[arg_name]), " ", "")
                if arg_name == "model_prior"
                    parameter_value = strsub(parameter_value, "-", "")
                endif
                if inbundle(Overloadable[arg_name], parameter_value)
                    UserOpts[arg_name] = Overloadable[arg_name][parameter_value]
                else
                    err = sprintf("Unknown '%s' value for parameter %s.\n", UserOpts[arg_name], arg_name)
                    err += sprintf(" Valid options are: %s", Overloadable[arg_name].valid)
                    return err
                endif
            elif typeof(UserOpts[arg_name]) == 1 && arg_name == "model_type"
                if UserOpts[arg_name] <= nelem(ModelTypes)
                    UserOpts[arg_name] = ModelTypes[UserOpts[arg_name]]
                else
                    err = sprintf("Model type value (model_type=%d) is out of bounds (must be <= %d)", UserOpts[arg_name], nelem(ModelTypes))
                    return err
                endif
            endif
        endif
    endloop

    # We set the default Nrep conditional on k
    if k <= 15
        Nrep = 10000
    elif k <= 19
        Nrep = 100000
    else
        Nrep = 1e+06
    endif

    # We set temporal Y_AR_p value
    if !inbundle(UserOpts, "Y_AR_p") || typeof(UserOpts["Y_AR_p"]) != 1
        Y_AR_p_tmp = 0
    else
        Y_AR_p_tmp = UserOpts["Y_AR_p"]
    endif

    # We set temporal with_const value and calculate prior average model size
    if !inbundle(UserOpts, "with_const")
        with_const_tmp = 1
        avg_model_size_tmp = (k + Y_AR_p_tmp) / 2
    else
        with_const_tmp = UserOpts["with_const"]
        avg_model_size_tmp = (k + Y_AR_p_tmp + (with_const_tmp == 2)) / 2
    endif
    
    # We set default alpha
    if inbundle(UserOpts, "model_type") && UserOpts["model_type"] == "intreg"
        alpha_tmp = 1.0
    else
        alpha_tmp = 0.6
    endif    

    # Template bundle with default values
    scalar Options["Y_AR_p"] = 0
    scalar Options["with_const"] = 1
    scalar Options["model_prior"] = 2
    scalar Options["avg_model_size"] = avg_model_size_tmp
    scalar Options["alpha"] = alpha_tmp
    scalar Options["Nrank"] = xmin(2^(k+Y_AR_p_tmp-1), 40)
    scalar Options["do_joint"] = 0
    scalar Options["Npredict"] = 0
    scalar Options["Nrep"] = Nrep
    scalar Options["burn"] = 10
    scalar Options["verbosity"] = 2
    scalar Options["show_progress"] = do_show_progress
    scalar Options["do_plot"] = do_plot_tmp
    string Options["model_type"] = "linear"
    scalar Options["data_trans"] = 0
    scalar Options["bic_type"] = 1
    scalar Options["hyperparameter"] = 0.5 # gamma for EBIC
    scalar Options["binary_threshold"] = 0.5
    scalar Options["low"] = 0
    scalar Options["high"] = NA
    scalar Options["_gui"] = 0

    # General checking, but still needs some manual work later
    err2 = bcheck(&Options, UserOpts)
    if err2
        err = sprintf("Valid options are:\n")
        loop i=1..nelem(getkeys(Options)) --quiet
            err += sprintf("\t%s\n", getkeys(Options)[i])
        endloop
        err += sprintf(" Look at the PDF documentation for expected types of arguments.")
    endif

    # We check integers
    loop i=1..nelem(Integers) --quiet
        arg_name = Integers[i]
        arg_val = Options[arg_name]
        if arg_val != int(arg_val)
            err += sprintf("Argument %s must be an integer", arg_name)
        endif
    endloop

    # We check booleans
    loop i=1..nelem(Booleans) --quiet
        arg_name = Booleans[i]
        arg_val = Options[arg_name]
        if arg_val != int(arg_val) || arg_val < 0 || arg_val > 1
            err += sprintf("Argument %s must be a bool", arg_name)
        endif
    endloop

    # We check model type
    if inbundle(UserOpts, "model_type") && strlen(UserOpts["model_type"]) && !nelem(instrings(ModelTypes, UserOpts["model_type"]))
        err += sprintf("Unknown model type: '%s'", UserOpts["model_type"])
    endif

    # We check arguments for valid values
    if Options.Y_AR_p < 0
        err += "Y lags (Y_AR_p) takes the integer values"
    elif Options.with_const < 0 || Options.with_const > 2
        err += "Constant in model takes the integer values in the range [0; 2]"
    elif Options.model_prior < 0 || Options.model_prior > 2
        err += "Model prior takes the integer values in the range [0; 2]"
    elif Options.alpha < 0 || Options.alpha > 1
        err += "The significance level (alpha) takes the real values in the range [0; 1]"
    elif Options.do_joint < 0 || Options.do_joint > 7
        err += "Jointess type (do_joint) takes the integer values in the range [1; 7]"
    elif Options.Npredict < 0
        err += "Number of out-of-sample forecasts (Npredict) takes the integer values"
    elif Options.Npredict >= round($nobs/2)
        printf("Number of out-of-sample forecasts is more than 50%s of sample length.\n", "%")
    elif Options.Nrep < 0
        err += "Total number of replications (Nrep) takes the integer values"
    elif Options.burn < 0 || Options.burn > 99
        err += "Percentage of burn-in draws (do_burn) takes the integer values in the range [0; 99]"
    elif Options.verbosity < 1 || Options.verbosity > 2
        err += "Verbosity takes the integer values in the range [1; 2]"
    elif Options.data_trans < 0 || Options.data_trans > 2
        err += "Parameter data_trans takes the integer values in the range [0; 2]"
    elif Options.bic_type < 1 || Options.bic_type > 4
        err += "BIC type takes the integer values in the range [1; 4]"
    elif Options.hyperparameter < 0 || Options.hyperparameter > 1
        err += "Hyperparameter for EBIC (gamma) takes the real values in the range [0; 1]"
    elif Options.binary_threshold <= 0 || Options.binary_threshold >= 1
        err += "Threshold for binary dependent models (binary_threshold) takes the real values in the range (0; 1)"
    endif

    # We save options in M
    M = Options
    M.ModelTypes = ModelTypes
    M.BicTypes = BicTypes
    M.ModelPriorTypes = ModelPriorTypes
    M.ConstTypes = ConstTypes
    M.DataTransTypes = DataTransTypes
    strings M.DiscreteModelTypes = M.ModelTypes[2:3] # Note: the first two for binary dependent variable only!
    strings M.CensoredModelTypes = M.ModelTypes[5:6]
    scalar M.limited_y = nelem(instrings(M.DiscreteModelTypes, M.model_type)) > 0 ? 1 : 0
    scalar M.censored_y = nelem(instrings(M.CensoredModelTypes, M.model_type)) > 0 ? 1 : 0
    
    return err
end function

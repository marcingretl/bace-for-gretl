function void BACE_Print (bundle *MODEL)
/*
   Function prints BACE results.
    */
    scalar avg_model_size
    matrix coeffmat
    string model_type, tmpstr, tmpstr2

    # We make a copy of MODEL
    bundle M = MODEL
    
    # We set up estimator command
    string ESTIMATOR = M.estimator

    # We re-create Y process
    string Y_name = M.Y_name
    series @Y_name = M.Y
    if ESTIMATOR == "intreg"
        string Y_name2 = M.Y_name2
        series @Y_name2 = M.Y2
    endif    

    # Do we have Y lags?
    if M.Y_AR_p > 0
        lags M.Y_AR_p ; @Y_name
    endif

    # We have to set sample
    if M.Npredict > 0
        smpl M.first_obs M.last_obs
    endif

    # We set up real prior avg_model_size
    if M.prior_name == "none"
        avg_model_size = NA
    else
        avg_model_size = sum(M.mod_sizes[,1] .* M.mod_sizes[,3])
    endif

    # Setting up string with model type
    if M.limited_y && M.ordered
        model_type = sprintf("ordered %s", M.model_type)
    else
        model_type = sprintf("%s", M.model_type)
    endif

    # Additional information in summary
    printf "\n"
    print "----------------------------------"
    if M.limited_y && M.ordered
        printf "Model type: %s\n", model_type
    else
        printf "Model type: %s\n", model_type
    endif
    if ESTIMATOR == "tobit"
        printf "   left bound: %f\n", M.low
        printf "   right bound: %f\n", M.high
    endif
    printf "Constant type: %s\n", M.const_type
    printf "Prior: %s\n", M.prior_name
    printf "Prior average model size: %f\n", M.avg_model_size
    printf "Significance level for the initial model: %f\n", M.alpha
    printf "Bayesian information criterion used: %s\n", M.bic_type_name
    if M.bic_type_name == "EBIC"
        printf "Hyperparameter for EBIC (gamma): %f\n", M.hyperparameter
    endif
    printf "Data transformation: %s\n", M.data_trans_name
    if M.limited_y && !M.ordered
        printf "Threshold for binary dependent variable: %f\n", M.binary_threshold
    endif
    printf "Total number of iterations: %d\n", M.Nrep + M.n_drop_draws
    if M.with_const != 1 && M.n_drop_draws
        printf "   Number of rejected draws: %d\n", M.n_drop_draws
        printf "   Effective number of iterations: %d\n", M.Nrep
    endif
    printf "Number of burn-in draws: %d\n", M.Nburn
    if M.model_space < 2^31
        printf "Total number of possible models: %d\n", M.model_space
    else
        printf "Total number of possible models: %g\n", M.model_space
    endif
    printf "Number of models visited: %d\n", M.post_n_models
    printf "Number of models accepted: %d\n", M.post_n_models_accepted
    if exists(M.Norig) == 1
        printf "Original number of observations (with missing): %d\n", M.Norig
    endif
    if M.verbosity == 2
        printf "\n"
        print "----------------------------------"
        if nelem(M.StartModel_b)
            if M.limited_y && M.ordered
                printf "The initial model: ordered %s, dependent variable: %s\n", ESTIMATOR, M.Y_name
            elif ESTIMATOR == "intreg"
                printf "The initial model: %s, Lower limit: %s, Upper limit: %s\n", ESTIMATOR, M.Y_name, M.Y_name2
            else
                printf "The initial model: %s, dependent variable: %s\n", ESTIMATOR, M.Y_name
            endif
            loop i=1..nelem(M.StartModel_xnames) --quiet
                if substr(M.StartModel_xnames[i], 1, 4) == "YyY_"
                    M.StartModel_xnames[i] = strsub(M.StartModel_xnames[i], "YyY", M.Y_name)
                endif
            endloop
            coeffmat = M.StartModel_b.coeff ~ M.StartModel_b.stderr
            strings coeffmat_xnames = M.StartModel_xnames
            if M.limited_y && M.ordered
                coeffmat_xnames += M.cuts_names
            endif
            modprint coeffmat coeffmat_xnames
        else
            printf("The initial model was empty.\n")
        endif
        if M.censored_y
            if ESTIMATOR == "tobit"
                tmpstr2 = "censored"
            elif ESTIMATOR == "intreg"
                tmpstr2 = "unbounded"
            endif
            tmpstr = sprintf("Left-%s observations: %d", tmpstr2, M.n_censored[1])
            if M.Y_censoring && !isnan(M.low)
                tmpstr = sprintf("%s (%s <= %f)", tmpstr, M.Y_name, M.low)
            endif
            printf "%s\n", tmpstr
            tmpstr = sprintf("Right-%s observations: %d", tmpstr2, M.n_censored[2])
            if M.Y_censoring && !isnan(M.high)
                tmpstr = sprintf("%s (%s >= %f)", tmpstr, M.Y_name, M.high)
            endif
            printf "%s\n", tmpstr
            if ESTIMATOR == "intreg"
                printf "Bounded observations: %d\n", M.n_censored[3]
                printf "Point observations: %d\n", M.n_censored[4]
            endif            
            if nelem(M.normality_test)
                printf "\nTest for normality of residual -\n"
                printf "  Null hypothesis: error is normally distributed\n"
                printf "  Test statistic: Chi-square(%d) = %f\n", M.normality_test["dfn"], M.normality_test["test"]
                printf "  with p-value = %f\n", M.normality_test["pvalue"]
            endif            
        endif
    endif

    # Standard information (PIPs, Means and so on)
    print "----------------------------------"
    printf "\n"
    printf "Prior:\n"
    printf "\taverage model size: %f\n", avg_model_size
    printf "\tstandard deviation: %f\n", M.mod_size_sd_prior
    if M.prior_based_bic
        printf "Effective Prior:\n"
        printf "\taverage model size: %f\n", M.avg_model_size_bic
        printf "\tstandard deviation: %f\n", M.mod_size_sd_prior_bic
    endif
    printf "Posterior:\n"
    printf "\taverage model size: %f\n", M.mod_size_av
    printf "\tstandard deviation: %f\n", M.mod_size_sd
    printf "\n"
    print "----------------------------------"
    printf "\n"
    print "Posterior moments (unconditional and conditional on inclusion):"
    if $version < 20170
        printf "%15f", M.Post_Results
    else
        matrix Post_Results = M.Post_Results
        if M.with_const == 1
            Post_Results[1,1] += 1 # Trick to have const always in the first row after sorting by PIPs
            Post_Results = mreverse(msortby(Post_Results, 1))
            Post_Results[1,1] -= 1
        else
            Post_Results = mreverse(msortby(Post_Results, 1))
        endif
        printf "%15f", Post_Results
        if M.limited_y && M.ordered
            printf "\n%15f", M.cuts_avg
        elif M.model_type == "zip"
            printf "\n%15f", M.alpha_avg
        endif
    endif
    printf "\n"
    print "----------------------------------"
    printf "\n"
    print "Posterior probability of models:"
    loop i=1..rows(M.models_probs_percents) --quiet
        if i <= 4
            printf "Best %d\t models account for %.4f of mass\n", M.models_probs_percents[i,1], M.models_probs_percents[i,2]
        elif i == rows(M.models_probs_percents)
            printf "Best %d models account for %.4f of mass\n", M.models_probs_percents[i,1], M.models_probs_percents[i,2]
        else
            printf "Best %d models account for %.4f of mass\n", M.models_probs_percents[i,1], M.models_probs_percents[i,2]
        endif
    endloop
    printf "\nBest models ranking:\n"
    loop i=1..M.Nrank --quiet
        printf "Model %d:\t%f\n", i, M.Numerical_Likelihood[i]
    endloop
    printf "Total probability of the models in ranking (numerical): %f\n\n", sumc(M.Numerical_Likelihood)
    printf "Correlation coefficient between the analytical\n"
    printf "and numerical probabilities of the above models: %f\n", corr(M.Numerical_Likelihood, M.mod_rank_prob)

    # Contingency table
    if M.limited_y
        printf "\n"
        print "----------------------------------"
        printf "\n"
        print "Contingency table (actual in rows, predicted in columns):"
        eval M.contingency
        printf "Number of cases 'correctly predicted' = %d (accuracy %.1f%%)\n", M.correctly_predicted, 100*M.correctly_predicted/sum(M.contingency)
    endif

    # Forecasts
    if M.Npredict
        printf "\n"
        print "----------------------------------"
        printf "\n"
        print "Predictive results:"
        printf "%15f", M.prediction
        printf "\n"
    endif

    # Jointess analysis
    if M.do_joint
        matrix jointess_measure = BACE_jointness_measure(&M)
        string jointess_measure_name = M.jointess_measure_names[M.do_joint]
        print "----------------------------------"
        printf "\n"
        print "Posterior joint probability of variables:"
        printf "%15f", M.jointness_m
        printf "\nJointness statistics (%s):\n", jointess_measure_name
        printf "%15f", jointess_measure
        scalar strong_sub = 0
        scalar significant_sub = 0
        scalar strong_com = 0
        scalar significant_com = 0
        matrix pairs = zeros(round(0.5*M.k^2), 3)
        scalar pair = 0
        loop i=1..M.k --quiet
            loop j=i+1..M.k --quiet
                if !isnan(jointess_measure[i,j]) && abs(jointess_measure[i,j]) > 1
                    pair += 1
                    pairs[pair,1] = jointess_measure[i,j]
                    pairs[pair,2] = i
                    pairs[pair,3] = j
                    if (jointess_measure[i,j] < 0)
                        if (jointess_measure[i,j] < -2)
                            strong_sub += 1
                        else
                            significant_sub += 1
                        endif
                    else
                        if jointess_measure[i,j] > 2
                            strong_com += 1
                        else
                            significant_com += 1
                        endif
                    endif
                endif
            endloop
        endloop
        if pair > 0
            pairs = msortby(pairs[1:pair, ], 1)
            scalar shift = 0
            if strong_sub > 0
                BACE_jointness_pairs("Strong substitutes:", &strong_sub, M.var_numbers, &shift, &pairs, M.jointness_m)
            endif
            if significant_sub > 0
                BACE_jointness_pairs("Significant substitutes:", &significant_sub, M.var_numbers, &shift, &pairs, M.jointness_m)
            endif
            if significant_com > 0
                BACE_jointness_pairs("Significant complements:", &significant_com, M.var_numbers, &shift, &pairs, M.jointness_m)
            endif
            if strong_com > 0
                BACE_jointness_pairs("Strong complements:", &strong_com, M.var_numbers, &shift, &pairs, M.jointness_m)
            endif
        endif
    endif

    # Printing models in ranking
    if M.verbosity == 2
        strings Xnames # names of X-es
        printf "\n\nBest specifications (MLE estimates for %s model):", model_type
        loop i=1..M.Nrank --quiet
            if M.mod_nume_prob[i]
                printf "\n"
                print "----------------------------------"
                printf "\nModel %d: %s: %.6f, posterior probability: %f", i, M.bic_type_name, M.mod_rank_bic[i], M.Numerical_Likelihood[i]
                if sumr(M.mod_rank[i]) == 0 && M.with_const != 1
                    printf "\n\n  %s\n", "None of the variables were significant."
                    printf "  %s\n", "Model includes only the intercept term which is simply the average of the dependent variable."
                else
                    coeffmat = M.mod_rank_estimates[i][,1:2]
                    Xnames = M.all_names_sp_m[M.mod_rank_estimates[i][,3]]
                    if M.limited_y && M.ordered
                        coeffmat = coeffmat | M.mod_rank_cuts_estimates[i]
                        Xnames += M.cuts_names
                    elif M.model_type == "zip"
                        coeffmat = coeffmat | M.mod_rank_alpha_estimates[i]
                        Xnames += defarray("alpha")
                    endif
                    modprint coeffmat Xnames
                endif
            endif
        endloop
    endif
    print "----------------------------------"
    printf "\n\n"
end function

set verbose off
set seed 1000000

# We load packages
include BACE.gfn

# We load tobit dataset [https://stats.oarc.ucla.edu/r/dae/tobit-models/]
open tobit.gdt --quiet

# We specify list of explanatory variables
list X = read math proggeneral progvocational

#########################################################################
#	BACE 																#
#########################################################################
set stopwatch
BACE(apt, X, _(model_type="tobit", high=800))
printf "Total execution time: %.2f sec.\n", $stopwatch

function bundle BACE (series Y "Dependent variable",
                      list X_list "List of indenpendent variables (X)",
                      bundle Options[null])
    /*
       Bundle-based to carry out BMA analysis.
       Function returns bundle MODEL with (formatted) results.
    */
    bundle MODEL
    string Y_name = argname(Y)
    series @Y_name = Y
    string err

    if !exists(Options)
        bundle Options
    endif

    # Bundle check and setting default values (if needed)
    err = BACE_bcheck(Options, &MODEL, nelem(X_list))
    if strlen(err) != 0
        funcerr "@err !!!"
        return MODEL
    endif
    
    # Data transformation (if needed)
    if MODEL.data_trans == 1
        X_list = stdize(X_list, -1)
    elif MODEL.data_trans == 2
        X_list = stdize(X_list, 0)
    endif
    
    # Handling missing values
    Norig = $nobs
    if $datatype == 2
        smpl Y X_list --no-all-missing
    else
        smpl Y X_list --no-missing
    endif    
    if Norig != $nobs
        printf "\nThere are missing values in dataset!\n"
    else
        Norig = NA
    endif

    # Basic parsing and checking
    err = BACE_parse(&MODEL, Y, Y_name, X_list)
    if strlen(err) != 0
        if MODEL["_gui"]
            MODEL["err"] = err
        else
            funcerr "@err !!!"
        endif
    else
        BACE_setup(&MODEL, Norig)
        # Setting sample for forecasting
        if MODEL.Npredict
            smpl 1 MODEL.last_obs
        endif
        BACE_main(&MODEL)
        BACE_summary(&MODEL)
        BACE_Print(&MODEL)
        if MODEL.do_plot
            BACE_Plot(&MODEL)
        endif        
    endif

    set warnings on
    return MODEL
end function

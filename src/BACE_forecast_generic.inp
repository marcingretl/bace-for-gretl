function void BACE_forecast_generic (matrix *Yhat_predict,
                                     matrix *Yhat_predict_var,
                                     scalar h_predict,
                                     matrix bhat,
                                     matrix XtXinv,
                                     scalar *sigma2,
                                     scalar Y_AR_p,
                                     matrix *Y_AR_cols,
                                     scalar *n_AR,
                                     matrix X_new_predict,
                                     bool random[0],
                                     scalar with_const)
    /*
       This is a generic function which computes forecasts (static or dynamic)
       *Yhat_predict		- pointer to the vector with forecasts
       *Yhat_predict_var	- pointer to the vector with forecasts variances
       h_predict			- forecasts horizon
       bhat				- vector with coefficients
       XtXinv				- inverse of covariance matrix
       *sigma2				- pointer to the scalar with sigma-square value
       Y_AR_p				- order of autoregression (AR(p))
       *Y_AR_cols			- pointer to the vector indicating cols with AR(p) coefficients
       *n_AR				- number of Y laggs
       X_new_predict		- matrix with values of X-es (out-of-sample)
    */
    scalar Yhat_predict_current
    matrix X_new_predict_row
    matrix XT
    # Mean and Variance
    # Static forecasts
    if (n_AR == 0)
        if (with_const == 1)
            XT = ones(h_predict, 1) ~ X_new_predict
        else
            XT = X_new_predict
        endif
        Yhat_predict_expected = XT * bhat
        Yhat_predict = Yhat_predict_expected
        BACE_forecast_generic_variance(&XT, &XtXinv, &sigma2, &Yhat_predict_var)
    else
        # Dynamic forecasts if we do have lagged Y (always static for the first period)
        loop i=1..h_predict --quiet
            X_new_predict_row = X_new_predict[i,]
            if (i > 1)
                BACE_forecast_dynamic_matrix(&i, &Y_AR_cols, &Yhat_predict, &X_new_predict_row)
            endif
            if (with_const == 1)
                XT = {1} ~ X_new_predict_row
            else
                XT = X_new_predict_row
            endif
            Yhat_predict_expected = XT * bhat
            Yhat_predict[i] = Yhat_predict_expected
            Yhat_predict_var[i] = BACE_forecast_generic_variance(&XT, &XtXinv, &sigma2)
        endloop
    endif
end function

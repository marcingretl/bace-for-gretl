<?xml version="1.0" encoding="UTF-8"?>
<gretl-functions>
<gretl-function-package name="BACE" minver="2022c" lives-in-subdir="true">
<author email="marcin@gretlconference.org">Marcin Błażejowski, Jacek Kwiatkowski</author>
<version>1.3-svn</version>
<date>2023-02-08</date>
<description>This package provides BACE (Bayesian Averaging of Classical Estimates) procedure.</description>
<tags>C20 C52</tags>
<label>BACE</label>
<menu-attachment>MAINWIN/Model</menu-attachment>
<help>
pdfdoc:BACE.pdf
</help>
<depends count="1">
oprobit_predict </depends>
<gretl-function name="BACE" type="bundle">
 <params count="3">
  <param name="Y" type="list">
<description>Dependent variable(s)</description>
  </param>
  <param name="X_list" type="list">
<description>List of indenpendent variables (X)</description>
  </param>
  <param name="Options" type="bundle" optional="true"/>
 </params>
<code>/*
Bundle-based to carry out BMA analysis.
Function returns bundle MODEL with (formatted) results.
*/
bundle MODEL
string err
series Y1, Y2
scalar nY = nelem(Y)
scalar Norig = NA
if nY == 1
  string Y_name = varnames(Y)[1]
  series @Y_name = Y[1]
  series Y1 = Y[1]
elif nY == 2
  loop i=1..2 --quiet
    string Y_name = varnames(Y)[i]
    series @Y_name = Y[i]
    series Y$i = Y[i]
  endloop
else
  err = &quot;Too many Y variables (should be either 1 or 2)&quot;
endif
if !exists(Options)
  bundle Options
endif
# Bundle check and setting default values (if needed)
err = BACE_bcheck(Options, &amp;MODEL, nelem(X_list))
if strlen(err) != 0
  funcerr &quot;@err !!!&quot;
  return MODEL
endif
# Data transformation (if needed)
if MODEL[&quot;data_trans&quot;] == 1
  X_list = stdize(X_list, -1)
elif MODEL[&quot;data_trans&quot;] == 2
  X_list = stdize(X_list, 0)
endif
# Handling missing values
if MODEL[&quot;model_type&quot;] != &quot;intreg&quot;
  Norig = $nobs
  if $datatype == 2
    smpl Y X_list --no-all-missing
  else
    smpl Y X_list --no-missing
  endif
  if Norig != $nobs
    printf &quot;\nThere are missing values in dataset!\n&quot;
  else
    Norig = NA
  endif
endif
# Basic parsing and checking
err = BACE_parse(&amp;MODEL, Y1, varnames(Y), X_list, nY, Y2)
if strlen(err) != 0
  if MODEL[&quot;_gui&quot;]
    MODEL[&quot;err&quot;] = err
  else
    funcerr &quot;@err !!!&quot;
  endif
else
  BACE_setup(&amp;MODEL, Norig)
  # Setting up sample for forecasting
  if MODEL[&quot;Npredict&quot;]
    smpl 1 MODEL[&quot;last_obs&quot;]
  endif
  BACE_main(&amp;MODEL)
  BACE_summary(&amp;MODEL)
  BACE_Print(&amp;MODEL)
  if MODEL[&quot;do_plot&quot;]
    BACE_Plot(&amp;MODEL)
  endif
endif
set warnings on
return MODEL
</code>
</gretl-function>
<gretl-function name="BACE_Print" type="void" pkg-role="bundle-print">
 <params count="1">
  <param name="MODEL" type="bundleref"/>
 </params>
<code>/*
Function prints BACE results.
*/
scalar avg_model_size
matrix coeffmat
string model_type, tmpstr, tmpstr2
# We make a copy of MODEL
bundle M = MODEL
# We set up estimator command
string ESTIMATOR = M.estimator
# We re-create Y process
string Y_name = M.Y_name
series @Y_name = M.Y
if ESTIMATOR == &quot;intreg&quot;
  string Y_name2 = M.Y_name2
  series @Y_name2 = M.Y2
endif
# Do we have Y lags?
if M.y_lag &gt; 0
  lags M.y_lag ; @Y_name
endif
# We have to set sample
if M.Npredict &gt; 0
  smpl M.first_obs M.last_obs
endif
# We set up real prior avg_model_size
if M.prior_name == &quot;none&quot;
  avg_model_size = NA
else
  avg_model_size = sum(M.mod_sizes[,1] .* M.mod_sizes[,3])
endif
# Setting up string with model type
if M.limited_y &amp;&amp; M.ordered
  model_type = sprintf(&quot;ordered %s&quot;, M.model_type)
else
  model_type = sprintf(&quot;%s&quot;, M.model_type)
endif
# Additional information in summary
printf &quot;\n&quot;
print &quot;----------------------------------&quot;
if M.limited_y &amp;&amp; M.ordered
  printf &quot;Model type: %s\n&quot;, model_type
else
  printf &quot;Model type: %s\n&quot;, model_type
endif
if ESTIMATOR == &quot;tobit&quot;
  printf &quot;   left bound: %f\n&quot;, M.low
  printf &quot;   right bound: %f\n&quot;, M.high
endif
printf &quot;Constant type: %s\n&quot;, M.const_type
printf &quot;Prior: %s\n&quot;, M.prior_name
printf &quot;Prior average model size: %f\n&quot;, M.avg_model_size
printf &quot;Significance level for the initial model: %f\n&quot;, M.alpha
printf &quot;Bayesian information criterion used: %s\n&quot;, M.bic_type_name
if M.bic_type_name == &quot;EBIC&quot;
  printf &quot;Hyperparameter for EBIC (gamma): %f\n&quot;, M.hyperparameter
endif
printf &quot;Data transformation: %s\n&quot;, M.data_trans_name
if M.limited_y &amp;&amp; !M.ordered
  printf &quot;Threshold for binary dependent variable: %f\n&quot;, M.binary_threshold
endif
printf &quot;Total number of iterations: %d\n&quot;, M.Nrep + M.n_drop_draws
if M.with_const != 1 &amp;&amp; M.n_drop_draws
  printf &quot;   Number of rejected draws: %d\n&quot;, M.n_drop_draws
  printf &quot;   Effective number of iterations: %d\n&quot;, M.Nrep
endif
printf &quot;Number of burn-in draws: %d\n&quot;, M.Nburn
if M.model_space &lt; 2^31
  printf &quot;Total number of possible models: %d\n&quot;, M.model_space
else
  printf &quot;Total number of possible models: %g\n&quot;, M.model_space
endif
printf &quot;Number of models visited: %d\n&quot;, M.post_n_models
printf &quot;Number of models accepted: %d\n&quot;, M.post_n_models_accepted
if exists(M.Norig) == 1
  printf &quot;Original number of observations (with missing): %d\n&quot;, M.Norig
endif
if M.verbosity == 2
  printf &quot;\n&quot;
  print &quot;----------------------------------&quot;
  if nelem(M.StartModel_b)
    if M.limited_y &amp;&amp; M.ordered
      printf &quot;The initial model: ordered %s, dependent variable: %s\n&quot;, ESTIMATOR, M.Y_name
    elif ESTIMATOR == &quot;intreg&quot;
      printf &quot;The initial model: %s, Lower limit: %s, Upper limit: %s\n&quot;, ESTIMATOR, M.Y_name, M.Y_name2
    else
      printf &quot;The initial model: %s, dependent variable: %s\n&quot;, ESTIMATOR, M.Y_name
    endif
    loop i=1..nelem(M.StartModel_xnames) --quiet
      if substr(M.StartModel_xnames[i], 1, 4) == &quot;YyY_&quot;
        M.StartModel_xnames[i] = strsub(M.StartModel_xnames[i], &quot;YyY&quot;, M.Y_name)
      endif
    endloop
    coeffmat = M.StartModel_b.coeff ~ M.StartModel_b.stderr
    strings coeffmat_xnames = M.StartModel_xnames
    if M.limited_y &amp;&amp; M.ordered
      coeffmat_xnames += M.cuts_names
    endif
    modprint coeffmat coeffmat_xnames
  else
    printf(&quot;The initial model was empty.\n&quot;)
  endif
  if M.censored_y
    if ESTIMATOR == &quot;tobit&quot;
      tmpstr2 = &quot;censored&quot;
    elif ESTIMATOR == &quot;intreg&quot;
      tmpstr2 = &quot;unbounded&quot;
    endif
    tmpstr = sprintf(&quot;Left-%s observations: %d&quot;, tmpstr2, M.n_censored[1])
    if M.Y_censoring &amp;&amp; !isnan(M.low)
      tmpstr = sprintf(&quot;%s (%s &lt;= %f)&quot;, tmpstr, M.Y_name, M.low)
    endif
    printf &quot;%s\n&quot;, tmpstr
    tmpstr = sprintf(&quot;Right-%s observations: %d&quot;, tmpstr2, M.n_censored[2])
    if M.Y_censoring &amp;&amp; !isnan(M.high)
      tmpstr = sprintf(&quot;%s (%s &gt;= %f)&quot;, tmpstr, M.Y_name, M.high)
    endif
    printf &quot;%s\n&quot;, tmpstr
    if ESTIMATOR == &quot;intreg&quot;
      printf &quot;Bounded observations: %d\n&quot;, M.n_censored[3]
      printf &quot;Point observations: %d\n&quot;, M.n_censored[4]
    endif
    if nelem(M.normality_test)
      printf &quot;\nTest for normality of residual -\n&quot;
      printf &quot;  Null hypothesis: error is normally distributed\n&quot;
      printf &quot;  Test statistic: Chi-square(%d) = %f\n&quot;, M.normality_test[&quot;dfn&quot;], M.normality_test[&quot;test&quot;]
      printf &quot;  with p-value = %f\n&quot;, M.normality_test[&quot;pvalue&quot;]
    endif
  endif
endif
# Standard information (PIPs, Means and so on)
print &quot;----------------------------------&quot;
printf &quot;\n&quot;
printf &quot;Prior:\n&quot;
printf &quot;\taverage model size: %f\n&quot;, avg_model_size
printf &quot;\tstandard deviation: %f\n&quot;, M.mod_size_sd_prior
if M.prior_based_bic
  printf &quot;Effective Prior:\n&quot;
  printf &quot;\taverage model size: %f\n&quot;, M.avg_model_size_bic
  printf &quot;\tstandard deviation: %f\n&quot;, M.mod_size_sd_prior_bic
endif
printf &quot;Posterior:\n&quot;
printf &quot;\taverage model size: %f\n&quot;, M.mod_size_av
printf &quot;\tstandard deviation: %f\n&quot;, M.mod_size_sd
printf &quot;\n&quot;
print &quot;----------------------------------&quot;
printf &quot;\n&quot;
print &quot;Posterior moments (unconditional and conditional on inclusion):&quot;
if $version &lt; 20170
  printf &quot;%15f&quot;, M.Post_Results
else
  matrix Post_Results = M.Post_Results
  if M.with_const == 1
    Post_Results[1,1] += 1 # Trick to have const always in the first row after sorting by PIPs
    Post_Results = mreverse(msortby(Post_Results, 1))
    Post_Results[1,1] -= 1
  else
    Post_Results = mreverse(msortby(Post_Results, 1))
  endif
  printf &quot;%15f&quot;, Post_Results
  if M.limited_y &amp;&amp; M.ordered
    printf &quot;\n%15f&quot;, M.cuts_avg
  endif
endif
printf &quot;\n&quot;
print &quot;----------------------------------&quot;
printf &quot;\n&quot;
print &quot;Posterior probability of models:&quot;
loop i=1..rows(M.models_probs_percents) --quiet
  if i &lt;= 4
    printf &quot;Best %d\t models account for %.4f of mass\n&quot;, M.models_probs_percents[i,1], M.models_probs_percents[i,2]
  elif i == rows(M.models_probs_percents)
    printf &quot;Best %d models account for %.4f of mass\n&quot;, M.models_probs_percents[i,1], M.models_probs_percents[i,2]
  else
    printf &quot;Best %d models account for %.4f of mass\n&quot;, M.models_probs_percents[i,1], M.models_probs_percents[i,2]
  endif
endloop
printf &quot;\nBest models ranking:\n&quot;
loop i=1..M.Nrank --quiet
  printf &quot;Model %d:\t%f\n&quot;, i, M.Numerical_Likelihood[i]
endloop
printf &quot;Total probability of the models in ranking (numerical): %f\n\n&quot;, sumc(M.Numerical_Likelihood)
printf &quot;Correlation coefficient between the analytical\n&quot;
printf &quot;and numerical probabilities of the above models: %f\n&quot;, corr(M.Numerical_Likelihood, M.mod_rank_prob)
# Contingency table
if M.limited_y
  printf &quot;\n&quot;
  print &quot;----------------------------------&quot;
  printf &quot;\n&quot;
  print &quot;Contingency table (actual in rows, predicted in columns):&quot;
  eval M.contingency
  printf &quot;Number of cases 'correctly predicted' = %d (accuracy %.1f%%)\n&quot;, M.correctly_predicted, 100*M.correctly_predicted/sum(M.contingency)
endif
# Forecasts
if M.Npredict
  printf &quot;\n&quot;
  print &quot;----------------------------------&quot;
  printf &quot;\n&quot;
  print &quot;Predictive results:&quot;
  printf &quot;%15f&quot;, M.prediction
  printf &quot;\n&quot;
endif
# Jointess analysis
if M.do_joint
  matrix jointess_measure = BACE_jointness_measure(&amp;M)
  string jointess_measure_name = M.jointess_measure_names[M.do_joint]
  print &quot;----------------------------------&quot;
  printf &quot;\n&quot;
  print &quot;Posterior joint probability of variables:&quot;
  printf &quot;%15f&quot;, M.jointness_m
  printf &quot;\nJointness statistics (%s):\n&quot;, jointess_measure_name
  printf &quot;%15f&quot;, jointess_measure
  scalar strong_sub = 0
  scalar significant_sub = 0
  scalar strong_com = 0
  scalar significant_com = 0
  matrix pairs = zeros(round(0.5*M.k^2), 3)
  scalar pair = 0
  loop i=1..M.k --quiet
    loop j=i+1..M.k --quiet
      if !isnan(jointess_measure[i,j]) &amp;&amp; abs(jointess_measure[i,j]) &gt; 1
        pair += 1
        pairs[pair,1] = jointess_measure[i,j]
        pairs[pair,2] = i
        pairs[pair,3] = j
        if (jointess_measure[i,j] &lt; 0)
          if (jointess_measure[i,j] &lt; -2)
            strong_sub += 1
          else
            significant_sub += 1
          endif
        else
          if jointess_measure[i,j] &gt; 2
            strong_com += 1
          else
            significant_com += 1
          endif
        endif
      endif
    endloop
  endloop
  if pair &gt; 0
    pairs = msortby(pairs[1:pair, ], 1)
    scalar shift = 0
    if strong_sub &gt; 0
      BACE_jointness_pairs(&quot;Strong substitutes:&quot;, &amp;strong_sub, M.var_numbers, &amp;shift, &amp;pairs, M.jointness_m)
    endif
    if significant_sub &gt; 0
      BACE_jointness_pairs(&quot;Significant substitutes:&quot;, &amp;significant_sub, M.var_numbers, &amp;shift, &amp;pairs, M.jointness_m)
    endif
    if significant_com &gt; 0
      BACE_jointness_pairs(&quot;Significant complements:&quot;, &amp;significant_com, M.var_numbers, &amp;shift, &amp;pairs, M.jointness_m)
    endif
    if strong_com &gt; 0
      BACE_jointness_pairs(&quot;Strong complements:&quot;, &amp;strong_com, M.var_numbers, &amp;shift, &amp;pairs, M.jointness_m)
    endif
  endif
endif
# Printing models in ranking
if M.verbosity == 2
  strings Xnames # names of X-es
  printf &quot;\n\nBest specifications (MLE estimates for %s model):&quot;, model_type
  loop i=1..M.Nrank --quiet
    if M.mod_nume_prob[i]
      printf &quot;\n&quot;
      print &quot;----------------------------------&quot;
      printf &quot;\nModel %d: %s: %.6f, posterior probability: %f&quot;, i, M.bic_type_name, M.mod_rank_bic[i], M.Numerical_Likelihood[i]
      if sumr(M.mod_rank[i]) == 0 &amp;&amp; M.with_const != 1
        printf &quot;\n\n  %s\n&quot;, &quot;None of the variables were significant.&quot;
        printf &quot;  %s\n&quot;, &quot;Model includes only the intercept term which is simply the average of the dependent variable.&quot;
      else
        coeffmat = M.mod_rank_estimates[i][,1:2]
        Xnames = M.all_names_sp_m[M.mod_rank_estimates[i][,3]]
        if M.limited_y &amp;&amp; M.ordered
          coeffmat = coeffmat | M.mod_rank_cuts_estimates[i]
          Xnames += M.cuts_names
        endif
        modprint coeffmat Xnames
      endif
    endif
  endloop
endif
print &quot;----------------------------------&quot;
printf &quot;\n\n&quot;
</code>
</gretl-function>
<gretl-function name="BACE_Plot" type="void" pkg-role="bundle-plot">
 <params count="1">
  <param name="MODEL" type="bundleref" const="true"/>
 </params>
<code>/*
BACE result bundle plot function.
*/
string legend, output, basename, xtics
string yrange = &quot;&quot;
scalar avg_model_size = 0
scalar idx
strings title
if $sysinfo.gui_mode
  basename = &quot;display&quot;
else
  basename = strftime($now[1], &quot;%Y%m%d%H%M%S&quot;)
endif
# We set up avg_model_size
if MODEL.prior_name == &quot;none&quot; &amp;&amp; MODEL.prior_based_bic
  avg_model_size = MODEL.avg_model_size_bic
elif MODEL.prior_name != &quot;none&quot; &amp;&amp; !MODEL.prior_based_bic
  avg_model_size = MODEL.avg_model_size
elif MODEL.prior_name != &quot;none&quot; &amp;&amp; MODEL.prior_based_bic
  avg_model_size = xmax(MODEL.avg_model_size, MODEL.avg_model_size_bic)
endif
# We decide where the legend should be placed
if MODEL.mod_size_av &gt; avg_model_size
  legend = &quot;left&quot;
else
  legend = &quot;right&quot;
endif
#########################################################
#						Heatmaps						#
#########################################################
# Heatmap for variable inclusion
BACE_heatmap(MODEL, &quot;inclusions&quot;, basename)
# Heatmap for jointness
if MODEL.do_joint
  BACE_heatmap(MODEL, &quot;jointness&quot;, basename)
endif
#########################################################
#						Distributions					#
#########################################################
# Models size distribution
plotmat = mreverse(MODEL.mod_sizes, 1)
output = basename
if !$sysinfo.gui_mode
  output = output ~ &quot;-MSD.plt&quot;
endif
if rows(plotmat) &lt; 20
  xtics = &quot;set xtics 1&quot;
else
  xtics = &quot;&quot;
endif
plot plotmat
  options with-lp fit=none
  literal set link y2 via y inverse y
  printf &quot;%s&quot;, xtics
  printf &quot;set title \&quot;%s\&quot;&quot;, &quot;Model Size Distribution&quot;
  printf &quot;set xlabel \&quot;%s\&quot;&quot;, &quot;Model Size&quot;
  printf &quot;set ylabel \&quot;%s\&quot;&quot;, &quot;Density&quot;
  printf &quot;set key %s top&quot;, legend
end plot --output=@output
# Models size CDF
plotmat = MODEL.models_probs_cdf
output = basename
if !$sysinfo.gui_mode
  output = output ~ &quot;-CDF.plt&quot;
endif
if rows(plotmat) &lt; 20
  xtics = &quot;set xtics 1&quot;
else
  xtics = &quot;&quot;
endif
plot plotmat
  options with-line fit=none
  literal set grid
  printf &quot;%s&quot;, xtics
  printf &quot;set title \&quot;%s\&quot;&quot;, &quot;CDF of Model Size&quot;
  printf &quot;set xlabel \&quot;%s\&quot;&quot;, &quot;Number of Models&quot;
  printf &quot;set ylabel \&quot;%s\&quot;&quot;, &quot;Posterior Probability Mass&quot;
end plot --output=@output
# Model prior distribution values
idx = 1 + (MODEL.with_const != 1 &amp;&amp; !(MODEL.limited_y &amp;&amp; MODEL.ordered))
title = defarray(MODEL.prior_name, &quot;Size&quot;)
plotmat = exp(MODEL.model_prior_log)[idx:end] ~ MODEL.mod_sizes[,1]
if MODEL.prior_based_bic
  plotmat = exp(MODEL.model_prior_bic_log)[idx:end] ~ plotmat
  plotmat = sumr(plotmat[,1:2]) ~ plotmat
  yrange = sprintf(&quot;set yrange [0:%f]&quot;, 1.1*max(plotmat[,1:end-1]))
  title = defarray(&quot;Effective&quot;, MODEL.bic_type_name) + title
endif
cnameset(plotmat, title)
output = basename
if !$sysinfo.gui_mode
  output = output ~ &quot;-MPD.plt&quot;
endif
if rows(plotmat) &lt; 20
  xtics = &quot;set xtics 1&quot;
else
  xtics = &quot;&quot;
endif
plot plotmat
  options with-lp fit=none
  literal set link y2 via y inverse y
  printf &quot;%s&quot;, xtics
  printf &quot;%s&quot;, yrange
  printf &quot;set title \&quot;%s\&quot;&quot;, &quot;Prior Model Probabilities&quot;
  printf &quot;set xlabel \&quot;%s\&quot;&quot;, &quot;Model Size&quot;
  printf &quot;set ylabel \&quot;%s\&quot;&quot;, &quot;Value&quot;
  printf &quot;set key %s top&quot;, legend
end plot --output=@output
#########################################################
#						Forecasts						#
#########################################################
# Predictive results
if MODEL.Npredict
  plotmat = MODEL.prediction[,1:2]
  bars = MODEL.prediction[,2:3]
  if MODEL.limited_y
    bars[,2] = zeros(MODEL.Npredict)
  endif
  cnameset(plotmat, cnameget(MODEL.prediction)[1:2])
  output = basename
  if !$sysinfo.gui_mode
    output = output ~ &quot;-predict.plt&quot;
  endif
  xtics = &quot;(&quot;
  loop i=1..MODEL.Npredict --quiet
    xtics += sprintf(&quot;\&quot;%s\&quot; %d&quot;, rnameget(MODEL.prediction)[i], i)
    if i == MODEL.Npredict
      xtics += sprintf(&quot;)&quot;)
    else
      xtics += sprintf(&quot;, &quot;)
    endif
  endloop
  plot plotmat
    options time-series with-lines
    options with-line fit=none
    options band=bars,1 band-style=bars
    printf &quot;set title \&quot;%s\&quot;&quot;, &quot;Predictive results (with +/- one standard deviations as bars)&quot;
    printf &quot;set xlabel \&quot;%s\&quot;&quot;, &quot;Observation&quot;
    printf &quot;set xtics %s&quot;, xtics
  end plot --output=@output
endif
</code>
</gretl-function>
<gretl-function name="BACE_GUI" type="bundle" pkg-role="gui-main">
 <params count="11">
  <param name="model_type" type="int" min="1" max="5" default="1">
<description>Model type</description>
<labels count="5">
"logit (including ordered)" "probit (including ordered)" "poisson" "tobit" "linear" </labels>
  </param>
  <param name="Y" type="series">
<description>Dependent variable</description>
  </param>
  <param name="X_list" type="list" optional="true">
<description>List of independent variables (X)</description>
  </param>
  <param name="with_const" type="int" min="0" max="2" default="1">
<description>Constant in model</description>
<labels count="3">
"Never" "Always" "Can be dropped" </labels>
  </param>
  <param name="model_prior" type="int" min="0" max="2" default="1">
<description>Model prior</description>
<labels count="3">
"none" "Binomial" "Beta-Binomial" </labels>
  </param>
  <param name="bic_type" type="int" min="1" max="4" default="2">
<description>Bayesian information criterion</description>
<labels count="4">
"BIC" "HBIC" "IBIC" "EBIC" </labels>
  </param>
  <param name="do_joint" type="int" min="0" max="7" default="0">
<description>Jointness analysis</description>
<labels count="8">
"None" "Doppelhofer-Weeks Measure (DW1)" "Doppelhofer-Weeks Measure (DW2)" "Ley-Steel Measure (LS1)" "Ley-Steel Measure (LS2)" "Strachan Measure (SM)" "Yule's Q Measure (YQ)" "Modified Yule's Q Measure (MYQ)" </labels>
  </param>
  <param name="Npredict" type="int" min="0" default="0">
<description>Number of out-of-sample forecasts</description>
  </param>
  <param name="verbosity" type="int" min="1" max="2" default="2">
<description>Verbosity</description>
  </param>
  <param name="show_progress" type="bool" default="1">
<description>Show overall progress</description>
  </param>
  <param name="do_plot" type="bool" default="1">
<description>Plot graphs?</description>
  </param>
 </params>
<code>/*
GUI-based function to carry out BACE analysis.
Function is a wrapper to bundle-based BACE() interface.
*/
# Basic parsing and checking
bundle Options, RES
string err
# Mapping GUI model_types indexes to strings
strings ModelTypes = defarray(&quot;logit&quot;, &quot;probit&quot;, &quot;poisson&quot;, &quot;tobit&quot;, &quot;linear&quot;)
string Y_name = argname(Y)
series @Y_name = Y
scalar Options[&quot;with_const&quot;] = with_const
scalar Options[&quot;model_prior&quot;] = model_prior
scalar Options[&quot;do_joint&quot;] = do_joint
scalar Options[&quot;Npredict&quot;] = Npredict
scalar Options[&quot;verbosity&quot;] = verbosity
scalar Options[&quot;show_progress&quot;] = show_progress
scalar Options[&quot;do_plot&quot;] = do_plot
scalar Options[&quot;bic_type&quot;] = bic_type
string Options[&quot;model_type&quot;] = ModelTypes[model_type]
scalar Options[&quot;_gui&quot;] = 1
RES = BACE(@Y_name, X_list, Options)
if inbundle(RES, &quot;err&quot;)
  err = RES[&quot;err&quot;]
  funcerr &quot;@err !!!&quot;
endif
return RES
</code>
</gretl-function>
<gretl-function name="BACE_parse" type="string" private="1">
 <params count="6">
  <param name="M" type="bundleref"/>
  <param name="Y" type="series"/>
  <param name="Y_names" type="strings"/>
  <param name="X_list" type="list"/>
  <param name="nY" type="int" default="1"/>
  <param name="Y2" type="series" optional="true"/>
 </params>
<code>/*
Function parses given parameters end checks several conditions:
M		- pointer to the bundle
Y		- dependent variable(s)
Y_names	- name(s) of dependent variable(s)
X_list	- list of given independent variables
nY 		- number of Y variables (used only for intreg)
Y2 		- the second Y series (right bounds for intreg)
#
Returns: string err holding the first error found in given dataset or parameters
*/
# We setup estimator
if M.model_type == &quot;linear&quot;
  string M.estimator = &quot;ols&quot;
else
  string M.estimator = M.model_type
endif
# Local variables
scalar k = nelem(X_list) + M.y_lag + (M.with_const &gt; 1)
if nY == 1
  matrix Y_uniq = uniq(Y)
else
  matrix Y_uniq = uniq(Y + Y2)
endif
string Y_name = Y_names[1]
string err = &quot;&quot;
string ESTIMATOR = M.estimator
string tmp_str
scalar err_nr
#################################################################################
#	Critical problems 															#
#################################################################################
# We check if Y variable &quot;is discrete&quot; or &quot;count data&quot; in case of non-OLS model
if M.limited_y &amp;&amp; sum(Y_uniq - int(Y_uniq)) &gt; 0
  err = &quot;The dependent variable is not discrete&quot;
elif M.model_type == &quot;poisson&quot; &amp;&amp; (sum(Y_uniq - int(Y_uniq)) &gt; 0 || max(Y) &lt;= 1)
  err = &quot;The dependent variable must be count data&quot;
endif
# We check if we have more than 1 Y only for intreg
if nY &gt; 1 &amp;&amp; M.model_type != &quot;intreg&quot;
  err = sprintf(&quot;You cannot specify %d Y variables for %s model&quot;, nY, M.model_type)
endif
# We check impossible options for models
if ESTIMATOR == &quot;intreg&quot; &amp;&amp; M.with_const != 1
  err = &quot;Interval regression model must include constant&quot;
elif ESTIMATOR == &quot;intreg&quot; &amp;&amp; M.y_lag
  err = &quot;Interval regression model must not include lagged dependend variable&quot;
endif
# We check if average model size is within 0 and K
if M.avg_model_size &lt;= 0 || M.avg_model_size &gt;= k
  err = &quot;Average model size should be greater than 0 and lower than K&quot;
endif
# We check if aplha values
if M.alpha == 0 &amp;&amp; M.with_const == 0
  err = &quot;We cannot have empty initial model (alpha=0) when we don't have constant&quot;
elif M.model_type == &quot;intreg&quot; &amp;&amp; M.alpha != 1
  err = &quot;For interval regression model we must have alpha=1&quot;
endif
# We check if number of models in ranking is not greater than 2^K (model space)
if M.Nrank &gt; 2^(k+M.y_lag)
  err = &quot;Number of the top ranked models cannot be greater than 2^K (space of parameters)&quot;
endif
# We check if we have y_lag only in case of linear model for time-series
if M.y_lag &gt; 0 &amp;&amp; (M.model_type != &quot;linear&quot; || $datatype != 2)
  string datatype
  if $datatype == 1
    datatype = &quot;cross-sectional (undated) data&quot;
  elif $datatype == 2
    datatype = &quot;time-series data&quot;
  elif $datatype == 3
    datatype = &quot;panel data&quot;
  endif
  err = sprintf(&quot;You try to estimate %s model for %s =&gt; you cannot have lagged %s&quot;, M.model_type, datatype, Y_name)
endif
# If we found critical problem then interupt
if strlen(err)
  return err
endif
#################################################################################
#	Non-critical problems 														#
#################################################################################
# We check if given X_list does not include Y
if inlist(X_list, Y_name) != 0
  X_list -= X_list[inlist(X_list, Y_name)]
  k -= 1
  print &quot;Dependent variable was removed from the X list.&quot;
endif
# We check if given X_list does not include lagged Y
if M.y_lag &gt; 0
  loop i=1..M.y_lag --quiet
    tmp_str = Y_name ~ &quot;_&quot; ~ &quot;$i&quot;
    if inlist(X_list, tmp_str) != 0
      X_list -= X_list[inlist(X_list, tmp_str)]
      k -= 1
      printf &quot;Lag %d of dependent viariable (%s) was removed from the X list.\n&quot;, i, tmp_str
    endif
  endloop
endif
# We check if given X_list does not include const
if inlist(X_list, const) != 0
  X_list -= const
  k -= 1
  print &quot;Const was removed from the X list.&quot;
endif
# We check if given variables are not co-linear
if nelem(X_list) &gt; 0
  if M.y_lag &gt; 0
    catch @ESTIMATOR Y Y(-1 to -M.y_lag) X_list const --quiet
    err_nr = $error
  else
    if ESTIMATOR == &quot;intreg&quot;
      catch intreg Y Y2 X_list const --quiet
      err_nr = $error
    else
      catch @ESTIMATOR Y X_list const --quiet
      err_nr = $error
    endif
  endif
  if err_nr
    return sprintf(&quot;We could not estimate %s model: %s&quot;, M.model_type, errmsg(err_nr))
  endif
  if $ncoeff &lt; k + 1
    X_list = $xlist - const
    if M.y_lag &gt; 0
      loop i=1..M.y_lag --quiet
        X_list = X_list - Y_$i
      endloop
    endif
    print &quot;Some of the independent variables were colinear and were dropped.&quot;
  endif
endif
series M.Y = Y
string M.Y_name = Y_name
matrix M.X_list = X_list
if nY == 2
  series M.Y2 = Y2
  string M.Y_name2 = Y_names[2]
endif
return err
</code>
</gretl-function>
<gretl-function name="BACE_initial_model" type="void" private="1">
 <params count="1">
  <param name="M" type="bundleref"/>
 </params>
<code>/*
Function creates list of variables in the initial model.
*M - pointer to the main bundle
#
Local variables:
Y		- dependent variable
max_k	- number of given indenpendent variables
X_list2	- M.X_list in a form of list (not matrix)
*/
# Local variables
string ESTIMATOR_OPTS = &quot;--quiet&quot;
# We set up estimator command
string ESTIMATOR = M.estimator
# If we have ordered logit/probit we have to correct $ncoeff
scalar cuts = 0
if M.limited_y
  cuts = M.cuts
endif
# Do we have additional OPTS for estimator
if M.Y_censoring &amp;&amp; ESTIMATOR == &quot;tobit&quot;
  ESTIMATOR_OPTS = sprintf(&quot;%s %s&quot;, M.estimator_opts, ESTIMATOR_OPTS)
endif
# Starting values of the local variables
if M.Npredict
  if M.y_lag == 0
    smpl 1 M.N
  else
    if M.CPU_num == 1
      #smpl M.first_obs+($nobs-M.N) M.last_obs #+($t1-1)
      smpl $t1 M.last_obs
    else
      smpl M.last_obs-M.N+1 M.last_obs
    endif
  endif
endif
# We re-create Y(s) and X-s
if inbundle(M, &quot;Y2&quot;)
  string Y1_name = M.Y_name
  string Y2_name = M.Y_name2
  series @Y1_name = M.Y
  series @Y2_name = M.Y2
  list YyY = @Y1_name @Y2_name
else
  series YyY = M.Y
endif
if M.y_lag &gt; 0
  lags M.y_lag ; YyY
endif
list X_list2 = M.X_list
list last = {}
scalar max_k = cols(M.var_numbers2)
if M.alpha == 0 # Empty model (const only)
  if M.with_const == 2
    last += const
    M.k_new = 1
  else
    M.k_new = 0
  endif
  if ESTIMATOR == &quot;tobit&quot;
    if M.with_const == 1
      tobit YyY const @ESTIMATOR_OPTS
    else
      tobit YyY last @ESTIMATOR_OPTS
    endif
    M.n_censored = { $model.n_left ; $model.n_right }
    if inbundle($model, &quot;normality_test&quot;)
      M.normality_test = $model.normality_test
    endif
  endif
elif M.alpha == 1 # Trully random model
  M.k_new = randint(0, max_k)
  matrix last_tmp
  if M.k_new &gt; 0
    if M.k_new == max_k # All variables in the starting model, nothing to draw
      last = X_list2
    else
      loop i=1..M.k_new --quiet
        scalar accept = 0
        loop while (accept == 0) --quiet
          cand = transp(M.var_numbers2)[randint(1, max_k), 1]
          if inlist(last, cand) == 0
            last_tmp = last_tmp ~ {cand}
            accept = 1
          endif
        endloop
      endloop
      # We have to sort variables in created list
      matrix last_mat = zeros(2, M.k_new)
      last_mat[1,] = last_tmp
      loop i=1..M.k_new --quiet
        loop j=1..max_k --quiet
          if last_mat[1,i] == M.var_numbers2[1,j]
            last_mat[2,i] = M.var_numbers2[2,j]
            break
          endif
        endloop
      endloop
      last_mat = transp(msortby(transp(last_mat),2))
      # We verify if we don't have duplicated variables on a list
      last_tmp = uniq(last_mat[1,])
      if nelem(last_tmp) &lt; M.k_new
        last = last_tmp
        M.k_new = nelem(last_tmp)
      else
        last = last_mat[1,]
      endif
      if M.with_const == 1
        @ESTIMATOR YyY const last @ESTIMATOR_OPTS
      else
        @ESTIMATOR YyY last @ESTIMATOR_OPTS
      endif
      last = $xlist
      if M.with_const == 1
        last -= const
        M.k_new = $ncoeff-1
      else
        M.k_new = $ncoeff-cuts
      endif
      M.StartModel_b = $model
      strings M.StartModel_xnames = varnames($xlist)
    endif
  endif
  if M.censored_y
    if M.k_new == max_k
      @ESTIMATOR YyY const last @ESTIMATOR_OPTS
    elif M.k_new == 0 &amp;&amp; ESTIMATOR == &quot;intreg&quot;
      intreg YyY const @ESTIMATOR_OPTS
    endif
    M.StartModel_b = $model
    strings M.StartModel_xnames = varnames($xlist)
    M.n_censored = { $model.n_left ; $model.n_right }
    if ESTIMATOR == &quot;intreg&quot;
      M.n_censored = M.n_censored | { $model.n_both ; $model.n_point }
    endif
    if inbundle($model, &quot;normality_test&quot;)
      M.normality_test = $model.normality_test
    endif
  endif
else
  # Model reduced at given alpha
  if M.with_const == 1
    @ESTIMATOR YyY const X_list2 @ESTIMATOR_OPTS
  else
    @ESTIMATOR YyY X_list2 @ESTIMATOR_OPTS
  endif
  if nelem($xlist) &gt; 1
    omit --auto=M.alpha --silent
  endif
  last = $xlist
  if M.with_const == 1
    last -= const
    M.k_new = $ncoeff-1
  else
    M.k_new = $ncoeff-cuts
  endif
  M.StartModel_b = $model
  strings M.StartModel_xnames = varnames($xlist)
  if ESTIMATOR == &quot;tobit&quot;
    M.n_censored = { $model.n_left ; $model.n_right }
    if inbundle($model, &quot;normality_test&quot;)
      M.normality_test = $model.normality_test
    endif
  endif
endif
# Starting values
matrix M.StartModel = last
matrix M.mod_struct_new = zeros(1,M.k)
# Setting 1 for variables in current draw
loop i=1..cols(M.StartModel) --quiet
  loop j=1..M.k --quiet
    if M.var_numbers2[1,j] == M.StartModel[i]
      M.mod_struct_new[M.var_numbers2[2,j]-1] = 1
      break
    endif
  endloop
endloop
</code>
</gretl-function>
<gretl-function name="BACE_jointness_pairs" type="void" private="1">
 <params count="6">
  <param name="MODE" type="string"/>
  <param name="n_pairs" type="scalarref"/>
  <param name="var_numbers" type="matrix"/>
  <param name="shift" type="scalarref"/>
  <param name="pairs" type="matrixref"/>
  <param name="jointness_m" type="matrix"/>
 </params>
<code>/*
Function for generating vector with pairs of hightly releated variables
and jointness statistics for these pairs:
MODE			- string with type of relation between variables
*n_pairs		- pointer to the scalar with number of pairs of related variables
*var_numbers	- pointer to the matrix holding numbers of variables
*shift			- pointer to the scalar holding total number of previous pairs (shift in the &quot;pairs&quot; vector)
*pairs			- pointer to the vector holding (ordered) pairs of hightly related variables
jointness_m		- matrix with counts for every pair
*/
matrix pairs_related = pairs[shift + 1 : shift + n_pairs, ]
shift += n_pairs
string pair_names = &quot;&quot;
loop i=1..n_pairs --quiet
  pair_names += &quot; &quot; ~ cnameget(jointness_m, pairs_related[i,2]) ~ &quot;,&quot; ~ cnameget(jointness_m, pairs_related[i,3])
endloop
matrix pairs_related = pairs_related[,1]
loop i=1..nelem(pairs_related) --quiet
  if ok(pairs_related[i]) &amp;&amp; abs(pairs_related[i]) == 999
    pairs_related[i] = sgn(pairs_related[1]) * 1/0
  endif
endloop
printf &quot;\n%s\n&quot;, MODE
rnameset(pairs_related, pair_names)
eval pairs_related
</code>
</gretl-function>
<gretl-function name="BACE_summary" type="void" private="1">
 <params count="1">
  <param name="M" type="bundleref"/>
 </params>
<code>/*
We summarise some BACE results and deleting redundand items from the returned bundle.
*/
BACE_print_status(&quot;Summarizing&quot;)
scalar tmps, factor, k
strings title
matrix percents1, percents2, tmpm
scalar NORM = M.Nrep - M.Nburn
series Y = M.Y
series Yhat
list xtab_l
M.bhat_avg = transp(M.bhat_avg)
M.bvar_avg = transp(M.bvar_avg)
# Restoring values of model_prior to 0 if we have 'none'
if M.prior_name == &quot;none&quot;
  M.model_prior_log = log(exp(M.model_prior_log)-1)
endif
# Normalisations
if sum(exp(M.mod_rank_prob)) == 0
  M.mod_rank_prob = (M.mod_rank_prob / sum(M.mod_rank_prob)) .^ -1
endif
M.mod_rank_prob = exp(M.mod_rank_prob) / sum(exp(M.mod_rank_prob))
M.Numerical_Likelihood = M.mod_nume_prob / NORM
M.Post_Results = transp(M.var_prob / NORM)
M.bhat_avg = M.bhat_avg / NORM
M.bvar_avg = M.bvar_avg / NORM
M.consthat_avg = M.consthat_avg / NORM
M.constvar_avg = M.constvar_avg / NORM
if M.with_const == 1
  M.bhat_avg = M.consthat_avg ~ M.bhat_avg
  M.bvar_avg = M.constvar_avg ~ M.bvar_avg
  M.Post_Results = {1} | M.Post_Results
endif
if M.limited_y
  M.Yhat = M.Yhat / NORM
  if M.ordered
    M.cutshat_avg = M.cutshat_avg / NORM
    M.cutsvar_avg = M.cutsvar_avg / NORM
  endif
endif
# Average model size (including matrix for plot)
M.mod_size = sum(M.mod_sizes[,1] .* M.mod_sizes[,2])
M.mod_sizes[,2] = M.mod_sizes[,2] / NORM
M.mod_size_av = sum(M.mod_sizes[,1] .* M.mod_sizes[,2])
M.mod_size_sd = sqrt(sum((M.mod_sizes[,1] - M.mod_size_av) .^2 .* M.mod_sizes[,2]))
M.mod_sizes = M.mod_sizes ~ zeros(rows(M.mod_sizes),1)
tmpm = M.mod_sizes[,3]
loop i=1..rows(M.mod_sizes) --quiet
  k = M.mod_sizes[i,1]
  factor = bincoeff(M.k,k)
  if M.with_const != 1 &amp;&amp; !(M.limited_y &amp;&amp; M.ordered)
    M.mod_sizes[i,3] = exp(M.model_prior_log[i+1])
    if M.prior_based_bic
      tmpm[i] = M.mod_sizes[i,3] - exp(M.model_prior_bic_log[i+1])
    endif
  else
    M.mod_sizes[i,3] = exp(M.model_prior_log[i])
    if M.prior_based_bic
      tmpm[i] = M.mod_sizes[i,3] - exp(M.model_prior_bic_log[i])
    endif
  endif
  M.mod_sizes[i,3] = M.mod_sizes[i,3] * factor
  if M.prior_based_bic
    tmpm[i] = tmpm[i] * factor
  endif
endloop
if M.prior_name == &quot;none&quot;
  M.mod_size_sd_prior = NA
else
  M.mod_size_sd_prior = sqrt(sum((M.mod_sizes[,1] - M.avg_model_size) .^2 .* M.mod_sizes[,3]))
endif
if M.prior_based_bic
  tmpm = tmpm / sum(tmpm)
  M.avg_model_size_bic = sum(M.mod_sizes[,1] .* tmpm)
  M.mod_size_sd_prior_bic = sqrt(sum((M.mod_sizes[,1] - M.avg_model_size_bic) .^2 .* tmpm))
  M.mod_sizes = M.mod_sizes ~ tmpm
endif
# Models size distribution
title = defarray(&quot;Size&quot;, &quot;Posterior&quot;, &quot;Prior&quot;)
if M.prior_based_bic
  title += defarray(&quot;Effective Prior&quot;)
endif
cnameset(M.mod_sizes, title)
# Models size CDF
M.models_probs_cum = M.models_probs_cum / NORM
if M.post_n_models_accepted &lt; 100
  factor = 1
else
  factor = int(M.post_n_models_accepted/100)
endif
M.models_probs_cdf = seq(1, M.post_n_models_accepted, factor)'
M.models_probs_cdf = M.models_probs_cum[M.models_probs_cdf] ~ M.models_probs_cdf
# Best 100 models
percents1 = { 5; 25; 50; 75; 100 }
percents1 = selifr(percents1, percents1 .&lt; M.post_n_models_accepted)
percents1 = percents1 ~ zeros(nelem(percents1))
if rows(percents1) &gt; 0
  loop i=1..rows(percents1) --quiet
    percents1[i,2] = M.models_probs_cum[percents1[i,1]]
  endloop
  percents1 = selifr(percents1, percents1[,2] .&gt; 0)
endif
# We look for certain percentiles
percents2 = { 50; 75; 90; 95; 99 }
if nelem(percents1) &gt; 0
  percents2 = selifr(percents2, percents2 .&gt; percents1[end,end])
  tmps = percents1[rows(percents1),1]
else
  tmps = 1
endif
percents2 = zeros(nelem(percents2)) ~ percents2
nr = 1
loop i=tmps..M.post_n_models_accepted-1 --quiet
  if 100*M.models_probs_cum[i] &gt;= percents2[nr,2]
    percents2[nr,1] = i
    percents2[nr++,2] = M.models_probs_cum[i]
  endif
  if nr == rows(percents2)+1 || nr &gt; M.post_n_models_accepted
    break
  endif
endloop
percents2 = selifr(percents2, percents2[,1] .&gt; 0)
M.models_probs_percents = percents2 | { M.post_n_models_accepted , 1 }
if nelem(percents1) &gt; 0
  tmps = sum(contains(percents2[,1], percents1[,1]))
  if tmps &gt; 0
    M.models_probs_percents = M.models_probs_percents[tmps+1:end,]
  endif
  M.models_probs_percents = percents1 | M.models_probs_percents
endif
# We construct Post_Results matrix
matrix bvar = sqrt(M.bvar_avg - M.bhat_avg.^2)
matrix tmp = M.bhat_avg' ~ bvar'
M.Post_Results = M.Post_Results ~ tmp
tmp = M.Post_Results[,2] ./ M.Post_Results[,1]
M.Post_Results = M.Post_Results ~ tmp
tmp = sqrt((M.Post_Results[,3] .* M.Post_Results[,3] .+ M.Post_Results[,2] .* M.Post_Results[,2]) ./ M.Post_Results[,1] .- M.Post_Results[,4] .* M.Post_Results[,4])
M.Post_Results = M.Post_Results ~ tmp
title = defarray(&quot;PIP&quot;, &quot;Mean&quot;, &quot;Std.Dev.&quot;, &quot;Cond.Mean&quot;, &quot;Cond.Std.Dev.&quot;)
cnameset(M.Post_Results, title)
rnameset(M.Post_Results, M.all_names_sp_m)
if M.limited_y &amp;&amp; M.ordered
  matrix bvar = sqrt(M.cutsvar_avg - M.cutshat_avg.^2)
  matrix M.cuts_avg = M.cutshat_avg ~ bvar
  title = defarray(&quot;Mean&quot;, &quot;Std.Dev.&quot;)
  cnameset(M.cuts_avg, title)
  rnameset(M.cuts_avg, M.cuts_names)
endif
if M.limited_y
  if nelem(instrings(M.DiscreteModelTypes[1:2], M.model_type))
    if !M.ordered
      M.Yhat = M.Yhat .&gt;= M.binary_threshold
    else
      Yhat = M.Yhat
      tmps = M.model_type == &quot;logit&quot; ? 1 : 0
      M.Yhat = ordered_prediction(M.cuts_avg[,1], Yhat, M.yvalues[1], tmps, 1)
    endif
  endif
  Yhat = M.Yhat
  xtab_l = Y Yhat
  xtab xtab_l --zeros --no-totals --quiet
  M.contingency = $result
  M.correctly_predicted = sum(Y == Yhat)
endif
# Forecasts
if M.Npredict
  M.Yhat_predict_avg = M.Yhat_avg / NORM
  M.Yhat_predict_var_avg = M.Yhat_var_avg / NORM
  M.Yhat_predict_var_avg = sqrt(M.Yhat_predict_var_avg - M.Yhat_predict_avg .^ 2)
  M.prediction = M.Y_mat_predict ~ M.Yhat_predict_avg ~ M.Yhat_predict_var_avg
  title = defarray(M.Y_name, &quot;Mean&quot;, &quot;Std.Dev&quot;)
  if M.model_type == &quot;intreg&quot;
    title[1] = &quot;const&quot;
    M.prediction[,1] = 1
  endif
  if M.limited_y
    M.prediction[,3] = M.prediction[,2]
    M.prediction[,2] = M.prediction[,2] .&gt;= M.binary_threshold
    title[2] = &quot;Forecast&quot;
    title[3] = &quot;Mean&quot;
  endif
  cnameset(M.prediction, title)
  rnameset(M.prediction, M.predict_obs_names)
endif
# Jointess analysis
if M.do_joint
  # We must clean up principal diagonal
  M.jointness_m[diag] = 0
  M.jointness_m = M.jointness_m / NORM
  M.jointness_m = M.jointness_m + upper(M.jointness_m)'
  if M.with_const == 1
    cnameset(M.jointness_m, M.all_names_sp_m[2:end])
    rnameset(M.jointness_m, M.all_names_sp_m[2:end])
  else
    cnameset(M.jointness_m, M.all_names_sp_m)
    rnameset(M.jointness_m, M.all_names_sp_m)
  endif
endif
# Cleaning up the bundle
delete M.show_progress
delete M.var_numbers2
delete M.k_new
delete M.lprob_new
delete M.X_new_num
delete M.k_old
delete M.lprob_old
delete M.X_old_num
delete M.mod_struct_old
delete M.mod_struct_new
delete M.var_prob
delete M.a
delete M.b
delete M.bhat_avg
delete M.bvar_avg
delete M.X_list
delete M.N
delete M.bic_correction
delete M.bhat_tmp
delete M.bvar_tmp
delete M.consthat_avg
delete M.constvar_avg
delete M.ModelTypes
delete M.BicTypes
delete M.ModelPriorTypes
delete M.ConstTypes
delete M.DataTransTypes
delete M.CPU_num
delete M[&quot;_gui&quot;]
delete M.DiscreteModelTypes
if M.Npredict
  delete M.Y_mat_predict
  delete M.Yhat_predict_avg
  delete M.Yhat_predict_var_avg
  delete M.predict_obs_names
  catch delete M.ess
endif
if M.limited_y
  delete M.Yhat
  if M.ordered
    delete M.cutsvar_avg
    delete M.cutshat_avg
  endif
endif
BACE_print_status(null, 1, 10)
</code>
</gretl-function>
<gretl-function name="BACE_setup" type="void" private="1">
 <params count="2">
  <param name="M" type="bundleref"/>
  <param name="Norig" type="int"/>
 </params>
<code>/*
This function creates BUNDLE holding all BACE information
*/
printf &quot;\n#############################################################################\n&quot;
printf &quot;To do:&quot;
printf &quot;\n * Delete unneeded entries in result bundle.&quot;
printf &quot;\n * Simplify 'if' condition for lags of Y in BACE_estimate().&quot;
printf &quot;\n * Add all possible test/checks/whatever in the case of intreg model.&quot;
printf &quot;\n * Simplify BACE_initial_model().&quot;
printf &quot;\n * Work on speed.&quot;
printf &quot;\n#############################################################################\n&quot;
BACE_print_status(&quot;BACE setup&quot;)
scalar tmp
string tmp_str = &quot;&quot;
list X_list = M.X_list
series Y = M.Y
###############################################
# Global variables (given by user of default) #
###############################################
if ok(Norig)
  scalar M.Norig = Norig
endif
###############################################
# Local variables - presets					  #
###############################################
if M.limited_y
  scalar M.ordered = 0
  scalar M.cuts = 0
  scalar M.correctly_predicted = NA
  matrix M.Yhat = {}
  matrix M.contingency = {}
  strings M.cuts_names = null
  # we check if we have ordered version
  tmp_str = M.estimator
  @tmp_str Y X_list --quiet
  if inbundle($model, &quot;ordered&quot;)
    M.ordered = 1
    M.cuts = $model[&quot;ncoeff&quot;] - $model[&quot;nx&quot;]
    M.cuts_names = $model[&quot;parnames&quot;][end-M.cuts+1:end]
    M.yvalues = values(Y)
    M.with_const = 0
  endif
endif
if M.with_const == 1
  string M.const_type = M.ConstTypes[2]
elif M.with_const == 2
  string M.const_type = M.ConstTypes[3]
  X_list = X_list const
else
  if M.limited_y &amp;&amp; M.ordered
    string M.const_type = M.ConstTypes[1] ~ &quot; (with cut points)&quot;
  else
    string M.const_type = M.ConstTypes[1]
  endif
endif
if M.y_lag &gt; 0
  X_list = lags(M.y_lag, Y) X_list
endif
M.X_list = X_list
###############################################
# Local variables							  #
###############################################
bundle M.StartModel_b = null
scalar M.Nburn = round(M.burn/100*M.Nrep) # number of burn-in draws
scalar M.k = nelem(X_list) # total number of indenpendent variables
scalar M.model_space = 2^M.k
if M.with_const != 1 &amp;&amp; !(M.limited_y &amp;&amp; M.ordered)
  M.model_space -= 1
endif
if M.with_const == 2
  scalar M.k2 = M.k+1 # maximum number of estimated slope coefficients
else
  scalar M.k2 = M.k
endif
scalar M.n_drop_draws = 0
scalar M.loop_maxiter = 3*M.Nrep
scalar M.toler = 1.0e-20
scalar M.CPU_num = 1
scalar M.a = NA
scalar M.b = NA
scalar M.prior_based_bic = NA
matrix M.StartModel = {}
matrix M.Y_mat = { Y }
matrix M.var_numbers = Y || X_list # vector containing numbers of all variables (including Y) in dataset (not in the procedure)
matrix M.var_numbers2 = M.var_numbers[2:1+M.k] | seq(2,1+M.k)
strings M.all_names_sp_m = varnames(X_list)
loop i=1..M.y_lag --quiet
  M.all_names_sp_m[i] = strsub(M.all_names_sp_m[i], &quot;Y_$i&quot;, M.Y_name~&quot;_$i&quot;)
endloop
if M.with_const == 1
  strings const_name = defarray(&quot;const&quot;)
  M.all_names_sp_m = const_name + M.all_names_sp_m
endif
strings M.PriorBasedBic = defarray(&quot;EBIC&quot;)
scalar M.Y_censoring = 0 # do we censore Y?
string M.estimator_opts = &quot;&quot; # options for estimator (command line)
matrix M.n_censored = {}
bundle M.normality_test = null
# In case of &quot;out-of-sample&quot; prediction
if M.Npredict
  scalar M.first_obs = $t1 #y_lag+1 # the first observation for smpl command
  scalar M.last_obs = $tmax-M.Npredict # the last observation for smpl command
  matrix M.Y_mat_predict = M.Y_mat[end-M.Npredict+1:end] # &quot;out-of-sample&quot; matrix of the dependent variable
  M.Y_mat = M.Y_mat[1:end-M.Npredict]
  matrix M.Yhat_predict = zeros(M.Npredict) # vector of Y predictions in current draw
  matrix M.Yhat_predict_var = zeros(M.Npredict) # vector of Y predictions in current draw (variances!!!)
  matrix M.Yhat_predict_avg = zeros(M.Npredict,1) # vector of Y predictions - average
  matrix M.Yhat_predict_var_avg = zeros(M.Npredict,1) # predicion variance
  matrix M.prediction = {} # matrix with prediction results
  strings M.predict_obs_names = obslabel(seq($nobs-M.Npredict+1,$nobs)) # obs labels for forecasts
  smpl M.first_obs M.last_obs #$nobs-h_predict-y_lag #M.last_obs # setting sample
else
  matrix M.Yhat_avg = {}
  matrix M.Yhat_var_avg = {}
  matrix M.Y_mat_predict = {}
  strings M.predict_obs_names = null
endif
scalar M.N = $nobs
# New/old model stuff
scalar M.mod_size = 0 # size of models in MC3 (sum)
scalar M.k_new = 0 # number of variables in the current (new) model
scalar M.k_old = 0 # number of variables in the previous (old) model
scalar M.lprob_new = 0 # natural logarithm of probability of the new model
scalar M.lprob_old = 0 # natural logarithm of probability  of the old model
scalar M.bic_correction = 0 # value for HBIC or IBIC calculation
matrix M.bhat_tmp = {} # temporary column vector containing the estimated coefficients for the current model (candidates)
matrix M.bvar_tmp = {} # temporary column vector containing the variances of the coefficients for the current model (candidates)
matrix M.X_new_num = {} # vector containing numbers of variables in the new model
matrix M.X_old_num = {} # vector containing numbers of variables in the old model
matrix M.mod_struct_new = zeros(1,M.k) # 0-1 vector containing the structure of the current model
matrix M.mod_struct_old = zeros(1,M.k) # 0-1 vector containing the structure of the current model
# Posterior results
scalar M.consthat_avg = 0
scalar M.constvar_avg = 0
scalar M.post_n_models = 0 # number of considered models
scalar M.post_n_models_accepted = 0 # number of accepted models
scalar M.empty_model_count = 0 # counter for empty model
matrix M.bhat_avg = zeros(M.k,1) # vector containing average values of coefficients (over MCMC)
matrix M.bvar_avg = zeros(M.k,1) # vector containing average values of variances of the coefficients (over MCMC)
matrix M.Numerical_Likelihood = {} # column vector containing numerical probabilities for models
matrix M.Post_Results = {} # matrix with all posterior results
matrix M.mod_sizes = {} # Vector with models size distribution
matrix M.models_probs_percents = {} # CDF-like matrix for accepted models
matrix M.models_probs_cdf = {} # accepted models CDF
matrix M.models_probs_cum = {} # accepted models cumulation
matrix M.mod_rank_prob = zeros(M.Nrank,1) # probability of the models in ranking (analytical)
matrix M.mod_nume_prob = zeros(M.Nrank,1) # probability of the models in ranking (numerical)
matrix M.var_prob = zeros(1,M.k) # vector containing PIPs
matrices M.mod_rank_estimates = array(M.Nrank) # estimates of models in ranking
matrices M.mod_rank_bic = array(M.Nrank) # BICs of models in ranking
matrices M.mod_rank = array(M.Nrank) # structure of models in ranking
if M.limited_y &amp;&amp; M.ordered
  matrix M.cutshat_avg = {}
  matrix M.cutsvar_avg = {}
  matrix M.cuts_avg = {}
  matrices M.mod_rank_cuts_estimates = array(M.Nrank) # cuts estimates for models in ranking
endif
# BIC version
M.bic_type_name = M.BicTypes[M.bic_type]
M.prior_based_bic = nelem(instrings(M.PriorBasedBic, M.bic_type_name)) &gt; 0
if M.bic_type_name == &quot;HBIC&quot; || M.bic_type_name == &quot;IBIC&quot;
  M.bic_correction = log(.5*M.N/$pi)
endif
if M.prior_based_bic
  scalar M.mod_size_sd_prior_bic = NA
  scalar M.avg_model_size_bic = NA
  matrix M.model_prior_bic_log = zeros(M.k+1)
  loop i=0..M.k --quiet
    M.model_prior_bic_log[i+1] = M.hyperparameter * log(bincoeff(M.k,i)) * 0.5 # We divide by 2 bacause we need 0.5*BIC!!!
  endloop
endif
# Model prior
matrix M.model_prior_log = zeros(M.k+1)
string M.prior_name = M.ModelPriorTypes[M.model_prior+1]
if M.prior_name == &quot;Binomial&quot;
  M.a = log(M.avg_model_size/M.k)
  M.b = log(1 - M.avg_model_size/M.k)
  if M.with_const == 1 || M.limited_y &amp;&amp; M.ordered
    tmp = M.avg_model_size/M.k
  else
    tmp = fzero(BACE_exp_trunc_dist(tmp, M.k, M.avg_model_size, M.prior_name))
  endif
  loop i=0..M.k --quiet
    M.model_prior_log[i+1] = tmp^i * (1-tmp)^(M.k-i)
  endloop
elif M.prior_name == &quot;Beta-Binomial&quot;
  M.a = 1
  if M.with_const == 1 || M.limited_y &amp;&amp; M.ordered
    M.b = (M.k - M.avg_model_size)/M.avg_model_size
  else
    loop while M.toler &gt; 0
      catch tmp = fzero(BACE_exp_trunc_dist(tmp, M.k, M.avg_model_size, M.prior_name, M.a), {100, -.00001}, M.toler)
      if $error
        M.toler *= 10
      else
        M.b = tmp
        M.toler = 0
      endif
    endloop
  endif
  loop i=0..M.k --quiet
    M.model_prior_log[i+1] = (gammafun(i+M.a) * gammafun(M.k-i+M.b) / gammafun(M.a+M.k+M.b)) / (gammafun(M.a) * gammafun(M.b) / gammafun(M.a+M.b))
  endloop
else
  M.avg_model_size = NA
  M.model_prior_log += 1
endif
if M.with_const != 1 &amp;&amp; !(M.limited_y &amp;&amp; M.ordered) &amp;&amp; M.model_prior
  M.model_prior_log[2:] /= (1 - M.model_prior_log[1])
endif
M.model_prior_log = log(M.model_prior_log)
# Jointness stuff
if M.do_joint
  matrix M.jointness_m = zeros(M.k, M.k) # square matrix containing counts of coexistence (jointness) of every pair of indenpendent variables
  strings M.jointess_measure_names = defarray(&quot;Doppelhofer-Weeks Measure (DW1)&quot;, &quot;Doppelhofer-Weeks Measure (DW2)&quot;, &quot;Ley-Steel Measure (LS1)&quot;, &quot;Ley-Steel Measure (LS2)&quot;, &quot;Strachan Measure (SM)&quot;, &quot;Yule's Q Measure (YQ)&quot;, &quot;Modified Yule's Q Measure (MYQ)&quot;)
else
  matrix M.jointness_m = {}
endif
# Data transformation
M.data_trans_name = M.DataTransTypes[M.data_trans+1]
# Tobit model
if !(M.low == 0 &amp;&amp; isnan(M.high))
  if !isnan(M.low)
    M.estimator_opts = sprintf(&quot;--llimit=%f &quot;, M.low)
  endif
  if !isnan(M.high)
    M.estimator_opts = sprintf(&quot;%s--rlimit=%f&quot;, M.estimator_opts, M.high)
  endif
  M.Y_censoring = 1
endif
# Verbosity setting
if M.verbosity == 1
  set warnings off
endif
# MC3 progress step
scalar M.progress = floor(M.Nrep/100)
BACE_print_status(null, 1, 11)
</code>
</gretl-function>
<gretl-function name="BACE_show_progress" type="void" private="1">
 <params count="4">
  <param name="iter" type="scalar" const="true"/>
  <param name="percentage" type="scalarref"/>
  <param name="progress" type="scalar" const="true"/>
  <param name="N" type="scalar" const="true"/>
 </params>
<code>/*
Function prints overall progress.
*/
string bar, sign
x = ceil(100 * iter/N)
x4 = int(x/4)
bar = &quot;[&quot;
loop j=1..25 --quiet
  if j &lt;= x4
    sign = &quot;#&quot;
  else
    sign = &quot;.&quot;
  endif
  bar+= sprintf(&quot;%s&quot;, sign)
endloop
bar+= sprintf(&quot;%s&quot;, &quot;]&quot;)
printf &quot;%s %4.1f%%\r&quot;, bar, x
percentage += progress
flush
</code>
</gretl-function>
<gretl-function name="BACE_estimate" type="void" private="1">
 <params count="1">
  <param name="M" type="bundleref"/>
 </params>
<code>/*
This function estimates and forecasts drawn models.
*/
matrix mod_struct_new, mod_struct_new_Y_lags, vcv
list Y_lags
string ESTIMATOR_OPTS
scalar ols_to_mle_correct = 1
# We set up estimator command
string ESTIMATOR = M.estimator
# We re-create Y series
series Y = M.Y
if ESTIMATOR == &quot;intreg&quot;
  series Y2 = M.Y2
endif
# We create list with lagged Y if needed
if M.y_lag &gt; 0
  mod_struct_new_Y_lags = M.mod_struct_new[1:M.y_lag]
  if sum(mod_struct_new_Y_lags) &gt; 0
    Y_lags = lags(selifc(seq(1,M.y_lag), mod_struct_new_Y_lags), Y)
    mod_struct_new = zeros(M.y_lag)' ~ M.mod_struct_new[M.y_lag+1:]
  else
    mod_struct_new = M.mod_struct_new
  endif
else
  mod_struct_new = M.mod_struct_new
endif
# We create the X list on-the-fly
list X = selifc(M.var_numbers2[1,], mod_struct_new)
if nelem(mod_struct_new_Y_lags) &gt; 0
  X = Y_lags X
endif
# Do we need const?
if M.with_const == 1
  X += const
endif
# We estimate current model
if nelem(X) &gt; 0 || M.limited_y &amp;&amp; M.ordered
  # We estimate model
  if M.Y_censoring &amp;&amp; ESTIMATOR == &quot;tobit&quot;
    ESTIMATOR_OPTS = M.estimator_opts
    tobit Y X @ESTIMATOR_OPTS --quiet
  elif ESTIMATOR == &quot;intreg&quot;
    intreg Y Y2 X --quiet
  else
    @ESTIMATOR Y X --quiet
  endif
  if M.with_const == 2 &amp;&amp; $ncoeff &gt; 1 &amp;&amp; $model.parnames[1] == &quot;const&quot;
    M.bhat_tmp = $coeff[2:] | $coeff[1]
    M.bvar_tmp = ($stderr[2:] | $stderr[1]).^2
  else
    M.bhat_tmp = $coeff
    M.bvar_tmp = $stderr.^2
  endif
  # OLS to MLE correction
  if ESTIMATOR == &quot;ols&quot;
    ols_to_mle_correct = $df/$nobs
    M.bvar_tmp *= ols_to_mle_correct
  endif
  if M.Npredict
    fcast --out-of-sample --quiet
    M.Yhat_predict = $fcast
    if !M.limited_y &amp;&amp; !M.censored_y
      M.Yhat_predict_var = ($fcse*ols_to_mle_correct).^2 + $fcast.^2
    else
      M.Yhat_predict_var = ones(M.Npredict)*NA
    endif
  endif
  if M.limited_y
    M.Yhat = {$model.yhat}
  endif
  # We calculate log of marginal density
  if M.bic_type_name == &quot;BIC&quot;
    M.lprob_new = -.5*$bic
  elif M.bic_type_name == &quot;HBIC&quot;
    M.lprob_new = $lnl - .5*$ncoeff*M.bic_correction
  elif M.bic_type_name == &quot;IBIC&quot;
    if ESTIMATOR == &quot;ols&quot;
      vcv = $vcv*ols_to_mle_correct
    else
      vcv = $vcv
    endif
    M.lprob_new = $lnl - .5*$ncoeff*M.bic_correction - 0.5*log(det(invpd(vcv)))
  elif M.bic_type_name == &quot;EBIC&quot;
    M.lprob_new = -.5*$bic - M.model_prior_bic_log[M.k_new+1]
  endif
  # We calculate log of model probability
  M.lprob_new = M.lprob_new + M.model_prior_log[M.k_new+1]
else
  M.bhat_tmp = {}
  M.bvar_tmp = {}
  M.lprob_new = -10^20
endif
</code>
</gretl-function>
<gretl-function name="BACE_collect_results" type="void" private="1">
 <params count="8">
  <param name="M" type="bundleref"/>
  <param name="known_models" type="bundleref"/>
  <param name="models_counter" type="matrixref"/>
  <param name="models_lprob" type="matrixref"/>
  <param name="models_estimates" type="matricesref"/>
  <param name="models_structure" type="matricesref"/>
  <param name="models_forecasts" type="matricesref" optional="true"/>
  <param name="models_yhat" type="matricesref" optional="true"/>
 </params>
<code>/*
Function collects results from MC3 experiment.
*/
BACE_print_status(&quot;Collecting results&quot;, 0)
matrix idx, var_idx, bhat, mod_struct, models_probs
matrices models_structure_rank, models_estimates_rank, cuts_estimates, cuts_estimates_rank
scalar nr, mod_struct_sum
scalar weight = 0
if M.with_const == 1
  matrix bhat_avg = zeros(M.k+1)
  matrix bvar_avg = zeros(M.k+1)
else
  matrix bhat_avg = zeros(M.k)
  matrix bvar_avg = zeros(M.k)
endif
matrix mod_sizes = zeros(M.k)
matrix var_prob = zeros(1,M.k)
if M.do_joint
  matrix jointness_m = zeros(M.k,M.k)
endif
if M.Npredict
  Yhat_avg = zeros(M.Npredict)
  Yhat_var_avg = zeros(M.Npredict)
endif
if M.limited_y
  Yhat = zeros($nobs)
  if M.ordered
    matrix cutshat_avg = zeros(M.cuts)
    matrix cutsvar_avg = zeros(M.cuts)
  endif
endif
# We set the number of visited models
M.post_n_models = nelem(known_models)
if M.with_const == 0 &amp;&amp; !(M.limited_y &amp;&amp; M.ordered)
  M.post_n_models = xmin(M.post_n_models, 2^M.k-1)
endif
known_models = null
# We select objects only for accepted models
idx = selifr(seq(1, M.Nrep+1)', models_counter .&gt; 0)
M.post_n_models_accepted = nelem(idx)
models_counter = models_counter[idx]
models_estimates = models_estimates[idx]
models_structure = models_structure[idx]
if M.Npredict
  models_forecasts = models_forecasts[idx]
endif
if M.limited_y
  models_yhat = models_yhat[idx]
  if M.ordered
    cuts_estimates = array(nelem(models_counter))
    loop i=1..nelem(models_counter) --quiet
      cuts_estimates[i] = models_estimates[i][end-M.cuts+1:end,]
      if rows(models_estimates[i]) &gt; M.cuts
        models_estimates[i] = models_estimates[i][1:end-M.cuts,]
      else
        models_estimates[i] = {}
      endif
    endloop
  endif
endif
# Models size cumulative distribution
models_probs = mreverse(msortby(models_counter ~ idx ~ seq(1, M.post_n_models_accepted)', 1))
M.models_probs_cum = cum(dsort(models_probs[,1]))
# We build analytical and numerical rankings
M.Nrank = xmin(M.Nrank, M.post_n_models_accepted)
models_probs = models_probs[1:M.Nrank,]
M.mod_nume_prob = models_probs[,1]
M.mod_rank_prob = models_lprob[models_probs[,2]]
models_structure_rank = models_structure[models_probs[,3]]
models_estimates_rank = models_estimates[models_probs[,3]]
if M.limited_y &amp;&amp; M.ordered
  cuts_estimates_rank = cuts_estimates[models_probs[,3]]
endif
# We restore estimates for models in ranking
loop i=1..M.Nrank --quiet
  var_idx = {}
  mod_struct = models_structure_rank[i]
  M.mod_rank[i] = mod_struct
  if M.with_const == 1
    var_idx = { 1 } ~ selifc(M.var_numbers2[2,], mod_struct)
  else
    if sum(mod_struct) != 0
      var_idx = selifc(M.var_numbers2[2,], mod_struct) - 1
    endif
  endif
  if nelem(models_estimates_rank[i])
    M.mod_rank_estimates[i] = models_estimates_rank[i][,1] ~ sqrt(models_estimates_rank[i][,2]) ~ transp(var_idx)
    M.mod_rank_bic[i] = -2 * (M.mod_rank_prob[i] - M.model_prior_log[sum(mod_struct)+1])
    if M.limited_y &amp;&amp; M.ordered
      M.mod_rank_cuts_estimates[i] = cuts_estimates_rank[i][,1] ~ sqrt(cuts_estimates_rank[i][,2])
    endif
  endif
endloop
# We average over all accepted models
if M.show_progress
  BACE_print_status(&quot;averaging&quot;, 0, 11, 1)
  scalar M.progress = ceil(nelem(models_counter)/100)
  percentage = M.progress
  flush
endif
loop i=1..nelem(models_counter) --quiet
  weight = models_counter[i]
  mod_struct = models_structure[i]
  mod_struct_sum = sum(mod_struct)
  ## Original BACE
  if M.with_const == 1
    var_idx = { 1 } ~ selifc(M.var_numbers2[2,], mod_struct)
  else
    if mod_struct_sum
      var_idx = selifc(M.var_numbers2[2,], mod_struct) - 1
    else
      var_idx = {}
    endif
  endif
  if nelem(models_estimates[i])
    bhat = models_estimates[i][,1]
    bhat_avg[var_idx] += weight * bhat
    bvar_avg[var_idx] += weight * (models_estimates[i][,2] + bhat .^ 2)
    if M.limited_y &amp;&amp; M.ordered
      bhat = cuts_estimates[i][,1]
      cutshat_avg += weight * bhat
      cutsvar_avg += weight * (cuts_estimates[i][,2] + bhat .^ 2)
    endif
    if mod_struct_sum
      mod_sizes[mod_struct_sum] += weight
    else
      M.empty_model_count = weight
    endif
    var_prob += weight * mod_struct
  endif
  if M.do_joint
    jointness_m = upper(jointness_m .+ weight * ((mod_struct .* mod_struct') .&gt; 0))
  endif
  if M.Npredict
    if nelem(models_forecasts[i]) &gt; 0
      Yhat_avg += weight * models_forecasts[i][,1]
      Yhat_var_avg += weight * models_forecasts[i][,2]
    endif
  endif
  if M.limited_y
    Yhat += weight * models_yhat[i]
  endif
  # Flushing output - showing progress
  if M.show_progress &amp;&amp; i == percentage
    BACE_show_progress(i, &amp;percentage, M.progress, nelem(models_counter))
  endif
endloop
#############################################
# We save collected results in the bundle M #
#############################################
# Coefficients and variances
if M.with_const == 1
  M.bhat_avg = bhat_avg[2:,]
  M.bvar_avg = bvar_avg[2:,]
  M.consthat_avg = bhat_avg[1]
  M.constvar_avg = bvar_avg[1]
else
  M.bhat_avg = bhat_avg
  M.bvar_avg = bvar_avg
endif
if M.limited_y &amp;&amp; M.ordered
  M.cutshat_avg = cutshat_avg
  M.cutsvar_avg = cutsvar_avg
endif
# Probability of variables
M.var_prob = var_prob
# Jointness analysis
if M.do_joint
  M.jointness_m = jointness_m
endif
# Forecasts
if M.Npredict
  M.Yhat_avg = Yhat_avg
  M.Yhat_var_avg = Yhat_var_avg
endif
# Models size distribution
M.mod_sizes = seq(1, M.k)' ~ mod_sizes
if M.with_const == 1 || M.limited_y &amp;&amp; M.ordered
  M.mod_sizes = {0} ~ M.empty_model_count | M.mod_sizes
endif
# Fitted values
if M.limited_y
  M.Yhat = Yhat
endif
if M.show_progress
  printf &quot;\n&quot;
  BACE_print_status(null, 1, 22)
else
  BACE_print_status(null, 1, 3)
endif
</code>
</gretl-function>
<gretl-function name="BACE_jointness_measure" type="matrix" private="1">
 <params count="1">
  <param name="M" type="bundleref"/>
 </params>
<code>/*
Function computes jointness measure based on given jointness matrix.
Local variables:
var_prob - vector with posterior probability of indenpendent variables
a, b, c, d - scalars according to Hofmarcher,Crespo Cuaresma,Grün,Humer,Moser, Bivariate jointness measures in Bayesian Model Averaging: Solving the conundrum, Journal of Macroeconomics, Volume 57, 2018, Pages 150-165, ISSN 0164-0704, DOI: 10.1016/j.jmacro.2018.05.005.
Returns: matrix with computed jointness measure
*/
scalar a,b,c,d,N
matrix var_prob
scalar loghuge = 999 # proxy for infty
if M.with_const == 1
  var_prob = M.Post_Results[2:,1]
else
  var_prob = M.Post_Results[,1]
endif
matrix jointness_measure = zeros(rows(M.jointness_m), cols(M.jointness_m))
loop i=1..M.k --quiet
  loop j=i+1..M.k --quiet
    a = M.jointness_m[i,j] # p(i &amp; j)
    b = var_prob[i] - a	   # p(i &amp; ~j)
    c = var_prob[j] - a	   # p(~i &amp; j)
    d = 1 - b - c - a	   # p(~i &amp; ~j)
    N = a + b + c + d
    if M.do_joint == 4 # Ley-Steel Measure (LS2)
      if a == 1
        jointness_measure[i,j] = loghuge
      elif a == 0
        jointness_measure[i,j] = -loghuge
      else
        jointness_measure[i,j] = log(a/(b + c))
      endif
    elif M.do_joint == 2 # Doppelhofer-Weeks Measure (DW2)
      if b * c == 0
        jointness_measure[i,j] = loghuge
      else
        if a * d == 0
          jointness_measure[i,j] = -loghuge
        else
          if (a*d)/(b*c) &lt;= 0
            jointness_measure[i,j] = -loghuge
          else
            jointness_measure[i,j] = log((a*d)/(b*c))
          endif
        endif
      endif
    elif M.do_joint == 3 # Ley-Steel Measure (LS1)
      jointness_measure[i,j] = log(a/(a + b + c))
    elif M.do_joint == 1 # Doppelhofer-Weeks Measure (DW1)
      if a == 0 &amp;&amp; (a + b)*(a + c) != 0
        jointness_measure[i,j] = 0
      elif a == 0 &amp;&amp; (a + b)*(a + c) &gt;= 0
        jointness_measure[i,j] = loghuge
      elif a == 0 &amp;&amp; (a + b)*(a + c) &lt; 0
        jointness_measure[i,j] = -loghuge
      else
        jointness_measure[i,j] = log(a*N/((a + b)*(a + c)))
      endif
    elif M.do_joint == 5 # Strachan Measure
      jointness_measure[i,j] = (a+b)/N * (a+c)/N * log(a*N/(b*c))
    elif M.do_joint == 6 # Yule's Q (YQ)
      jointness_measure[i,j] = (a*d - b*c) / (a*d + b*c)
    elif M.do_joint == 7 # Modified Yule's Q (MYQ)
      jointness_measure[i,j] = ((a+0.5)*(d+0.5)-(b+0.5)*(c+0.5)) / ((a+0.5)*(d+0.5)+(b+0.5)*(c+0.5)-0.5)
    endif
  endloop
endloop
jointness_measure = jointness_measure + upper(jointness_measure)'
jointness_measure[diag] = NA
cnameset(jointness_measure, cnameget(M.jointness_m))
rnameset(jointness_measure, rnameget(M.jointness_m))
return jointness_measure
</code>
</gretl-function>
<gretl-function name="BACE_main" type="void" private="1">
 <params count="1">
  <param name="M" type="bundleref"/>
 </params>
<code>/*
This is main BACE function with complete MC3 simulation procedure.
*/
# Local variables
BACE_print_status(&quot;MC3 setup&quot;)
scalar percentage = 0 #M.progress # percentage of progress of MC3
scalar rep = 1
string model_id # string containing model id (0-1 'image')
scalar model_nr	# iteration number under which model's data are stored in matrices/arrays
scalar model_nr_old
bundle known_models
matrix models_counter = zeros(M.Nrep+1) # this is because starting model has labeled as 1
matrix models_lprob = zeros(M.Nrep+1)
matrices models_estimates = array(M.Nrep+1)
matrices models_structure = array(M.Nrep+1)
matrix mod_struct_draw
if M.Npredict &gt; 0
  matrices models_forecasts = array(M.Nrep+1)
else
  matrices models_forecasts = null
endif
if M.limited_y
  matrices models_yhat = array(M.Nrep+1)
else
  matrices models_yhat = null
endif
# Sample setting for prediction
if M.Npredict &gt; 0
  smpl M.first_obs M.last_obs
endif
set loop_maxiter M.loop_maxiter
##########################
# Part 1: Starting model #
##########################
# We estimate starting model and construct starting mod_rank_struct and mod_rank
BACE_initial_model(&amp;M)
BACE_estimate(&amp;M)
M.lprob_old = M.lprob_new
M.mod_struct_old = M.mod_struct_new
model_id = sprintf(&quot;%d&quot;, M.mod_struct_old)[1:end-1] # we trim the &quot;\n&quot; at the end !!!
model_nr = M.Nrep+1
model_nr_old = model_nr
known_models[model_id] = model_nr
models_structure[model_nr] = M.mod_struct_new
models_lprob[model_nr] = M.lprob_new
models_estimates[model_nr] = M.bhat_tmp ~ M.bvar_tmp
if M.Npredict &amp;&amp; M.k_new
  models_forecasts[model_nr] = M.Yhat_predict ~ M.Yhat_predict_var
endif
if M.limited_y
  models_yhat[model_nr] = M.Yhat
endif
BACE_print_status(null, 1, 12)
############################################################
# Part 2: Markov Chain Monte Carlo Model Composition - MC3 #
############################################################
if M.show_progress
  BACE_print_status(&quot;MC3 overall progress&quot;, 0, 0, 1)
  BACE_show_progress(0, &amp;percentage, M.progress, M.Nrep)
else
  BACE_print_status(&quot;MC3&quot;)
endif
loop while rep &lt;= M.Nrep --quiet
  # Now we draw the number of candidate variable
  potential_var = randint(0, M.k)
  # Now we modify the list of variables (remove an existing variable or add a new variable)
  if potential_var &gt; 0
    mod_struct_draw = M.mod_struct_old
    mod_struct_draw[potential_var] = !mod_struct_draw[potential_var]
    M.k_new = sum(mod_struct_draw)
    if M.with_const != 1 &amp;&amp; !M.k_new &amp;&amp; !(M.limited_y &amp;&amp; M.ordered)
      M.n_drop_draws += 1
      continue
    endif
    M.mod_struct_new = mod_struct_draw
    model_id = sprintf(&quot;%d&quot;, mod_struct_draw)[1:end-1]
    if inbundle(known_models, model_id)
      model_nr = known_models[model_id]
      M.lprob_new = models_lprob[model_nr]
    else
      # We estimate newly drawn model
      BACE_estimate(&amp;M)
      model_nr = rep
      known_models[model_id] = model_nr
      models_structure[model_nr] = M.mod_struct_new
      models_lprob[model_nr] = M.lprob_new
      models_estimates[model_nr] = M.bhat_tmp ~ M.bvar_tmp
      if M.Npredict &amp;&amp; M.k_new
        models_forecasts[model_nr] = M.Yhat_predict ~ M.Yhat_predict_var
      endif
      if M.limited_y
        models_yhat[model_nr] = M.Yhat
      endif
    endif
    # Now we decide if to accept the new model
    if M.lprob_new-M.lprob_old &gt; log(randgen1(u,0,1))
      M.lprob_old = M.lprob_new
      M.mod_struct_old = M.mod_struct_new
      model_nr_old = model_nr
    endif
  endif
  # Now we count models
  if rep &gt; M.Nburn
    models_counter[model_nr_old] += 1
  endif
  # Flushing output - showing progress
  if M.show_progress &amp;&amp; rep == percentage
    BACE_show_progress(rep, &amp;percentage, M.progress, M.Nrep)
  endif
  # We increase iterator
  rep++
endloop
if !M.show_progress
  BACE_print_status(null, 1, 18)
endif
# Now we collect results (averaging and rankings)
BACE_collect_results(&amp;M, &amp;known_models, &amp;models_counter, &amp;models_lprob, &amp;models_estimates, &amp;models_structure, &amp;models_forecasts, &amp;models_yhat)
</code>
</gretl-function>
<gretl-function name="BACE_bcheck" type="string" private="1">
 <params count="3">
  <param name="UserOpts" type="bundle"/>
  <param name="M" type="bundleref"/>
  <param name="k" type="scalar"/>
 </params>
<code>/*
This function checks options bundle and returns error message in
any problem found.
Parameters:
UserOpts - bundle with user-defined options for BACE
k - number of independent variables
*/
string err = &quot;&quot;
string separator = &quot;, &quot;
scalar avg_model_size_tmp = 0
scalar err2, arg_val, do_plot_tmp, do_show_progress, alpha_tmp
bundle Options, Overloadable
string arg_name, parameter_value
strings Integers = defarray(&quot;y_lag&quot;, &quot;with_const&quot;, &quot;model_prior&quot;, &quot;Nrank&quot;, &quot;do_joint&quot;, &quot;Npredict&quot;, &quot;Nrep&quot;, &quot;burn&quot;, &quot;verbosity&quot;, &quot;data_trans&quot;, &quot;bic_type&quot;)
strings Booleans = defarray(&quot;show_progress&quot;, &quot;do_plot&quot;)
strings Scalars = defarray(&quot;avg_model_size&quot;, &quot;alpha&quot;, &quot;binary_threshold&quot;)
strings ModelTypes = defarray(&quot;linear&quot;, &quot;logit&quot;, &quot;probit&quot;, &quot;poisson&quot;, &quot;tobit&quot;, &quot;intreg&quot;)
strings BicTypes = defarray(&quot;BIC&quot;, &quot;HBIC&quot;, &quot;IBIC&quot;, &quot;EBIC&quot;)
strings ModelPriorTypes = defarray(&quot;none&quot;, &quot;Binomial&quot;, &quot;Beta-Binomial&quot;)
strings ConstTypes = defarray(&quot;Never&quot;, &quot;Always&quot;, &quot;Can be dropped&quot;)
strings DataTransTypes = defarray(&quot;none&quot;, &quot;centering&quot;, &quot;standarizing&quot;)
strings OverloadableKeys
if $sysinfo.gui_mode
  do_plot_tmp = 1
  do_show_progress = 1
else
  do_plot_tmp = 0
  do_show_progress = 0
endif
Overloadable[&quot;bic_type&quot;] = _(bic=1, hbic=2, ibic=3, ebic=4, valid=tolower(flatten(BicTypes, separator)))
Overloadable[&quot;model_prior&quot;] = _(none=0, binomial=1, betabinomial=2, valid=tolower(flatten(ModelPriorTypes, separator)))
Overloadable[&quot;with_const&quot;] = _(never=0, always=1, canbedropped=2, valid=tolower(flatten(ConstTypes, separator)))
Overloadable[&quot;do_joint&quot;] = _(none=0, dw1=1, dw2=2, ls1=3, ls2=4, sm=5, yq=6, myq=7, valid=&quot;none, DW1, DW2, LS1, LS2, SM, YQ, MYQ&quot;)
Overloadable[&quot;data_trans&quot;] = _(none=0, centering=1, standarizing=2, valid=tolower(flatten(DataTransTypes, separator)))
Overloadable[&quot;model_type&quot;] = _(linear=1, logit=2, probit=3, poisson=4, tobit=5, intreg=6, valid=tolower(flatten(ModelTypes, separator)))
# We look for overloaded parameters and convert them into integers
OverloadableKeys = getkeys(Overloadable)
loop i=1..nelem(OverloadableKeys) --quiet
  arg_name = OverloadableKeys[i]
  if inbundle(UserOpts, arg_name)
    if typeof(UserOpts[arg_name]) == 4 &amp;&amp; arg_name != &quot;model_type&quot;
      parameter_value = strsub(tolower(UserOpts[arg_name]), &quot; &quot;, &quot;&quot;)
      if arg_name == &quot;model_prior&quot;
        parameter_value = strsub(parameter_value, &quot;-&quot;, &quot;&quot;)
      endif
      if inbundle(Overloadable[arg_name], parameter_value)
        UserOpts[arg_name] = Overloadable[arg_name][parameter_value]
      else
        err = sprintf(&quot;Unknown '%s' value for parameter %s.\n&quot;, UserOpts[arg_name], arg_name)
        err += sprintf(&quot; Valid options are: %s&quot;, Overloadable[arg_name].valid)
        return err
      endif
    elif typeof(UserOpts[arg_name]) == 1 &amp;&amp; arg_name == &quot;model_type&quot;
      if UserOpts[arg_name] &lt;= nelem(ModelTypes)
        UserOpts[arg_name] = ModelTypes[UserOpts[arg_name]]
      else
        err = sprintf(&quot;Model type value (model_type=%d) is out of bounds (must be &lt;= %d)&quot;, UserOpts[arg_name], nelem(ModelTypes))
        return err
      endif
    endif
  endif
endloop
# We set the default Nrep conditional on k
if k &lt;= 15
  Nrep = 10000
elif k &lt;= 19
  Nrep = 100000
else
  Nrep = 1e+06
endif
# We set temporal y_lag value
if !inbundle(UserOpts, &quot;y_lag&quot;) || typeof(UserOpts[&quot;y_lag&quot;]) != 1
  y_lag_tmp = 0
else
  y_lag_tmp = UserOpts[&quot;y_lag&quot;]
endif
# We set temporal with_const value and calculate prior average model size
if !inbundle(UserOpts, &quot;with_const&quot;)
  with_const_tmp = 1
  avg_model_size_tmp = (k + y_lag_tmp) / 2
else
  with_const_tmp = UserOpts[&quot;with_const&quot;]
  avg_model_size_tmp = (k + y_lag_tmp + (with_const_tmp == 2)) / 2
endif
# We set default alpha
if inbundle(UserOpts, &quot;model_type&quot;) &amp;&amp; UserOpts[&quot;model_type&quot;] == &quot;intreg&quot;
  alpha_tmp = 1.0
else
  alpha_tmp = 0.6
endif
# Template bundle with default values
string Options[&quot;model_type&quot;] = &quot;linear&quot;
scalar Options[&quot;bic_type&quot;] = 2
scalar Options[&quot;model_prior&quot;] = 2
scalar Options[&quot;with_const&quot;] = 1
scalar Options[&quot;avg_model_size&quot;] = avg_model_size_tmp
scalar Options[&quot;data_trans&quot;] = 0
scalar Options[&quot;do_joint&quot;] = 0
scalar Options[&quot;alpha&quot;] = alpha_tmp
scalar Options[&quot;Nrank&quot;] = xmin(2^(k+y_lag_tmp-1), 40)
scalar Options[&quot;Npredict&quot;] = 0
scalar Options[&quot;y_lag&quot;] = 0
scalar Options[&quot;hyperparameter&quot;] = 0.5 # gamma for EBIC
scalar Options[&quot;binary_threshold&quot;] = 0.5
scalar Options[&quot;low&quot;] = 0
scalar Options[&quot;high&quot;] = NA
scalar Options[&quot;Nrep&quot;] = Nrep
scalar Options[&quot;burn&quot;] = 10
scalar Options[&quot;verbosity&quot;] = 2
scalar Options[&quot;show_progress&quot;] = do_show_progress
scalar Options[&quot;do_plot&quot;] = do_plot_tmp
scalar Options[&quot;_gui&quot;] = 0
# General checking, but still needs some manual work later
err2 = bcheck(&amp;Options, UserOpts)
if err2
  err = sprintf(&quot;Valid options are:\n&quot;)
  loop i=1..nelem(getkeys(Options)) --quiet
    err += sprintf(&quot;\t%s\n&quot;, getkeys(Options)[i])
  endloop
  err += sprintf(&quot; Look at the PDF documentation for expected types of arguments.&quot;)
endif
# We check integers
loop i=1..nelem(Integers) --quiet
  arg_name = Integers[i]
  arg_val = Options[arg_name]
  if arg_val != int(arg_val)
    err += sprintf(&quot;Argument %s must be an integer&quot;, arg_name)
  endif
endloop
# We check booleans
loop i=1..nelem(Booleans) --quiet
  arg_name = Booleans[i]
  arg_val = Options[arg_name]
  if arg_val != int(arg_val) || arg_val &lt; 0 || arg_val &gt; 1
    err += sprintf(&quot;Argument %s must be a bool&quot;, arg_name)
  endif
endloop
# We check model type
if inbundle(UserOpts, &quot;model_type&quot;) &amp;&amp; strlen(UserOpts[&quot;model_type&quot;]) &amp;&amp; !nelem(instrings(ModelTypes, UserOpts[&quot;model_type&quot;]))
  err += sprintf(&quot;Unknown model type: '%s'&quot;, UserOpts[&quot;model_type&quot;])
endif
# We check arguments for valid values
if Options.y_lag &lt; 0
  err += &quot;Y lags (y_lag) takes the integer values&quot;
elif Options.with_const &lt; 0 || Options.with_const &gt; 2
  err += &quot;Constant in model takes the integer values in the range [0; 2]&quot;
elif Options.model_prior &lt; 0 || Options.model_prior &gt; 2
  err += &quot;Model prior takes the integer values in the range [0; 2]&quot;
elif Options.alpha &lt; 0 || Options.alpha &gt; 1
  err += &quot;The significance level (alpha) takes the real values in the range [0; 1]&quot;
elif Options.do_joint &lt; 0 || Options.do_joint &gt; 7
  err += &quot;Jointess type (do_joint) takes the integer values in the range [1; 7]&quot;
elif Options.Npredict &lt; 0
  err += &quot;Number of out-of-sample forecasts (Npredict) takes the integer values&quot;
elif Options.Npredict &gt;= round($nobs/2)
  printf(&quot;Number of out-of-sample forecasts is more than 50%s of sample length.\n&quot;, &quot;%&quot;)
elif Options.Nrep &lt; 0
  err += &quot;Total number of replications (Nrep) takes the integer values&quot;
elif Options.burn &lt; 0 || Options.burn &gt; 99
  err += &quot;Percentage of burn-in draws (do_burn) takes the integer values in the range [0; 99]&quot;
elif Options.verbosity &lt; 1 || Options.verbosity &gt; 2
  err += &quot;Verbosity takes the integer values in the range [1; 2]&quot;
elif Options.data_trans &lt; 0 || Options.data_trans &gt; 2
  err += &quot;Parameter data_trans takes the integer values in the range [0; 2]&quot;
elif Options.bic_type &lt; 1 || Options.bic_type &gt; 4
  err += &quot;BIC type takes the integer values in the range [1; 4]&quot;
elif Options.hyperparameter &lt; 0 || Options.hyperparameter &gt; 1
  err += &quot;Hyperparameter for EBIC (gamma) takes the real values in the range [0; 1]&quot;
elif Options.binary_threshold &lt;= 0 || Options.binary_threshold &gt;= 1
  err += &quot;Threshold for binary dependent models (binary_threshold) takes the real values in the range (0; 1)&quot;
endif
# We save options in M
M = Options
M.ModelTypes = ModelTypes
M.BicTypes = BicTypes
M.ModelPriorTypes = ModelPriorTypes
M.ConstTypes = ConstTypes
M.DataTransTypes = DataTransTypes
strings M.DiscreteModelTypes = M.ModelTypes[2:3] # Note: the first two for binary dependent variable only!
strings M.CensoredModelTypes = M.ModelTypes[5:6]
scalar M.limited_y = nelem(instrings(M.DiscreteModelTypes, M.model_type)) &gt; 0 ? 1 : 0
scalar M.censored_y = nelem(instrings(M.CensoredModelTypes, M.model_type)) &gt; 0 ? 1 : 0
return err
</code>
</gretl-function>
<gretl-function name="BACE_heatmap" type="void" private="1">
 <params count="3">
  <param name="M" type="bundle"/>
  <param name="MODE" type="string"/>
  <param name="basename" type="string" optional="true" const="true"/>
 </params>
<code>/*
M - BACE result bundle, MODE - string indicating image mode {&quot;inclusions&quot;, &quot;jointness&quot;}
basename	- basename for gnuplot files
*/
scalar nrows, ncols, tmp, height, width, minval, maxval
string grid, title, xlabel, ylabel, xtics, ytics, colorbox, palette, rotate, output
matrix m
strings all_names_sp_m
# If we have model with const we ommit the first element
if M.with_const == 1
  all_names_sp_m = M.all_names_sp_m[2:end]
else
  all_names_sp_m = M.all_names_sp_m
endif
# We set general image options
if MODE == &quot;inclusions&quot;
  title = sprintf(&quot;Variables Inclusions Based on Best %d Models&quot;, M.Nrank)
  xlabel = &quot;Model number&quot;
  ylabel = &quot;Variable&quot;
  colorbox = &quot;unset colorbox&quot;
  height = xmax(int(M.k/41*768), 480)
  width = xmin(xmax(int(M.Nrank/20*1024), 640), 1024)
  m = zeros(M.Nrank, M.k)
  loop i=1..M.Nrank --quiet
    m[i,] = M.mod_rank[i]
  endloop
  m = mreverse(m')
  palette = &quot;0 'white', 1 'red'&quot;
  output = &quot;-PIP.plt&quot;
else
  title = sprintf(&quot;Jointness Based on %s&quot;, M.jointess_measure_names[M.do_joint])
  xlabel = &quot;Variable&quot;
  ylabel = xlabel
  height = xmin(xmax(int(M.k/41*1024), 640), 900)
  width = xmin(xmax(int(M.k/41*1024), 900), 1024)
  m = BACE_jointness_measure(&amp;M)
  m[diag] = 0
  minval = minc(minr(m))
  maxval = maxc(maxr(m))
  m[diag] = NA
  m = mreverse(m)
  if minval == 0
    palette = sprintf(&quot;0 'white', %s 'red'&quot;, strsub(sprintf(&quot;%f&quot;, maxval), &quot;,&quot;, &quot;.&quot;))
  else
    palette = sprintf(&quot;%s 'blue', 0 'white', %s 'red'&quot;, strsub(sprintf(&quot;%f&quot;, minval), &quot;,&quot;, &quot;.&quot;), strsub(sprintf(&quot;%f&quot;, maxval), &quot;,&quot;, &quot;.&quot;))
  endif
  rotate = &quot;set xtics rotate by 45 right&quot;
  output = &quot;-Jointness.plt&quot;
endif
nrows = rows(m)
ncols = cols(m)
# We set tics
ytics = &quot;(&quot;
loop i=1..M.k --quiet
  ytics += sprintf(&quot;\&quot;%s\&quot; %d&quot;, all_names_sp_m[i], M.k-i)
  if i == M.k
    ytics += sprintf(&quot;)&quot;)
  else
    ytics += sprintf(&quot;, &quot;)
  endif
endloop
xtics = &quot;(&quot;
if MODE == &quot;inclusions&quot;
  loop i=1..M.Nrank --quiet
    xtics += sprintf(&quot;\&quot;%.d\&quot; %d&quot;, i, i-1)
    if i == M.Nrank
      xtics += sprintf(&quot;)&quot;)
    else
      xtics += sprintf(&quot;, &quot;)
    endif
  endloop
else
  loop i=1..M.k --quiet
    xtics += sprintf(&quot;\&quot;%s\&quot; %d&quot;, all_names_sp_m[i], i-1)
    if i == M.k
      xtics += sprintf(&quot;)&quot;)
    else
      xtics += sprintf(&quot;, &quot;)
    endif
  endloop
endif
# We need to cast given matrix to its string representation
loop i=1..nrows --quiet
  loop j=1..ncols --quiet
    if MODE == &quot;inclusions&quot;
      grid += sprintf(&quot;%d&quot;, m[i,j])
    else
      grid += strsub(sprintf(&quot;%.4f&quot;, m[i,j]), &quot;,&quot;, &quot;.&quot;)
    endif
    if j == ncols
      if i != nrows
        grid += sprintf(&quot;\n&quot;)
      endif
    else
      grid += sprintf(&quot;\t&quot;)
    endif
  endloop
endloop
# We check if we display or save plot
if $sysinfo.gui_mode
  output = &quot;display&quot;
else
  output = sprintf(&quot;%s%s&quot;, basename, output)
endif
# We plot heatmap
plot
  printf &quot;set term pngcairo font \&quot;Vera,9\&quot; size %d,%d noenhanced&quot;, width, height
  literal set encoding utf8
  literal set decimalsign '.'
  literal set nokey
  literal set datafile missing &quot;&quot;
  literal set x2tics 1 format '' scale 0,0.001
  literal set y2tics 1 format '' scale 0,0.001
  literal set mx2tics 2
  literal set my2tics 2
  printf &quot;set palette defined (%s)&quot;, palette
  printf &quot;set title \&quot;%s\&quot;&quot;, title
  printf &quot;set xlabel \&quot;%s\&quot;&quot;, xlabel
  printf &quot;set ylabel \&quot;%s\&quot;&quot;, ylabel
  printf &quot;set xtics %s&quot;, xtics
  printf &quot;set ytics %s&quot;, ytics
  printf &quot;%s&quot;, colorbox
  printf &quot;%s&quot;, rotate
  literal set autoscale fix
  literal set link x
  literal set link y
  literal set grid front mx2tics my2tics lw 2 lt -1 lc rgb 'white'
  printf &quot;$map &lt;&lt; EOD&quot;
  printf &quot;%s&quot;, grid
  printf &quot;EOD&quot;
  literal plot $map matrix with image
end plot --output=@output
</code>
</gretl-function>
<gretl-function name="BACE_print_status" type="void" private="1">
 <params count="4">
  <param name="message" type="string" optional="true" const="true"/>
  <param name="done" type="bool" default="0" const="true"/>
  <param name="pspaces" type="scalar" default="0" const="true"/>
  <param name="spacesp" type="scalar" default="0" const="true"/>
 </params>
<code>/*
Function prints current execution status and flushes screen.
message - text to be printed
done	- if this is end of stage
pspaces	- number of prior paces
spacesp	- number of post spaces
*/
string pSPACE = &quot;&quot;
string SPACEp = &quot;&quot;
if pspaces
  loop i=1..pspaces --quiet
    pSPACE += sprintf(&quot;%s&quot;, &quot; &quot;)
  endloop
endif
if spacesp
  loop i=1..spacesp --quiet
    SPACEp += sprintf(&quot;%s&quot;, &quot; &quot;)
  endloop
endif
if done
  printf &quot;%sdone!&quot;, pSPACE
else
  printf &quot;\n%s%s:%s&quot;, pSPACE, message, SPACEp
endif
flush
</code>
</gretl-function>
<gretl-function name="BACE_exp_trunc_dist" type="scalar" private="1">
 <params count="5">
  <param name="x" type="scalar"/>
  <param name="n" type="scalar" const="true"/>
  <param name="avg" type="scalar" const="true"/>
  <param name="dist" type="string" const="true"/>
  <param name="a" type="scalar" default="0" const="true"/>
 </params>
<code>/*
Function for finding a x to have truncated distribution
with desired expected value which equals 'avg'.
Note: it is prepared for use with fzero()!!!
Parameters:
n - number of variables
dist - name of distribution
a - parameter for Beta-Binomial
Internal variables:
P0 - probability at i=0 in non-truncated distribution
Exp - calculated expexted value
*/
scalar P0 = 0
scalar Exp = 0
if dist == &quot;Binomial&quot;
  P0 = (1-x)^n
  Exp = n*x
elif dist == &quot;Beta-Binomial&quot;
  P0 = bincoeff(n,0)*(gammafun(0+a)*gammafun(n-0+x)/gammafun(a+n+x))/(gammafun(a)*gammafun(x)/gammafun(a+x))
  Exp = n*a/(a+x)
endif
return Exp/(1-P0) - avg
</code>
</gretl-function>
<sample-script filename="examples/BACE_sample.inp">
set verbose off

# Usage:
open wtp.gdt
include BACE.gfn
list X = 1 2 9 10 11

# We set the seed in order to exact reproduction of results
set seed 1000000

BACE(depvar, X)
/*
The above example consists of three blocks.
The first block is just opening of the so called \cmd{wtp}
which contains 312 observations with survey results concerning
willingness to pay for the preservation of the Alentejo Natural
Park in Portugal. The survey was held in 1997. The original amounts
in escudos were transformed into euros by dividing by 200.
We also set the seed in order to exact reproduction of the results.

The second block is the definition of the X list which consists of
five independent variables available in the wtd dataset.

The third block contains the definition for Bayesian Averaging of
Classical Estimates analysis in default setup: linear model, no lags
for Y variable (not applicable since we have cross-sectional data),
constant always included, beta-binomial model prior, prior average model
size set to 2.5, significance level for the initial model set to 0.6,
standard BIC, no data transformation, 14 top ranked models, no jointness
analysis, no out-of-sample predictions, 1000 replications with 10% burn-in
draws, full output (verbosity set to 2), printing overall progress and
plotting graphs.
*/
####################################################################################

/*
Since 'depvar' is a count date, suppose we want to run ordered logit
analysis. What's more, we want to use uniform model prior and perform
jointness analysis using modified Yule's Q Measure (MYQ). W'd like to
switch of ploting grahs. Finally, we also want to save results of the
BACE analysis in the bundle \cmd{results\_b}, the code should be as follows:
*/
results_b = BACE(depvar, X, _(model_type=&quot;logit&quot;, model_prior=&quot;binomial&quot;,\
 do_joint=&quot;MYQ&quot;, do_plot=0))

/*
Suppose we want to calculate Doppelhofer-Weeks Measure instead of
already computed Ley-Steel Measure. Since the type of jointness measure
is controlled by do_join field in the result bundle, the only thing
we have to do is to set the value of do_join to 2 and print BACE
results again. The code should be as follows:
*/
results_b.do_joint = 1
BACE_Print(&amp;results_b)
</sample-script>
</gretl-function-package>
</gretl-functions>

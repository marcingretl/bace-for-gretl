function scalar BACE_exp_trunc_dist (scalar x, const scalar n, const scalar avg,
                                   const string dist, const scalar a[0])
    /*
       Function for finding a x to have truncated distribution
       with desired expected value which equals 'avg'.
       Note: it is prepared for use with fzero()!!!
       Parameters:
       n - number of variables
       dist - name of distribution
       a - parameter for Beta-Binomial
       Internal variables:
       P0 - probability at i=0 in non-truncated distribution
       Exp - calculated expexted value
    */
    scalar P0 = 0
    scalar Exp = 0

    if dist == "Binomial"
        P0 = (1-x)^n
        Exp = n*x
    elif dist == "Beta-Binomial"
        P0 = bincoeff(n,0)*(gammafun(0+a)*gammafun(n-0+x)/gammafun(a+n+x))/(gammafun(a)*gammafun(x)/gammafun(a+x))
        Exp = n*a/(a+x)
    endif

    return Exp/(1-P0) - avg
end function
/*
   Old fully "manual" version for Beta-Binomial based on Beta function
   loop i=1..n --quiet
   Exp += bincoeff(n,i)*Beta(i+a,n-i+x)/Beta(a,x) * i / (1-Beta(0+a,n-0+x)/Beta(a,x))
   endloop
*/

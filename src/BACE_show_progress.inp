function void BACE_show_progress (const scalar iter,
                                  scalar *percentage,
                                  const scalar progress,
                                  const scalar N)
    /*
       Function prints overall progress.
    */
    string bar, sign

    x = ceil(100*iter/N)
    x4 = int(x/4)
    bar = "["
    loop j=1..25
        if j <= x4
            bar ~= "#"
        else
            bar ~= "."
        endif
    endloop
    printf "%s] %4.1f%%\r", bar, x
    percentage += progress
    flush
end function

function string BACE_parse (bundle *M,
                            series Y,
                            string Y_name,
                            list X_list)
    /*
       Function parses given parameters end checks several conditions:
       M				- pointer to the bundle
       Y				- dependent variable
       Y_name			- name of dependent variable
       X_list			- list of given independent variables
       #
       Returns: string err holding the first error found in given dataset or parameters
    */
    # Local variables
    scalar k = nelem(X_list) + M.Y_AR_p + (M.with_const > 1)
    matrix Y_uniq = uniq(Y)
    string err = ""    
    string tmp_str

    # We check if given X_list does not include Y
    if inlist(X_list, Y_name) != 0
        X_list -= X_list[inlist(X_list, Y_name)]
        k -= 1
        print "Dependent variable was removed from the X list."
    endif

    # We check if given X_list does not include lagged Y
    if M.Y_AR_p > 0
        loop i=1..M.Y_AR_p --quiet
            tmp_str = Y_name ~ "_" ~ "$i"
            if inlist(X_list, tmp_str) != 0
                X_list -= X_list[inlist(X_list, tmp_str)]
                k -= 1
                printf "Lag %d of dependent viariable (%s) was removed from the X list.\n", i, tmp_str
            endif
        endloop
    endif

    # We check if given X_list does not include const
    if inlist(X_list, const) != 0
        X_list -= const
        k -= 1
        print "Const was removed from the X list."
    endif

    # We check if given variables are not co-linear
    if nelem(X_list) > 0
        if M.Y_AR_p > 0
            ols Y Y(-1 to -M.Y_AR_p) X_list const --quiet
        else
            ols Y X_list const --quiet
        endif
        if $ncoeff < k + 1
            X_list = $xlist - const
            if M.Y_AR_p > 0
                loop i=1..M.Y_AR_p --quiet
                    X_list = X_list - Y_$i
                endloop
            endif
            print "Some of the independent variables were colinear and were dropped."
        endif
    endif

    # We check if average model size is within 0 and K
    if M.avg_model_size <= 0 || M.avg_model_size >= k
        err = "Average model size should be greater than 0 and lower than K"
        return err
    endif

    # We check if aplha then 0 in we don't have const (we can't have empty model)
    if M.alpha == 0 && M.with_const == 0
        err = "We cannot have empty initial model (alpha = 0) when we don't have constant"
        return err
    endif

    # We check if number of models in ranking is not greater than 2^K (model space)
    if M.Nrank > 2^(k+M.Y_AR_p)
        err = "Number of the top ranked models cannot be greater than 2^K (space of parameters)"
        return err
    endif

    # We check if we have Y_AR_p only in case of linear model for time-series
    if M.Y_AR_p > 0 && (M.model_type != "linear" || $datatype != 2)
        string datatype
        if $datatype == 1
            datatype = "cross-sectional (undated) data"
        elif $datatype == 2
            datatype = "time-series data"
        elif $datatype == 3
            datatype = "panel data"
        endif        
        err = sprintf("You try to estimate %s model for %s => you cannot have lagged %s", M.model_type, datatype, Y_name)
    endif
    
    # We check if Y variable "is discrete" or "count data" in case of non-OLS model
    if M.limited_y && sum(Y_uniq - int(Y_uniq)) > 0
        err = sprintf("The dependent variable is not discrete")
    elif M.model_type == "poisson" && (sum(Y_uniq - int(Y_uniq)) > 0 || max(Y) <= 1)
        err = sprintf("The dependent variable must be count data")
    endif

    series M.Y = Y
    string M.Y_name = Y_name
    matrix M.X_list = X_list

    return err
end function

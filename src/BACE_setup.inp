   but WITHOUT ANY WARRANTY; without even the implied warranty of
   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
   GNU General Public License for more details.

   You should have received a copy of the GNU General Public License
   along with this program. If not, see <http://www.gnu.org/licenses/>.
*/
function void BACE_setup (bundle *M, int Norig)
/*
   This function creates BUNDLE holding all BACE information
    */
    printf "\n#############################################################################\n"
    printf "To do:"
    printf "\n * Change old names of parameters to new ones (see bottom of BACE_bcheck())."
    printf "\n * Change type of M.predict_obs_names: should be an array of strings."
    printf "\n * Add PDF data_trans and bic_type."
    printf "\n * Add PDF information on dependecies."
    printf "\n * Work on speed."
    printf "\n#############################################################################\n"

    BACE_print_status("BACE setup")

    scalar tmp
    string tmp_str = ""
    list X_list = M.X_list
    series Y = M.Y

    ###############################################
    # Global variables (given by user of default) #
    ###############################################
    if ok(Norig)
        scalar M.Norig = Norig
    endif

    ###############################################
    # Local variables - presettings				  #
    ###############################################
    strings M.DiscreteModelTypes = defarray("logit", "probit") # Note: the first two for 0-1 dependent variable!
    if M.model_type == "linear"
        string M.estimator = "ols"
    else
        string M.estimator = M.model_type
    endif
    if nelem(instrings(M.DiscreteModelTypes, M.model_type))
        scalar M.limited_y = 1
        scalar M.ordered = 0
        scalar M.cuts = 0
        scalar M.correctly_predicted = NA
        matrix M.Yhat = {}
        matrix M.contingency = {}
        strings M.cuts_names = null
        # we check if we have ordered version
        tmp_str = M.estimator
        @tmp_str Y X_list --quiet
        if inbundle($model, "ordered")
            M.ordered = 1
            M.cuts = $model["ncoeff"] - $model["nx"]
            M.cuts_names = $model["parnames"][end-M.cuts+1:end]
            M.yvalues = values(Y)
            M.with_const = 0
        endif
    else
        scalar M.limited_y = 0
    endif
    if M.with_const == 1
        string M.const_type = "Always"
    elif M.with_const == 2
        string M.const_type = "Can be dropped"
        X_list = X_list const
    else
        if M.limited_y && M.ordered
            string M.const_type = "Never (with cut points)"
        else
            string M.const_type = "Never"
        endif
    endif
    if M.Y_AR_p > 0
        X_list = lags(M.Y_AR_p, Y) X_list
    endif
    M.X_list = X_list

    ###############################################
    # Local variables							  #
    ###############################################
    bundle M.StartModel_b = null
    scalar M.Nburn = round(M.burn/100*M.Nrep) # number of burn-in draws
    scalar M.k = nelem(X_list) # total number of indenpendent variables
    scalar M.model_space = 2^M.k
    if M.with_const != 1 && !(M.limited_y && M.ordered)
        M.model_space -= 1
    endif
    if M.with_const == 2
        scalar M.k2 = M.k+1 # maximum number of estimated slope coefficients
    else
        scalar M.k2 = M.k
    endif
    scalar M.n_drop_draws = 0
    scalar M.loop_maxiter = 3*M.Nrep
    scalar M.toler = 1.0e-20
    scalar M.CPU_num = 1
    matrix M.StartModel = {}
    matrix M.Y_mat = { Y }
    matrix M.var_numbers = Y || X_list # vector containing numbers of all variables (including Y) in dataset (not in the procedure)
    matrix M.var_numbers2 = M.var_numbers[2:1+M.k] | seq(2,1+M.k)
    strings M.all_names_sp_m = varnames(X_list)
    loop i=1..M.Y_AR_p --quiet
        M.all_names_sp_m[i] = strsub(M.all_names_sp_m[i], "Y_$i", M.Y_name~"_$i")
    endloop
    if M.with_const == 1
        strings const_name = defarray("const")
        M.all_names_sp_m = const_name + M.all_names_sp_m
    endif

    # In case of "out-of-sample" prediction
    if M.h_predict
        scalar M.first_obs = $t1 #Y_AR_p+1 # the first observation for smpl command
        scalar M.last_obs = $tmax-M.h_predict # the last observation for smpl command
        matrix M.Y_mat_predict = M.Y_mat[end-M.h_predict+1:end] # "out-of-sample" matrix of the dependent variable
        M.Y_mat = M.Y_mat[1:end-M.h_predict]
        matrix M.Yhat_predict = zeros(M.h_predict) # vector of Y predictions in current draw
        matrix M.Yhat_predict_var = zeros(M.h_predict) # vector of Y predictions in current draw (variances!!!)
        matrix M.Yhat_predict_avg = zeros(M.h_predict,1) # vector of Y predictions - average
        matrix M.Yhat_predict_var_avg = zeros(M.h_predict,1) # predicion variance
        matrix M.prediction = {} # matrix with prediction results
        loop i=($nobs-M.h_predict+1)..$nobs --quiet
            tmp_str += strsub(obslabel(i), " ", "") ~ " "
        endloop
        string M.predict_obs_names = tmp_str # obs labels for forecasts
        smpl M.first_obs M.last_obs #$nobs-h_predict-Y_AR_p #M.last_obs # setting sample
    else
        matrix M.Yhat_avg = {}
        matrix M.Yhat_var_avg = {}
        matrix M.Y_mat_predict = {}
        string M.predict_obs_names = ""
    endif
    scalar M.N = $nobs

    # New/old model stuff
    scalar M.mod_size = 0 # size of models in MC3 (sum)
    scalar M.k_new = 0 # number of variables in the current (new) model
    scalar M.k_old = 0 # number of variables in the previous (old) model
    scalar M.lprob_new = 0 # natural logarithm of probability of the new model
    scalar M.lprob_old = 0 # natural logarithm of probability  of the old model
    matrix M.scaling_f = zeros(1) # vector containing the scaling factors
    matrix M.bhat_tmp = {} # temporary column vector containing the estimated coefficients for the current model (candidates)
    matrix M.bvar_tmp = {} # temporary column vector containing the variances of the coefficients for the current model (candidates)
    matrix M.X_new_num = {} # vector containing numbers of variables in the new model
    matrix M.X_old_num = {} # vector containing numbers of variables in the old model
    matrix M.mod_struct_new = zeros(1,M.k) # 0-1 vector containing the structure of the current model
    matrix M.mod_struct_old = zeros(1,M.k) # 0-1 vector containing the structure of the current model

    # Posterior results
    scalar M.consthat_avg = 0
    scalar M.constvar_avg = 0
    scalar M.post_n_models = 0 # number of considered models
    scalar M.post_n_models_accepted = 0 # number of accepted models
    scalar M.empty_model_count = 0 # counter for empty model
    matrix M.bhat_avg = zeros(M.k,1) # vector containing average values of coefficients (over MCMC)
    matrix M.bvar_avg = zeros(M.k,1) # vector containing average values of variances of the coefficients (over MCMC)
    matrix M.Numerical_Likelihood = {} # column vector containing numerical probabilities for models
    matrix M.Post_Results = {} # matrix with all posterior results
    matrix M.mod_sizes = {} # Vector with models size distribution
    matrix M.models_probs_percents = {} # CDF-like matrix for accepted models
    matrix M.models_probs_cdf = {} # accepted models CDF
    matrix M.models_probs_cum = {} # accepted models cumulation
    matrix M.mod_rank_prob = zeros(M.l_rank,1) # probability of the models in ranking (analytical)
    matrix M.mod_nume_prob = zeros(M.l_rank,1) # probability of the models in ranking (numerical)
    matrix M.var_prob = zeros(1,M.k) # vector containing PIPs
    matrices M.mod_rank_estimates = array(M.l_rank) # estimates of models in ranking
    matrices M.mod_rank = array(M.l_rank) #-1 * ones(l_rank,M.k) # 0-1 matrix M.containing structure of models in ranking
    if M.limited_y && M.ordered
        matrix M.cutshat_avg = {}
        matrix M.cutsvar_avg = {}
        matrix M.cuts_avg = {}
        matrices M.mod_rank_cuts_estimates = array(M.l_rank) # cuts estimates for models in ranking
    endif

    # Model prior
    matrix M.model_prior_log = zeros(M.k+1)
    if M.acc_type == 1
        string M.prior_name = "Binomial"
        scalar M.a = log(M.av_model_size/M.k)
        scalar M.b = log(1 - M.av_model_size/M.k)
        if M.with_const == 1 || M.limited_y && M.ordered
            tmp = M.av_model_size/M.k
        else
            tmp = fzero(BACE_exp_trunc_dist(tmp, M.k, M.av_model_size, "Binomial"))
        endif
        loop i=0..M.k --quiet
            M.model_prior_log[i+1] = tmp^i * (1-tmp)^(M.k-i)
        endloop
    else
        string M.prior_name = "Beta-Binomial"
        scalar M.a = 1
        if M.with_const == 1 || M.limited_y && M.ordered
            scalar M.b = (M.k - M.av_model_size)/M.av_model_size
        else
            loop while M.toler > 0
                catch tmp = fzero(BACE_exp_trunc_dist(tmp, M.k, M.av_model_size, "Beta-Binomial", M.a), {100, -.00001}, M.toler)
                if $error
                    M.toler *= 10
                else
                    M.b = tmp
                    M.toler = 0
                endif
            endloop
        endif
        loop i=0..M.k --quiet
            M.model_prior_log[i+1] = (gammafun(i+M.a) * gammafun(M.k-i+M.b) / gammafun(M.a+M.k+M.b)) / (gammafun(M.a) * gammafun(M.b) / gammafun(M.a+M.b))
        endloop
    endif
    if M.with_const != 1 && !(M.limited_y && M.ordered)
        M.model_prior_log[2:] /= (1 - M.model_prior_log[1])
    endif
    M.model_prior_log = log(M.model_prior_log)

    # Jointness stuff
    if M.do_joint
        matrix M.jointness_m = zeros(M.k, M.k) # square matrix containing counts of coexistence (jointness) of every pair of indenpendent variables
        strings M.jointess_measure_names = defarray("Doppelhofer-Weeks Measure (DW1)", \
          "Doppelhofer-Weeks Measure (DW2)", "Ley-Steel Measure (LS1)", \
          "Ley-Steel Measure (LS2)", "Strachan Measure (SM)", "Yule's Q Measure (YQ)", \
          "Modified Yule's Q Measure (MYQ)")
    else
        matrix M.jointness_m = {}
    endif

    # BIC version
    if M.bic_type == 1
        string M.bic_type_name = "BIC"
    elif M.bic_type == 2
        string M.bic_type_name = "HBIC"
        M.scaling_f[1] = log(.5*M.N/$pi)
    elif M.bic_type == 3
        string M.bic_type_name = "IBIC"
        M.scaling_f[1] = log(.5*M.N/$pi)
    endif

    # Data transformation
    if M.data_trans == 1
        string M.data_trans_name = "centering"
    elif M.data_trans == 2
        string M.data_trans_name = "standarizing"
    else
        string M.data_trans_name = "none"
    endif

    if M.verbosity == 1
        set warnings off
    endif

    # MC3 progress step
    scalar M.progress = floor(M.Nrep/100)

    BACE_print_status(null, 1, 11)
end function

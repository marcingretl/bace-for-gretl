function void BACE_matrix_precompute (bundle *M)
/*
   Function computes some linear algebra stuff for further computation.
    */
    if (M.k_new > 0)
        if (M.with_const == 1)
            matrix M.X_new = ones(M.N, 1) ~ M.X_new
        else
            matrix M.X_new = M.X_new
        endif
    endif
end function

   You should have received a copy of the GNU General Public License
   along with this program. If not, see <http://www.gnu.org/licenses/>.
*/
function void BACE_Plot (const bundle *MODEL)
    /*
       BACE result bundle plot function.
    */
    string legend, output, basename, xtics, plot_title, plotmat_str
    string yrange = ""
    string line_opts = ""
    scalar avg_model_size = 0
    scalar idx, error
    strings title

    if inbundle(MODEL, "plotspec") && MODEL.plotspec != ""
        basename = MODEL.plotspec
    elif $sysinfo.gui_mode || strstr($gnuplot, "gp-executor") != "" # gretl4py workaround
        basename = "display"
    else
        # CLI: default to producing .plt files
        basename = sprintf("%s.plt", strftime($now[1], "%Y%m%d%H%M%S"))
    endif

    # We set up avg_model_size
    if MODEL.prior_name == "none" && MODEL.prior_based_bic
        avg_model_size = MODEL.avg_model_size_bic
    elif MODEL.prior_name != "none" && !MODEL.prior_based_bic
        avg_model_size = MODEL.avg_model_size
    elif MODEL.prior_name != "none" && MODEL.prior_based_bic
        avg_model_size = xmax(MODEL.avg_model_size, MODEL.avg_model_size_bic)
    endif

    # We decide where the legend should be placed
    if MODEL.prior_name != "custom"
        legend = MODEL.mod_size_av > avg_model_size ? "left" : "right"
    endif

    #########################################################
    #						Heatmaps						#
    #########################################################
    # Heatmap for variable inclusion
    if rows(MODEL.models_probs_percents) == 1
        printf "Variables Inclusions: there is just one model in ranking, nothing to plot.\n"
    else
        BACE_heatmap(MODEL, "inclusions", basename)
    endif

    # Heatmap for jointness
    if MODEL.do_joint
        BACE_heatmap(MODEL, "jointness", basename)
    endif

    #########################################################
    #						Distributions					#
    #########################################################
    # Model size distribution
    plotmat = mreverse(MODEL.mod_sizes, 1)
    output = BACE_get_plot_outname(basename, "-MSD")
    xtics = rows(plotmat) < 20 ? "set xtics 1" : ""
    if MODEL.prior_name == "custom"
        title = cnameget(plotmat)[2:3]
        plotmat = plotmat[,2:3]
        cnameset(plotmat, title)
        plot_title = "Posterior Model Size Distribution"
        line_opts = "set linetype 1 pt 7 lc rgb \"#D95F02\""
    else
        plot_title = "Model Size Distribution"
    endif
    catch plot plotmat
        printf "%s", line_opts
        options with-lp fit=none
        literal set link y2 via y inverse y
        printf "%s", xtics
        printf "set title \"%s\"", plot_title
        printf "set xlabel \"%s\"", "Model Size"
        printf "set ylabel \"%s\"", "Density"
        printf "set key %s top", legend
    end plot --output="@output"
    error = $error
    if error
        printf "Model Size Distribution: %s\n", errmsg(error)
    endif

    # Models size CDF
    if rows(MODEL.models_probs_percents) == 1
        printf "CDF of Model Size: there is just one model in ranking, nothing to plot.\n"
    else
        plotmat = MODEL.models_probs_cdf
        output = BACE_get_plot_outname(basename, "-CDF")
        xtics = rows(plotmat) < 20 ? "set xtics 1" : ""
        catch plot plotmat
            options with-line fit=none
            literal set grid
            printf "%s", xtics
            printf "set title \"%s\"", "CDF of Model Size"
            printf "set xlabel \"%s\"", "Number of Models"
            printf "set ylabel \"%s\"", "Posterior Probability Mass"
        end plot --output="@output"
        error = $error
        if error
            printf "CDF of Model Size: %s\n", errmsg(error)
        endif
    endif

    # Priors
    output = BACE_get_plot_outname(basename, "-MPD")
    if MODEL.prior_name == "custom"
        plotmat = MODEL.IncProbs
        cnameset(plotmat, "")
        set force_decpoint on
        outfile --buffer=plotmat_str
            printf "% .16f", plotmat
        end outfile
        set force_decpoint off
        catch plot
            literal set title 'Inclusion Probabilities'
            literal set boxwidth 0.9 absolute
            literal set style fill solid 1.00 border lt -1
            literal set style histogram clustered gap 1 title textcolor lt -1
            literal set style data histograms
            literal set key outside below center
            literal set xtics border in scale 0,0 nomirror rotate by -45 autojustify
            literal set yrange [0:1.0] noreverse writeback
            literal set grid
            printf "$map << EOD"
            printf "%s", plotmat_str
            printf "EOD"
            literal plot $map using 2:xtic(1) title 'Prior', '' u 3 title 'PIP'
        end plot --output="@output"
        error = $error
        if error
            printf "Prior and Posterior Inclusion Probabilities: %s\n", errmsg(error)
        endif
    else
        # Model prior distribution values
        idx = 1 + (MODEL.with_const != 1 && !(MODEL.limited_y && MODEL.ordered))
        title = defarray(MODEL.prior_name, "Size")
        plotmat = exp(MODEL.model_prior_log)[idx:end] ~ MODEL.mod_sizes[,1]
        if MODEL.prior_based_bic
            plotmat = exp(MODEL.model_prior_bic_log)[idx:end] ~ plotmat
            plotmat = sumr(plotmat[,1:2]) ~ plotmat
            set force_decpoint on
            yrange = sprintf("set yrange [0:%f]", 1.1*max(plotmat[,1:end-1]))
            set force_decpoint off
            title = defarray("Effective", MODEL.bic_type_name) + title
        endif
        cnameset(plotmat, title)
        xtics = rows(plotmat) < 20 ? "set xtics 1" : ""
        catch plot plotmat
            options with-lp fit=none
            literal set link y2 via y inverse y
            printf "%s", xtics
            printf "%s", yrange
            printf "set title \"%s\"", "Prior Model Probabilities"
            printf "set xlabel \"%s\"", "Model Size"
            printf "set ylabel \"%s\"", "Value"
            printf "set key %s top", legend
        end plot --output="@output"
        error = $error
        if error
            printf "Prior Model Probabilities: %s\n", errmsg(error)
        endif
    endif

    #########################################################
    #                       Fitted                          #
    #########################################################
    if MODEL.limited_y
        # Discrete dependent variable: classification heatmap
        BACE_contingency_heatmap(MODEL, basename)
    elif MODEL.estimator == "intreg"
        # to be worked out
    else
        # Continuous dependent variable: actual vs fitted
        idx = 1 + nelem({MODEL.Y}) - nelem(MODEL.Yhat)
        plotmat = {MODEL.Y}[idx:end] ~ MODEL.Yhat

        title = defarray("actual", "fitted")
        cnameset(plotmat, title)

        plot_title = "Fitted"
        output = BACE_get_plot_outname(basename, "-fitted")

        if $datatype == 2
            # Time series: two lines over time
            catch plot plotmat
                options time-series with-lines fit=none
                printf "set title \"%s\"", plot_title
            end plot --output="@output"
        else
            # Cross-section and panel: actual versus fitted
            catch plot plotmat
                options fit=none
                printf "set title \"%s\"", plot_title
                literal set xlabel "Fitted"
                literal set ylabel "Actual"
            end plot --output="@output"
        endif

        error = $error
        if error
            printf "Fitted: %s\n", errmsg(error)
        endif
    endif

    #########################################################
    #						Forecasts						#
    #########################################################
    # Predictive results
    if MODEL.Npredict
        plotmat = MODEL.prediction[,1:2]
        if MODEL.limited_y || MODEL.model_type == "tobit"
            plot_title = "Predictive results"
            bars = MODEL.prediction[,2] ~ zeros(MODEL.Npredict, 1)
        else
            plot_title = "Predictive results (with +/- one standard deviations as bars)"
            bars = MODEL.prediction[,2:3]
        endif
        cnameset(plotmat, cnameget(MODEL.prediction)[1:2])

        output = BACE_get_plot_outname(basename, "-predict")
        xtics = "("
        loop i=1..MODEL.Npredict
            xtics += sprintf("\"%s\" %d", rnameget(MODEL.prediction)[i], i)
            if i == MODEL.Npredict
                xtics += sprintf(")")
            else
                xtics += sprintf(", ")
            endif
        endloop
        catch plot plotmat
            options time-series with-lines
            options with-line fit=none
            options band=bars,1 band-style=bars
            printf "set title \"%s\"", plot_title
            printf "set xlabel \"%s\"", "Observation"
            printf "set xtics %s", xtics
        end plot --output="@output"
        error = $error
        if error
            printf "Predictive results: %s\n", errmsg(error)
        endif
    endif
end function

function string BACE_parse (bundle *M,
                            series Y,
                            strings Y_names,
                            list X_list,
                            int nY[1],
                            series Y2[null])
    /*
       Function parses given parameters end checks several conditions:
       M		- pointer to the bundle
       Y		- dependent variable(s)
       Y_names	- name(s) of dependent variable(s)
       X_list	- list of given independent variables
       nY 		- number of Y variables (used only for intreg)
       Y2 		- the second Y series (right bounds for intreg)
       #
       Returns: string err holding the first error found in given dataset or parameters
    */

    # We setup estimator
    if M.model_type == "linear"
        string M.estimator = "ols"
    elif M.model_type == "mlogit"
        string M.estimator = "logit"
    else
        string M.estimator = M.model_type
    endif

    # Local variables
    scalar k = nelem(X_list) + M.y_lag + (M.with_const > 1)
    if nY == 1
        matrix Y_uniq = uniq(Y)
    else
        matrix Y_uniq = uniq(Y + Y2)
    endif
    string Y_name = Y_names[1]
    string err = ""
    string ESTIMATOR = M.estimator
    string tmp_str
    scalar err_nr

    #################################################################################
    #	Critical problems 															#
    #################################################################################
    # We check if we have at least two possible explanatory variables
    if k < 2
        err = "We must have at least 2 explanatory variables to run BACE analysis"
    endif

    # We check if Y variable "is discrete" or "count data" in case of non-OLS model
    if M.limited_y && sum(Y_uniq - int(Y_uniq)) > 0
        err = "The dependent variable is not discrete"
    elif M.model_type == "poisson" && (sum(Y_uniq - int(Y_uniq)) > 0 || max(Y) <= 1)
        err = "The dependent variable must be count data"
    endif

    # We check if we have more than 1 Y only for intreg
    if nY > 1 && M.model_type != "intreg"
        err = sprintf("You cannot specify %d Y variables for %s model", nY, M.model_type)
    endif

    # We check impossible options for models
    if ESTIMATOR == "intreg" && M.with_const != 1
        err = "Interval regression model must include constant"
    elif ESTIMATOR == "intreg" && M.y_lag
        err = "Interval regression model must not include lagged dependend variable"
    endif

    # We check if average model size is within 0 and K
    if M.avg_model_size <= 0 || M.avg_model_size >= k
        err = "Average model size should be greater than 0 and lower than K"
    endif

    # We check if aplha values
    if M.alpha == 0 && M.with_const == 0
        err = "We cannot have empty initial model (alpha=0) when we don't have constant"
    elif M.model_type == "intreg" && M.alpha != 1
        err = "For interval regression model we must have alpha=1"
    endif

    # We check if number of models in ranking is not greater than 2^K (model space)
    if M.Nrank > 2^(k+M.y_lag)
        err = "Number of the top ranked models cannot be greater than 2^K (space of parameters)"
    endif

    # We check if we have y_lag only in case of linear model for time-series
    if M.y_lag > 0 && (M.model_type != "linear" || $datatype != 2)
        string datatype
        if $datatype == 1
            datatype = "cross-sectional (undated) data"
        elif $datatype == 2
            datatype = "time-series data"
        elif $datatype == 3
            datatype = "panel data"
        endif
        err = sprintf("You try to estimate %s model for %s => you cannot have lagged %s", M.model_type, datatype, Y_name)
    endif

    # If we found critical problem then interupt
    if strlen(err)
        return err
    endif

    #################################################################################
    #	Non-critical problems 														#
    #################################################################################
    # We check if given X_list does not include Y
    if inlist(X_list, Y_name) != 0
        X_list -= X_list[inlist(X_list, Y_name)]
        k -= 1
        print "Dependent variable was removed from the X list."
    endif

    # We check if given X_list does not include lagged Y
    if M.y_lag > 0
        loop i=1..M.y_lag --quiet
            tmp_str = Y_name ~ "_" ~ "$i"
            if inlist(X_list, tmp_str) != 0
                X_list -= X_list[inlist(X_list, tmp_str)]
                k -= 1
                printf "Lag %d of dependent viariable (%s) was removed from the X list.\n", i, tmp_str
            endif
        endloop
    endif

    # We check if given X_list does not include const
    if inlist(X_list, const) != 0
        X_list -= const
        k -= 1
        print "Const was removed from the X list."
    endif

    # We check if given variables are not co-linear
    if nelem(X_list)
        if M.y_lag
            catch @ESTIMATOR Y Y(-1 to -M.y_lag) X_list const --quiet
            err_nr = $error
        else
            if ESTIMATOR == "intreg"
                catch intreg Y Y2 X_list const --quiet
                err_nr = $error
            elif M.model_type == "mlogit"
                catch logit Y const X_list --multinomial --quiet
                err_nr = $error
            else
                catch @ESTIMATOR Y X_list const --quiet
                err_nr = $error
            endif
        endif
        if err_nr
            return sprintf("We could not estimate %s model: %s", M.model_type, errmsg(err_nr))
        endif
        if $ncoeff < k + 1
            X_list = $xlist - const
            if M.y_lag
                loop i=1..M.y_lag --quiet
                    X_list = X_list - Y_$i
                endloop
            endif
            print "Some of the independent variables were colinear and were dropped."
        endif
    endif
    
    series M.Y = Y
    string M.Y_name = Y_name
    matrix M.X_list = X_list
    if nY == 2
        series M.Y2 = Y2
        string M.Y_name2 = Y_names[2]
    endif

    return err
end function

function void BACE_new_X_matrix (string MODE,
                                 bundle *M)
    /*
       Function creates matrix of explanatory variables (demeaned for Classic_BMA) for current draw.
       MODE - mode in which function operates: START (for starting model) or NORMAL
    */
    # If we have at least one variable we create new X matrix, otherwise it includes "Ones" only.
    if (M.k_new > 0)
        if (MODE == "START") # Note: this happens only ones: for the starting model!!!
            BACE_model_structure(&M)
        endif
        M.X_new_num = selifc(M.var_numbers2[2,], M.mod_struct_new)
        M.X_new = selifc(M.big_mat_dem[,2:], M.mod_struct_new)
    else
        M.X_new_num = {}
        if (M.with_const == 1)
            M.X_new = ones(M.N,1)
        else
            M.X_new = {}
        endif
    endif
end function

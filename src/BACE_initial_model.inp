function void BACE_initial_model (bundle *M)
/*
   Function creates list of variables in the initial model.
   *M - pointer to the main bundle
   #
   Local variables:
   Y		- dependent variable
   max_k	- number of given indenpendent variables
   X_list2	- M.X_list in a form of list (not matrix)
    */
    # Local variables
    string ESTIMATOR_OPTS = "--quiet"

    # We set up estimator command
    string ESTIMATOR = M.estimator

    # If we have ordered logit/probit we have to correct $ncoeff
    scalar cuts = 0
    if M.limited_y
        cuts = M.cuts
    endif

    # Do we have additional OPTS for estimator
    if M.Y_censoring && ESTIMATOR == "tobit"
        ESTIMATOR_OPTS = sprintf("%s %s", M.estimator_opts, ESTIMATOR_OPTS)
    endif

    # Starting values of the local variables
    if M.Npredict
        if M.Y_AR_p == 0
            smpl 1 M.N
        else
            if M.CPU_num == 1
                #smpl M.first_obs+($nobs-M.N) M.last_obs #+($t1-1)
                smpl $t1 M.last_obs
            else
                smpl M.last_obs-M.N+1 M.last_obs
            endif
        endif
    endif

    # We re-create Y(s) and X-s
    if inbundle(M, "Y2")
        string Y1_name = M.Y_name
        string Y2_name = M.Y_name2
        series @Y1_name = M.Y
        series @Y2_name = M.Y2
        list YyY = @Y1_name @Y2_name
    else
        series YyY = M.Y
    endif
    if M.Y_AR_p > 0
        lags M.Y_AR_p ; YyY
    endif
    list X_list2 = M.X_list
    list last = {}
    scalar max_k = cols(M.var_numbers2)

    if M.alpha == 0 # Empty model (const only)
        if M.with_const == 2
            last += const
            M.k_new = 1
        else
            M.k_new = 0
        endif
        if ESTIMATOR == "tobit"
            if M.with_const == 1
                tobit YyY const @ESTIMATOR_OPTS
            else
                tobit YyY last @ESTIMATOR_OPTS
            endif            
            M.n_censored = { $model.n_left ; $model.n_right }
            if inbundle($model, "normality_test")
                M.normality_test = $model.normality_test
            endif
        endif
    elif M.alpha == 1 # Trully random model
        M.k_new = randint(0, max_k)
        matrix last_tmp
        if M.k_new > 0
            if M.k_new == max_k # All variables in the starting model, nothing to draw
                last = X_list2
            else
                loop i=1..M.k_new --quiet
                    scalar accept = 0
                    loop while (accept == 0) --quiet
                        cand = transp(M.var_numbers2)[randint(1, max_k), 1]
                        if inlist(last, cand) == 0
                            last_tmp = last_tmp ~ {cand}
                            accept = 1
                        endif
                    endloop
                endloop
                # We have to sort variables in created list
                matrix last_mat = zeros(2, M.k_new)
                last_mat[1,] = last_tmp
                loop i=1..M.k_new --quiet
                    loop j=1..max_k --quiet
                        if last_mat[1,i] == M.var_numbers2[1,j]
                            last_mat[2,i] = M.var_numbers2[2,j]
                            break
                        endif
                    endloop
                endloop
                last_mat = transp(msortby(transp(last_mat),2))
                last = last_mat[1,]
                if M.with_const == 1
                    @ESTIMATOR YyY const last @ESTIMATOR_OPTS
                else
                    @ESTIMATOR YyY last @ESTIMATOR_OPTS
                endif
                last = $xlist
                if M.with_const == 1
                    last -= const
                    M.k_new = $ncoeff-1
                else
                    M.k_new = $ncoeff-cuts
                endif
                M.StartModel_b = $model
                strings M.StartModel_xnames = varnames($xlist)
            endif
        endif
        if M.censored_y
            if M.k_new == max_k
                @ESTIMATOR YyY const last @ESTIMATOR_OPTS
            elif M.k_new == 0 && ESTIMATOR == "intreg"
                intreg YyY const @ESTIMATOR_OPTS
            endif
            M.StartModel_b = $model
            strings M.StartModel_xnames = varnames($xlist)
            M.n_censored = { $model.n_left ; $model.n_right }
            if ESTIMATOR == "intreg"
                M.n_censored = M.n_censored | { $model.n_both ; $model.n_point }
            endif
            if inbundle($model, "normality_test")
                M.normality_test = $model.normality_test
            endif
        endif
    else
        # Model reduced at given alpha
        if M.with_const == 1
            @ESTIMATOR YyY const X_list2 @ESTIMATOR_OPTS
        else
            @ESTIMATOR YyY X_list2 @ESTIMATOR_OPTS
        endif
        if nelem($xlist) > 1
            omit --auto=M.alpha --silent
        endif
        last = $xlist
        if M.with_const == 1
            last -= const
            M.k_new = $ncoeff-1
        else
            M.k_new = $ncoeff-cuts
        endif
        M.StartModel_b = $model
        strings M.StartModel_xnames = varnames($xlist)
        if ESTIMATOR == "tobit"
            M.n_censored = { $model.n_left ; $model.n_right }
            if inbundle($model, "normality_test")
                M.normality_test = $model.normality_test
            endif
        endif
    endif

    # Starting values
    matrix M.StartModel = last
    matrix M.mod_struct_new = zeros(1,M.k)
   
    # Setting 1 for variables in current draw
    loop i=1..cols(M.StartModel) --quiet
        loop j=1..M.k --quiet
            if M.var_numbers2[1,j] == M.StartModel[i]
                M.mod_struct_new[M.var_numbers2[2,j]-1] = 1
                break
            endif
        endloop
    endloop
end function

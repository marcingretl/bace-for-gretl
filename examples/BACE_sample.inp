#######################################################
#   https://sourceforge.net/projects/bace-for-gretl/  #
#######################################################

# Usage:
set verbose off
include BACE.gfn

# NELS dataset available at http://www.learneconometrics.com/gretl/index.htm
open nels.gdt --frompkg=BACE --quiet

# We specify list of explanatory variables
list X = 2..14

# We set the seed in order to exact reproduction of results
set seed 1000000

set stopwatch
BACE(psechoice, X, _(model_type="probit"))
printf "Total execution time: %.2f sec.\n", $stopwatch


function void BACE_collect_results (bundle *M, bundle *known_models,
                                    matrix *models_counter, matrix *models_lprob,
                                    matrices *models_estimates, matrices *models_structure,
                                    matrices *models_forecasts[null], matrices *models_yhat[null])
    /*
       Function collects results from MC3 experiment.
    */
    BACE_print_status("Collecting results", 0)
    matrix idx, var_idx, bhat, mod_struct, models_probs
    matrices models_structure_rank, models_estimates_rank, cuts_estimates, cuts_estimates_rank, alpha_estimates, alpha_estimates_rank
    scalar nr, mod_struct_sum
    scalar weight = 0
    if M.with_const == 1
        matrix bhat_avg = zeros(M.k+1)
        matrix bvar_avg = zeros(M.k+1)
    else
        matrix bhat_avg = zeros(M.k)
        matrix bvar_avg = zeros(M.k)
    endif
    matrix mod_sizes = zeros(M.k)
    matrix var_prob = zeros(1,M.k)
    if M.do_joint
        matrix jointness_m = zeros(M.k,M.k)
    endif
    if M.Npredict
        Yhat_avg = zeros(M.Npredict)
        Yhat_var_avg = zeros(M.Npredict)
    endif
    if M.limited_y
        Yhat = zeros($nobs)
        if M.ordered
            matrix cutshat_avg = zeros(M.cuts)
            matrix cutsvar_avg = zeros(M.cuts)
        endif
    elif M.model_type == "zip"
        scalar alphahat_avg = 0
        scalar alphavar_avg = 0
    endif

    # We set the number of visited models
    M.post_n_models = nelem(known_models)
    if M.with_const == 0 && !(M.limited_y && M.ordered)
        M.post_n_models = xmin(M.post_n_models, 2^M.k-1)
    endif
    known_models = null

    # We select objects only for accepted models
    idx = selifr(seq(1, M.Nrep+1)', models_counter .> 0)
    M.post_n_models_accepted = nelem(idx)
    models_counter = models_counter[idx]
    models_estimates = models_estimates[idx]
    models_structure = models_structure[idx]
    if M.Npredict
        models_forecasts = models_forecasts[idx]
    endif
    if M.limited_y
        models_yhat = models_yhat[idx]
        if M.ordered
            cuts_estimates = array(nelem(models_counter))
            loop i=1..nelem(models_counter) --quiet
                cuts_estimates[i] = models_estimates[i][end-M.cuts+1:end,]
                if rows(models_estimates[i]) > M.cuts
                    models_estimates[i] = models_estimates[i][1:end-M.cuts,]
                else
                    models_estimates[i] = {}
                endif
            endloop
        endif
    elif M.model_type == "zip"
        alpha_estimates = array(nelem(models_counter))
        loop i=1..nelem(models_counter) --quiet
            alpha_estimates[i] = models_estimates[i][end,]
            if rows(models_estimates[i]) > 1
                models_estimates[i] = models_estimates[i][1:end-1,]
            else
                models_estimates[i] = {}
            endif
        endloop
    endif

    # Models size cumulative distribution
    models_probs = mreverse(msortby(models_counter ~ idx ~ seq(1, M.post_n_models_accepted)', 1))
    M.models_probs_cum = cum(dsort(models_probs[,1]))

    # We build analytical and numerical rankings
    M.Nrank = xmin(M.Nrank, M.post_n_models_accepted)
    models_probs = models_probs[1:M.Nrank,]
    M.mod_nume_prob = models_probs[,1]
    M.mod_rank_prob = models_lprob[models_probs[,2]]
    models_structure_rank = models_structure[models_probs[,3]]
    models_estimates_rank = models_estimates[models_probs[,3]]
    if M.limited_y && M.ordered
        cuts_estimates_rank = cuts_estimates[models_probs[,3]]
    elif M.model_type == "zip"
        alpha_estimates_rank = alpha_estimates[models_probs[,3]]
    endif

    # We restore estimates for models in ranking
    loop i=1..M.Nrank --quiet
        var_idx = {}
        mod_struct = models_structure_rank[i]
        M.mod_rank[i] = mod_struct
        if M.with_const == 1
            var_idx = { 1 } ~ selifc(M.var_numbers2[2,], mod_struct)
        else
            if sum(mod_struct) != 0
                var_idx = selifc(M.var_numbers2[2,], mod_struct) - 1
            endif
        endif
        if nelem(models_estimates_rank[i])
            M.mod_rank_estimates[i] = models_estimates_rank[i][,1] ~ sqrt(models_estimates_rank[i][,2]) ~ transp(var_idx)
            M.mod_rank_bic[i] = -2 * (M.mod_rank_prob[i] - M.model_prior_log[sum(mod_struct)+1])
            if M.limited_y && M.ordered
                M.mod_rank_cuts_estimates[i] = cuts_estimates_rank[i][,1] ~ sqrt(cuts_estimates_rank[i][,2])
            elif M.model_type == "zip"
                M.mod_rank_alpha_estimates[i] = alpha_estimates_rank[i][,1] ~ sqrt(alpha_estimates_rank[i][,2])
            endif
        endif
    endloop

    # We average over all accepted models
    if M.show_progress
        BACE_print_status("averaging", 0, 11, 1)
        scalar M.progress = ceil(nelem(models_counter)/100)
        percentage = M.progress
        flush
    endif
    loop i=1..nelem(models_counter) --quiet
        weight = models_counter[i]
        mod_struct = models_structure[i]
        mod_struct_sum = sum(mod_struct)

        ## Original BACE
        if M.with_const == 1
            var_idx = { 1 } ~ selifc(M.var_numbers2[2,], mod_struct)
        else
            if mod_struct_sum
                var_idx = selifc(M.var_numbers2[2,], mod_struct) - 1
            else
                var_idx = {}
            endif
        endif

        if nelem(models_estimates[i])
            bhat = models_estimates[i][,1]
            bhat_avg[var_idx] += weight * bhat
            bvar_avg[var_idx] += weight * (models_estimates[i][,2] + bhat .^ 2)
            if M.limited_y && M.ordered
                bhat = cuts_estimates[i][,1]
                cutshat_avg += weight * bhat
                cutsvar_avg += weight * (cuts_estimates[i][,2] + bhat .^ 2)
            elif M.model_type == "zip"
                bhat = alpha_estimates[i][,1]
                alphahat_avg += weight * bhat
                alphavar_avg += weight * (alpha_estimates[i][,2] + bhat .^ 2)
            endif
            if mod_struct_sum
                mod_sizes[mod_struct_sum] += weight
            else
                M.empty_model_count = weight
            endif
            var_prob += weight * mod_struct
        endif

        if M.do_joint
            jointness_m = upper(jointness_m .+ weight * ((mod_struct .* mod_struct') .> 0))
        endif

        if M.Npredict
            if nelem(models_forecasts[i]) > 0
                Yhat_avg += weight * models_forecasts[i][,1]
                Yhat_var_avg += weight * models_forecasts[i][,2]
            endif
        endif

        if M.limited_y
            Yhat += weight * models_yhat[i]
        endif

        # Flushing output - showing progress
        if M.show_progress && i == percentage
            BACE_show_progress(i, &percentage, M.progress, nelem(models_counter))
        endif
    endloop

    #############################################
    # We save collected results in the bundle M #
    #############################################

    # Coefficients and variances
    if M.with_const == 1
        M.bhat_avg = bhat_avg[2:,]
        M.bvar_avg = bvar_avg[2:,]
        M.consthat_avg = bhat_avg[1]
        M.constvar_avg = bvar_avg[1]
    else
        M.bhat_avg = bhat_avg
        M.bvar_avg = bvar_avg
    endif
    if M.limited_y && M.ordered
        M.cutshat_avg = cutshat_avg
        M.cutsvar_avg = cutsvar_avg
    elif M.model_type == "zip"
        M.alphahat_avg = alphahat_avg
        M.alphavar_avg = alphavar_avg
    endif

    # Probability of variables
    M.var_prob = var_prob

    # Jointness analysis
    if M.do_joint
        M.jointness_m = jointness_m
    endif

    # Forecasts
    if M.Npredict
        M.Yhat_avg = Yhat_avg
        M.Yhat_var_avg = Yhat_var_avg
    endif

    # Models size distribution
    M.mod_sizes = seq(1, M.k)' ~ mod_sizes
    if M.with_const == 1 || M.limited_y && M.ordered
        M.mod_sizes = {0} ~ M.empty_model_count | M.mod_sizes
    endif

    # Fitted values
    if M.limited_y
        M.Yhat = Yhat
    endif

    if M.show_progress
        printf "\n"
        BACE_print_status(null, 1, 22)
    else
        BACE_print_status(null, 1, 3)
    endif
end function

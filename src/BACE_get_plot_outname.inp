function string BACE_get_plot_outname (const string base, const string insert)
/*
   Function makes string for plot output: either 'display' (in gui mode)
   or file name with one of supported extensions.

   This code was written by Allin Cottrell.
    */
    string s = base
    if instring(s, ".")
        # We need a valid plot-type suffix
        strings ok = defarray("plt", "png", "pdf", "eps", "svg", "html", "emf")
        strings S = strsplit(base, ".")
        scalar n = nelem(S)
        string sfx = S[n]
        errorif(nelem(instrings(ok, sfx)) == 0, sprintf("Unsupported plot filename suffix '%s'", sfx))
        s = ""
        loop i=1..n-1
            s ~= i < n-1 ? sprintf("%s.", S[i]) : S[i]
        endloop
        s ~= sprintf("%s.%s", insert, sfx)
    else
        errorif(s != "display", sprintf("Invalid plot output spec '%s'", s))
    endif
    return s
end function

<?xml version="1.0" encoding="UTF-8"?>
<gretl-functions>
<gretl-function-package name="BACE" minver="2018a" lives-in-subdir="true">
<author email="marcin@gretlconference.org">Marcin Błażejowski, Jacek Kwiatkowski</author>
<version>2.0-svn</version>
<date>2022-06-23</date>
<description>This package provides BACE (Bayesian Averaging of Classical Estimates) procedure.</description>
<tags>C20 C52</tags>
<label>BACE</label>
<menu-attachment>MAINWIN/Model/LinearModels</menu-attachment>
<help>
pdfdoc:BACE.pdf
</help>
<gretl-function name="BACE" type="bundle">
 <params count="3">
  <param name="Y" type="series">
<description>Dependent variable</description>
  </param>
  <param name="X_list" type="list">
<description>List of indenpendent variables (X)</description>
  </param>
  <param name="Options" type="bundle" optional="true"/>
 </params>
<code>/*
Bundle-based to carry out BMA analysis.
Function returns bundle MODEL with (formatted) results.
*/
bundle MODEL
string Y_name = argname(Y)
series @Y_name = Y
scalar Y_AR_p,with_const,acc_type,av_model_size,alpha,l_rank,do_joint,h_predict,Nrep,burn,verbosity,show_progress,do_plot
string model_type,err
if !exists(Options)
  bundle Options
endif
# Basic parsing and checking
err = BACE_bcheck(Options, nelem(X_list), &amp;Y_AR_p, &amp;with_const, &amp;acc_type, &amp;av_model_size, &amp;alpha, &amp;l_rank, &amp;do_joint, &amp;h_predict, &amp;Nrep, &amp;burn, &amp;verbosity, &amp;show_progress, &amp;do_plot, &amp;model_type)
if strlen(err) != 0
  funcerr &quot;@err !!!&quot;
  return MODEL
endif
Norig = $nobs
smpl Y X_list --no-missing --quiet
if Norig != $nobs
  printf &quot;\nThere are missing values in dataset!\n&quot;
else
  Norig = NA
endif
err = BACE_parse(&amp;MODEL, Y, argname(Y), Y_AR_p, X_list, av_model_size, l_rank, alpha, with_const, model_type)
if strlen(err) != 0
  funcerr &quot;@err !!!&quot;
else
  MODEL = BACE_setup(Y, Y_AR_p, MODEL.X_list, acc_type, av_model_size, alpha, l_rank, do_joint, h_predict, Nrep, burn, verbosity, argname(Y), show_progress, with_const, Norig, do_plot, model_type)
  # Setting sample for forecasting
  if MODEL.h_predict &gt; 0
    smpl 1 MODEL.last_obs
  endif
  BACE_main(&amp;MODEL)
  BACE_summary(&amp;MODEL)
  BACE_Print(&amp;MODEL)
  if MODEL.do_plot
    BACE_Plot(&amp;MODEL)
  endif
endif
set warnings on
return MODEL
</code>
</gretl-function>
<gretl-function name="BACE_Print" type="void" pkg-role="bundle-print">
 <params count="1">
  <param name="M" type="bundleref"/>
 </params>
<code>/*
Function prints BACE results.
*/
matrix coeffmat
model_space = 2^M.k
# We re-create Y process
string Y_name = M.Y_name
series @Y_name = M.Y
# Do we have Y lags?
if M.Y_AR_p &gt; 0
  lags M.Y_AR_p ; @Y_name
endif
# We have to set sample
if M.h_predict &gt; 0
  smpl M.first_obs M.last_obs
endif
# Additional information in summary
printf &quot;\n&quot;
print &quot;----------------------------------&quot;
printf &quot;Model type: %s\n&quot;, M.model_type
printf &quot;Constant type: %s\n&quot;, M.const_type
printf &quot;Prior: %s\n&quot;, M.prior_name
printf &quot;Prior average model size: %f\n&quot;, M.av_model_size
printf &quot;Significance level for the initial model: %f\n&quot;, M.alpha
printf &quot;Total number of iterations: %d\n&quot;, M.Nrep
printf &quot;Number of burn-in draws: %d\n&quot;, M.Nburn
if model_space &lt; 2^31
  printf &quot;Total number of possible models: %d\n&quot;, model_space
else
  printf &quot;Total number of possible models: %g\n&quot;, model_space
endif
printf &quot;Number of models visited: %d\n&quot;, M.post_n_models
printf &quot;Number of models accepted: %d\n&quot;, M.post_n_models_accepted
if exists(M.Norig) == 1
  printf &quot;Original number of observations (with missing): %d\n&quot;, M.Norig
endif
if M.verbosity == 2
  printf &quot;\n&quot;
  print &quot;----------------------------------&quot;
  if nelem(M.StartModel_b) != 0
    printf &quot;The initial model: OLS, dependent variable: %s\n&quot;, M.Y_name
    loop i=1..nelem(M.StartModel_xnames) --quiet
      if substr(M.StartModel_xnames[i], 1, 4) == &quot;YyY_&quot;
        M.StartModel_xnames[i] = strsub(M.StartModel_xnames[i], &quot;YyY&quot;, M.Y_name)
      endif
    endloop
    coeffmat = M.StartModel_b.coeff ~ M.StartModel_b.stderr
    strings coeffmat_xnames = M.StartModel_xnames
    modprint coeffmat coeffmat_xnames
  else
    printf(&quot;The initial model was empty.\n&quot;)
  endif
endif
# Standard information (PIPs, Means and so on)
print &quot;----------------------------------&quot;
printf &quot;\n&quot;
printf &quot;Prior:\n&quot;
printf &quot;\taverage model size: %f\n&quot;, M.av_model_size
printf &quot;\tstandard deviation: %f\n&quot;, M.mod_size_sd_prior
printf &quot;Posterior:\n&quot;
printf &quot;\taverage model size: %f\n&quot;, M.mod_size_av
printf &quot;\tstandard deviation: %f\n&quot;, M.mod_size_sd
printf &quot;\n&quot;
print &quot;----------------------------------&quot;
printf &quot;\n&quot;
print &quot;Posterior moments (unconditional and conditional on inclusion):&quot;
if $version &lt; 20170
  printf &quot;%15f&quot;, M.Post_Results
else
  matrix Post_Results = M.Post_Results
  if M.with_const == 1
    Post_Results[1,1] += 1 # Trick to have const always in the first row after sorting by PIPs
    Post_Results = mreverse(msortby(Post_Results, 1))
    Post_Results[1,1] -= 1
  else
    Post_Results = mreverse(msortby(Post_Results, 1))
  endif
  printf &quot;%15f&quot;, Post_Results
endif
printf &quot;\n&quot;
print &quot;----------------------------------&quot;
printf &quot;\n&quot;
print &quot;Posterior probability of models:&quot;
loop i=1..rows(M.models_probs_percents) --quiet
  if i &lt;= 4
    printf &quot;Best %d\t models account for %.4f of mass\n&quot;, M.models_probs_percents[i,1], M.models_probs_percents[i,2]
  elif i == rows(M.models_probs_percents)
    printf &quot;Best %d models account for %.4f of mass\n&quot;, M.models_probs_percents[i,1], M.models_probs_percents[i,2]
  else
    printf &quot;Best %d models account for %.4f of mass\n&quot;, M.models_probs_percents[i,1], M.models_probs_percents[i,2]
  endif
endloop
printf &quot;\nBest models ranking:\n&quot;
############ OLD #########################
loop i=1..M.l_rank --quiet
  printf &quot;Model %d:\t%f\n&quot;, i, M.Numerical_Likelihood[i]
endloop
printf &quot;Total probability of the models in ranking (numerical): %f\n&quot;, sumc(M.Numerical_Likelihood)
printf &quot;\n&quot;
printf &quot;Correlation coefficient between the analytical\n&quot;
printf &quot;and numerical probabilities of the above models: %f\n&quot;, BACE_correlation_coeff(&amp;M)
# Forecasts
if M.h_predict &gt; 0
  printf &quot;\n&quot;
  print &quot;----------------------------------&quot;
  printf &quot;\n&quot;
  print &quot;Predictive results:&quot;
  printf &quot;%15f&quot;, M.prediction
  printf &quot;\n&quot;
endif
# Jointess analysis
if M.do_joint != 0
  matrix jointess_measure = BACE_jointness_measure(&amp;M)
  string jointess_measure_name = M.jointess_measure_names[M.do_joint]
  if M.do_joint == 1
    string jointess_measure_name = &quot;Ley-Steel Measure (LS2)&quot;
  elif M.do_joint == 2
    string jointess_measure_name = &quot;Doppelhofer-Weeks Measure (DW2)&quot;
  elif M.do_joint == 3
    string jointess_measure_name = &quot;Ley-Steel Measure (LS1)&quot;
  elif M.do_joint == 4
    string jointess_measure_name = &quot;Doppelhofer-Weeks Measure (DW1)&quot;
  elif M.do_joint == 5
    string jointess_measure_name = &quot;Strachan Measure&quot;
  elif M.do_joint == 6
    string jointess_measure_name = &quot;Yule's Q Measure (YQ)&quot;
  elif M.do_joint == 7
    string jointess_measure_name = &quot;Modified Yule's Q Measure (YQM)&quot;
  endif
  print &quot;----------------------------------&quot;
  printf &quot;\n&quot;
  print &quot;Posterior joint probability of variables:&quot;
  printf &quot;%15f&quot;, M.jointness_m
  printf &quot;\n&quot;
  printf &quot;Jointness statistics (%s):\n&quot;, jointess_measure_name
  printf &quot;%15f&quot;, jointess_measure
  scalar strong_sub = 0
  scalar significant_sub = 0
  scalar strong_com = 0
  scalar significant_com = 0
  matrix pairs = zeros(round(0.5*M.k^2), 3)
  scalar pair = 0
  loop i=1..M.k --quiet
    loop j=i+1..M.k --quiet
      if abs(jointess_measure[i,j]) &gt; 1
        pair += 1
        pairs[pair,1] = jointess_measure[i,j]
        pairs[pair,2] = i
        pairs[pair,3] = j
        if (jointess_measure[i,j] &lt; 0)
          if (jointess_measure[i,j] &lt; -2)
            strong_sub += 1
          else
            significant_sub += 1
          endif
        else
          if jointess_measure[i,j] &gt; 2
            strong_com += 1
          else
            significant_com += 1
          endif
        endif
      endif
    endloop
  endloop
  if pair &gt; 0
    pairs = msortby(pairs[1:pair, ], 1)
    scalar shift = 0
    if strong_sub &gt; 0
      BACE_jointness_pairs(&quot;Strong substitutes:&quot;, &amp;strong_sub, M.var_numbers, &amp;shift, &amp;pairs, M.jointness_m)
    endif
    if significant_sub &gt; 0
      BACE_jointness_pairs(&quot;Significant substitutes:&quot;, &amp;significant_sub, M.var_numbers, &amp;shift, &amp;pairs, M.jointness_m)
    endif
    if significant_com &gt; 0
      BACE_jointness_pairs(&quot;Significant complements:&quot;, &amp;significant_com, M.var_numbers, &amp;shift, &amp;pairs, M.jointness_m)
    endif
    if strong_com &gt; 0
      BACE_jointness_pairs(&quot;Strong complements:&quot;, &amp;strong_com, M.var_numbers, &amp;shift, &amp;pairs, M.jointness_m)
    endif
  endif
endif
# Printing models in ranking
if M.verbosity == 2
  strings Xnames # names of X-es
  printf &quot;\n\nBest models estimates:&quot;
  loop i=1..M.l_rank --quiet
    if M.mod_nume_prob[i]
      printf &quot;\n&quot;
      print &quot;----------------------------------&quot;
      printf &quot;\nModel: %d, posterior probability: %f&quot;, i, M.Numerical_Likelihood[i]
      if sumr(M.mod_rank[i]) == 0
        printf &quot;\n\n  %s\n&quot;, &quot;None of the variables were significant.&quot;
        printf &quot;  %s\n&quot;, &quot;Model includes only the intercept term which is simply the average of the dependent variable.&quot;
      else
        coeffmat = M.mod_rank_estimates[i][,1:2]
        Xnames = M.all_names_sp_m[M.mod_rank_estimates[i][,3]]
        # Very crude workaround for examples when Xnames has unprintable elements
        if nelem(Xnames) != rows(coeffmat)
          Xnames = null
          Xnames = M.all_names_sp_m[M.mod_rank_estimates[i][,3]]
        endif
        modprint coeffmat Xnames
      endif
    endif
  endloop
endif
print &quot;----------------------------------&quot;
printf &quot;\n\n&quot;
</code>
</gretl-function>
<gretl-function name="BACE_GUI" type="bundle" pkg-role="gui-main">
 <params count="14">
  <param name="Y" type="series">
<description>Dependent variable</description>
  </param>
  <param name="Y_AR_p" type="int" min="0" default="0">
<description>Y lags</description>
  </param>
  <param name="X_list" type="list" optional="true">
<description>List of independent variables (X)</description>
  </param>
  <param name="with_const" type="int" min="0" max="2" default="1">
<description>Constant in model</description>
<labels count="3">
"Never" "Always" "Can be dropped" </labels>
  </param>
  <param name="acc_type" type="int" min="1" max="2" default="1">
<description>Model prior</description>
<labels count="2">
"Binomial" "Binomial-Beta" </labels>
  </param>
  <param name="av_model_size" type="scalar" min="0" default="1">
<description>Prior average model size</description>
  </param>
  <param name="alpha" type="scalar" min="0" max="1" default="0.6">
<description>Significance level for the initial model</description>
  </param>
  <param name="l_rank" type="int" min="2" default="4">
<description>Number of the top ranked models</description>
  </param>
  <param name="do_joint" type="int" min="0" max="7" default="0">
<description>Jointness analysis</description>
<labels count="8">
"None" "Ley-Steel Measure (LS2)" "Doppelhofer-Weeks Measure (DW2)" "Ley-Steel Measure (LS1)" "Doppelhofer-Weeks Measure (DW1)" "Strachan Measure" "Yule's Q Measure (YQ)" "Modified Yule's Q Measure (YQM)" </labels>
  </param>
  <param name="h_predict" type="int" min="0" default="0">
<description>Number of out-of-sample forecasts</description>
  </param>
  <param name="Nrep" type="int" default="1e+06">
<description>Total number of replications</description>
  </param>
  <param name="burn" type="int" min="0" max="99" default="10">
<description>Percentage of burn-in draws</description>
  </param>
  <param name="verbosity" type="int" min="1" max="2" default="1">
<description>Verbosity</description>
  </param>
  <param name="show_progress" type="bool" default="1">
<description>Show overall progress</description>
  </param>
 </params>
<code>/*
GUI-based function to carry out BACE analysis.
Function is a wrapper to bundle-based BACE() interface.
*/
# Basic parsing and checking
bundle Options
string Y_name = argname(Y)
series @Y_name = Y
scalar Options[&quot;Y_AR_p&quot;] = 0
scalar Options[&quot;with_const&quot;] = with_const
scalar Options[&quot;acc_type&quot;] = acc_type
scalar Options[&quot;av_model_size&quot;] = av_model_size
scalar Options[&quot;alpha&quot;] = alpha
scalar Options[&quot;l_rank&quot;] = l_rank
scalar Options[&quot;do_joint&quot;] = do_joint
scalar Options[&quot;h_predict&quot;] = h_predict
scalar Options[&quot;Nrep&quot;] = Nrep
scalar Options[&quot;burn&quot;] = burn
scalar Options[&quot;verbosity&quot;] = verbosity
scalar Options[&quot;show_progress&quot;] = show_progress
#scalar Options[&quot;do_plot&quot;] = do_plot
return BACE(@Y_name, X_list, Options)
</code>
</gretl-function>
<gretl-function name="BACE_model_switch" type="void" private="1">
 <params count="2">
  <param name="MODE" type="string"/>
  <param name="M" type="bundleref"/>
 </params>
<code>/*
This is general purpose model switching function which
save and restore old model or save the new model
*/
if (MODE == &quot;SAVE&quot;)
  M.X_old_num = M.X_new_num
  M.model_index_old = M.model_index_new
  M.model_hex_index_old = M.model_hex_index_new
  if (M.h_predict &gt; 0)
    M.X_old_predict = M.X_new_predict
    M.ZtZinv_old = M.ZtZinv_new
    M.dj_old = M.dj_new
    M.ess_old = M.ess_new
  endif
elif (MODE == &quot;RESTORE&quot;)
  M.X_new_num = M.X_old_num
  M.k_new = M.k_old
  M.model_index_new = M.model_index_old
  M.model_hex_index_new = M.model_hex_index_old
  if (M.h_predict &gt; 0)
    M.X_new_predict = M.X_old_predict
    M.ZtZinv_new = M.ZtZinv_old
    M.dj_new = M.dj_old
    M.ess_new = M.ess_old
  endif
elif (MODE == &quot;ACCEPT&quot;)
  M.lprob_old = M.lprob_new
  M.k_old = M.k_new
  M.ess_old = M.ess_new
  M.mod_struct = M.mod_struct_new
  M.model_index_old = M.model_index_new
  M.model_hex_index_old = M.model_hex_index_new
endif
</code>
</gretl-function>
<gretl-function name="BACE_parse" type="string" private="1">
 <params count="10">
  <param name="M" type="bundleref"/>
  <param name="Y" type="series"/>
  <param name="Y_name" type="string"/>
  <param name="Y_AR_p" type="int"/>
  <param name="X_list" type="list"/>
  <param name="av_model_size" type="scalar" const="true"/>
  <param name="l_rank" type="scalar" const="true"/>
  <param name="alpha" type="scalar" const="true"/>
  <param name="with_const" type="scalar" const="true"/>
  <param name="model_type" type="string" const="true"/>
 </params>
<code>/*
Function parses given parameters end checks several conditions:
M				- pointer to the bundle
Y				- dependent variable
Y_name			- name of dependent variable
Y_AR_p			- Y autoregression order
X_list			- list of given independent variables
av_model_size	- scalar with prior average model size
l_rank			- scalar with number of models in ranking
alpha			- scalar with significant level for initial model
with_const		- scalar with constant type (never, always, random)
#
Returns: string err holding the first error found in given dataset or parameters
*/
# Local variables
scalar k = nelem(X_list) + Y_AR_p + (with_const &gt; 1)
strings DiscreteModelTypes = defarray(&quot;logit&quot;, &quot;probit&quot;)
string err = &quot;&quot;
string tmp_str
# We check if given X_list does not include Y
if (inlist(X_list, Y_name) != 0)
  X_list -= X_list[inlist(X_list, Y_name)]
  k -= 1
  print &quot;Dependent viariable was removed from the X list.&quot;
endif
# We check if given X_list does not include lagged Y
if (Y_AR_p &gt; 0)
  loop i=1..Y_AR_p --quiet
    tmp_str = Y_name ~ &quot;_&quot; ~ &quot;$i&quot;
    if (inlist(X_list, tmp_str) != 0)
      X_list -= X_list[inlist(X_list, tmp_str)]
      k -= 1
      printf &quot;Lag %d of dependent viariable (%s) was removed from the X list.\n&quot;, i, tmp_str
    endif
  endloop
endif
# We check if given X_list does not include const
if (inlist(X_list, const) != 0)
  X_list -= const
  k -= 1
  print &quot;Const was removed from the X list.&quot;
endif
# We check if given variables are not co-linear
# dropcoll() seems not to work good here
if (nelem(X_list) &gt; 0)
  if (Y_AR_p &gt; 0)
    ols Y Y(-1 to -Y_AR_p) X_list const --quiet
  else
    ols Y X_list const --quiet
  endif
  if ($ncoeff &lt; k + 1)
    X_list = $xlist - const
    if (Y_AR_p &gt; 0)
      loop i=1..Y_AR_p --quiet
        X_list = X_list - Y_$i
      endloop
    endif
    print &quot;Some of the independent variables were colinear and were dropped.&quot;
  endif
endif
# We check if average model size is within 0 and K
scalar max_model_size = k # We chould check it!!!
if ((av_model_size &lt;= 0) || (av_model_size &gt;= max_model_size))
  err = &quot;Average model size should be greater then 0 and lower than K&quot;
  return err
endif
# We check if aplha then 0 in we don't have const (we can't have empty model)
if ((alpha == 0) &amp;&amp; (with_const == 0))
  err = &quot;We cannot have empty initial model (alpha = 0) when we don't have constant&quot;
  return err
endif
# We check if number of models in ranking is not greater than 2^K (model space)
if (l_rank &gt; 2^(k+Y_AR_p))
  err = &quot;Number of the top ranked models cannot be greater than 2^K (space of parameters)&quot;
  return err
endif
# We check if we have discrete Y variable in case of logit/probit/etc models
if nelem(instrings(DiscreteModelTypes, model_type)) &amp;&amp; !isdiscrete(Y)
  err = sprintf(&quot;The variable '%s' is not discrete&quot;, Y_name)
endif
matrix M.X_list = X_list
return err
</code>
</gretl-function>
<gretl-function name="BACE_initial_model" type="void" private="1">
 <params count="1">
  <param name="M" type="bundleref"/>
 </params>
<code>/*
Function creates list of variables in the initial model.
*M - pointer to the main bundle
#
Local variables:
Y		- dependent variable
max_k	- number of given indenpendent variables
X_list2	- M.X_list in a form of list (not matrix)
*/
# Starting values of the local variables
if M.h_predict &gt; 0
  if M.Y_AR_p == 0
    smpl 1 M.N
  else
    if M.CPU_num == 1
      smpl M.first_obs+($nobs-M.N) M.last_obs #+($t1-1)
    else
      smpl M.last_obs-M.N+1 M.last_obs
    endif
  endif
endif
series YyY = M.Y_mat
if M.Y_AR_p &gt; 0
  lags M.Y_AR_p ; YyY
endif
list X_list2 = M.X_list
list last = {}
scalar max_k = cols(M.var_numbers2)
if M.alpha == 0 # Empty model (const only)
  if M.with_const == 2
    last += const
    M.k_new = 1
  else
    M.k_new = 0
  endif
elif M.alpha == 1	# Trully random model
  M.k_new = randint(0, max_k)
  matrix last_tmp
  if (M.k_new &gt; 0)
    if M.k_new == max_k # All variables in the starting model, nothing to draw
      last = X_list2
    else
      loop i=1..M.k_new --quiet
        scalar accept = 0
        #set loop_maxiter 99999 # This should be set if we cannot construct random list
        loop while (accept == 0) --quiet
          cand = transp(M.var_numbers2)[randint(1, max_k), 1]
          if inlist(last, cand) == 0
            last_tmp = last_tmp ~ {cand}
            accept = 1
          endif
        endloop
      endloop
      # We have to sort variables in created list
      matrix last_mat = zeros(2, M.k_new)
      last_mat[1,] = last_tmp
      loop i=1..M.k_new --quiet
        loop j=1..max_k --quiet
          if last_mat[1,i] == M.var_numbers2[1,j]
            last_mat[2,i] = M.var_numbers2[2,j]
            break
          endif
        endloop
      endloop
      last_mat = transp(msortby(transp(last_mat),2))
      last = last_mat[1,]
      if M.with_const == 1
        ols YyY const last --quiet
      else
        ols YyY last --quiet
      endif
      last = $xlist
      if (M.with_const == 1)
        last -= const
        M.k_new = $ncoeff-1
      else
        M.k_new = $ncoeff
      endif
      M.StartModel_b = $model
      strings M.StartModel_xnames = varnames($xlist)
    endif
  endif
else
  # Model reduced at given M.alpha (classic OLS)
  if M.with_const == 1
    ols YyY const X_list2 --quiet
  else
    ols YyY X_list2 --quiet
  endif
  if nelem($xlist) &gt; 1
    omit --auto=M.alpha --silent
  endif
  last = $xlist
  if M.with_const == 1
    last -= const
    M.k_new = $ncoeff - 1
  else
    M.k_new = $ncoeff
  endif
  M.StartModel_b = $model
  strings M.StartModel_xnames = varnames($xlist)
endif
M.k_old = nelem(last)
matrix M.StartModel = last
BACE_new_X_matrix(&quot;START&quot;, &amp;M)
BACE_matrix_precompute(&amp;M)
BACE_estimate(&amp;M)
#BACE_lprob(&amp;M)
M.lprob_old = M.lprob_new
M.mod_struct = M.mod_struct_new
M.ess_old = M.ess_new
</code>
</gretl-function>
<gretl-function name="BACE_model_structure" type="void" private="1">
 <params count="1">
  <param name="M" type="bundleref"/>
 </params>
<code>/*
Function constructs structure vector of starting model.
*/
# Starting values
matrix M.mod_struct_new = zeros(1,M.k)
# Setting 1 for variables in current draw
loop i=1..cols(M.StartModel) --quiet
  loop j=1..M.k --quiet
    if M.var_numbers2[1,j] == M.StartModel[i]
      M.mod_struct_new[M.var_numbers2[2,j]-1] = 1
      break
    endif
  endloop
endloop
# Filling in the mod_rank with starting structure
loop i=1..M.l_rank --quiet
  M.mod_rank[i] = M.mod_struct_new
endloop
</code>
</gretl-function>
<gretl-function name="BACE_correlation_coeff" type="scalar" private="1">
 <params count="1">
  <param name="M" type="bundleref"/>
 </params>
<code>/*
Function computes Pearson correlation coefficient between 2 ranking vectors:
Local variables:
tmp1, tmp2		- matrices with normalized analitycal and numerical probabilites
j				- scalar with number of the first row in rankings to ommit
Returns: correlation coefficient between analitical and numerical rankings
*/
# Starting values
matrix tmp1 = M.mod_rank_prob
matrix tmp2 = M.Numerical_Likelihood
scalar j = 0
# We check if there are zeros in numerical probablities...
# ...and if so we ommit such rows in both rankings.
loop i=1..M.l_rank --quiet
  if (tmp2[i] == 0.0)
    scalar j = i
    break
  endif
endloop
if (j &gt;= 3)
  tmp1 = tmp1[1:j-1,]
  tmp2 = tmp2[1:j-1,]
endif
# Now we have to normalize the given rankings
tmp1 -= maxc(tmp1)
tmp1 = exp(tmp1) ./ sumc(exp(tmp1))
tmp2 = tmp2 ./ sumc(tmp2)
return corr(tmp1, tmp2)
</code>
</gretl-function>
<gretl-function name="BACE_accept_prob" type="scalar" private="1">
 <params count="1">
  <param name="M" type="bundleref"/>
 </params>
<code>/*
Function computes log of probability (P_y) of given model based on selected model prior.
Local variables:
A, B - scalars for computing probability based on Binomial-beta
#
Returns: the scalar with probability of current draw
*/
if (M.acc_type == 1) # Binomial
  return (M.k_new - M.k_old)*(M.a - M.b) + M.lprob_new - M.lprob_old
elif (M.acc_type == 2) # Binomial-beta
  scalar A = 0
  scalar B = 0
  A = lngamma(M.k + 1) - lngamma(M.k_new + 1) - lngamma(M.k - M.k_new + 1)
  B = lngamma(M.a + M.k_new) + lngamma(M.k + M.b - M.k_new) - lngamma(M.a + M.b + M.k)
  return A + B + M.c
endif
</code>
</gretl-function>
<gretl-function name="BACE_matrix_precompute" type="void" private="1">
 <params count="1">
  <param name="M" type="bundleref"/>
 </params>
<code>/*
Function computes some linear algebra stuff for further computation.
*/
if (M.k_new &gt; 0)
  if (M.with_const == 1)
    matrix M.X_new = ones(M.N, 1) ~ M.X_new
  else
    matrix M.X_new = M.X_new
  endif
endif
</code>
</gretl-function>
<gretl-function name="BACE_jointness_pairs" type="void" private="1">
 <params count="6">
  <param name="MODE" type="string"/>
  <param name="n_pairs" type="scalarref"/>
  <param name="var_numbers" type="matrix"/>
  <param name="shift" type="scalarref"/>
  <param name="pairs" type="matrixref"/>
  <param name="jointness_m" type="matrix"/>
 </params>
<code>/*
Function for generating vector with pairs of hightly releated variables
and jointness statistics for these pairs:
MODE			- string with type of relation between variables
*n_pairs		- pointer to the scalar with number of pairs of related variables
*var_numbers	- pointer to the matrix holding numbers of variables
*shift			- pointer to the scalar holding total number of previous pairs (shift in the &quot;pairs&quot; vector)
*pairs			- pointer to the vector holding (ordered) pairs of hightly related variables
jointness_m		- matrix with counts for every pair
*/
matrix pairs_related = pairs[shift + 1 : shift + n_pairs, ]
shift += n_pairs
string pair_names = &quot;&quot;
loop i=1..n_pairs --quiet
  pair_names += &quot; &quot; ~ cnameget(jointness_m, pairs_related[i,2]) ~ &quot;,&quot; ~ cnameget(jointness_m, pairs_related[i,3])
endloop
matrix pairs_related = pairs_related[,1]
loop i=1..nelem(pairs_related) --quiet
  if ok(pairs_related[i]) &amp;&amp; abs(pairs_related[i]) == 999
    pairs_related[i] = sgn(pairs_related[1]) * 1/0
  endif
endloop
printf &quot;\n%s\n&quot;, MODE
rnameset(pairs_related, pair_names)
eval pairs_related
</code>
</gretl-function>
<gretl-function name="BACE_new_X_matrix" type="void" private="1">
 <params count="2">
  <param name="MODE" type="string"/>
  <param name="M" type="bundleref"/>
 </params>
<code>/*
Function creates matrix of explanatory variables (demeaned for Classic_BMA) for current draw.
MODE - mode in which function operates: START (for starting model) or NORMAL
*/
# If we have at least one variable we create new X matrix, otherwise it includes &quot;Ones&quot; only.
if (M.k_new &gt; 0)
  if (MODE == &quot;START&quot;) # Note: this happens only ones: for the starting model!!!
    BACE_model_structure(&amp;M)
  endif
  M.X_new_num = selifc(M.var_numbers2[2,], M.mod_struct_new)
  M.X_new = selifc(M.big_mat_dem[,2:], M.mod_struct_new)
else
  M.X_new_num = {}
  if (M.with_const == 1)
    M.X_new = ones(M.N,1)
  else
    M.X_new = {}
  endif
endif
</code>
</gretl-function>
<gretl-function name="BACE_forecast" type="void" private="1">
 <params count="2">
  <param name="M" type="bundleref"/>
  <param name="model" type="bundleref"/>
 </params>
<code>/*
This is a wrapper for functions which compute forecasts
*/
# Local variables
matrix Yhat_predict = zeros(M.h_predict,1)
matrix Yhat_predict_var = zeros(M.h_predict,1)
BACE_forecast_BACE(&amp;M, &amp;model, &amp;Yhat_predict, &amp;Yhat_predict_var)
# Averaging
M.Yhat_predict_avg += Yhat_predict * model.count
M.Yhat_predict_var_avg += Yhat_predict_var * model.count
</code>
</gretl-function>
<gretl-function name="BACE_accep_model" type="void" private="1">
 <params count="3">
  <param name="M" type="bundleref"/>
  <param name="model_nr_old" type="scalarref"/>
  <param name="model_nr" type="scalarref"/>
 </params>
<code>/*
Function computes &quot;probability&quot; of the new model and checks if it is bigger than some random value drawn form U(0,1).
*/
if BACE_accept_prob(&amp;M) &gt; log(randgen1(u,0,1))
  # We accept new model
  BACE_model_switch(&quot;ACCEPT&quot;, &amp;M)
  model_nr_old = model_nr
else
  # We restore old model
  BACE_model_switch(&quot;RESTORE&quot;, &amp;M)
endif
</code>
</gretl-function>
<gretl-function name="BACE_lprob" type="void" private="1">
 <params count="1">
  <param name="M" type="bundleref"/>
 </params>
<code>/*
Function computes lprob for current draw, i.e. marginal data density
*/
if M.with_const == 1
  M.lprob_new = -.5*((M.k_new + 1)*log(M.N) + M.N*log(M.ess_new))
else
  M.lprob_new = -.5*((M.k_new)*log(M.N) + M.N*log(M.ess_new))
endif
</code>
</gretl-function>
<gretl-function name="BACE_summary" type="void" private="1">
 <params count="1">
  <param name="M" type="bundleref"/>
 </params>
<code>/*
We summarise some BACE results and deleting redundand items from the returned bundle.
*/
scalar tmps, factor
strings title
matrix percents1, percents2
scalar NORM = M.Nrep - M.Nburn
M.bhat_avg = transp(M.bhat_avg)
M.bvar_avg = transp(M.bvar_avg)
# Normalisation of numerical probabilities of models in ranking
M.Numerical_Likelihood = M.mod_nume_prob / NORM
M.Post_Results = transp(M.var_prob / NORM)
M.bhat_avg = M.bhat_avg / NORM
M.bvar_avg = M.bvar_avg / NORM
M.consthat_avg = M.consthat_avg / NORM
M.constvar_avg = M.constvar_avg / NORM
if M.with_const == 1
  M.bhat_avg = M.consthat_avg ~ M.bhat_avg
  M.bvar_avg = M.constvar_avg ~ M.bvar_avg
  M.Post_Results = {1} | M.Post_Results
endif
# Average model size (including matrix for plot)
M.mod_size = sum(M.mod_sizes[,1] .* M.mod_sizes[,2])
M.mod_sizes[,2] = M.mod_sizes[,2] ./ NORM
M.mod_size_av = sum(M.mod_sizes[,1] .* M.mod_sizes[,2])
M.mod_size_sd = sqrt(sum((M.mod_sizes[,1] - M.mod_size_av) .^2 .* M.mod_sizes[,2]))
M.mod_sizes = M.mod_sizes ~ zeros(rows(M.mod_sizes),1)
tmps = M.av_model_size/M.k
loop i=1..rows(M.mod_sizes) --quiet
  if i == M.k
    factor = 1
  else
    factor = prodr(seq(1,M.k)) / (prodr(seq(1,i)) * prodr(seq(1,M.k-i)))
  endif
  M.mod_sizes[i,3] = (tmps^i * (1-tmps)^(M.k-i)) * factor
endloop
M.mod_size_sd_prior = sqrt(sum((M.mod_sizes[,1] - M.av_model_size) .^2 .* M.mod_sizes[,3]))
# Models size distribution
title = defarray(&quot;Size&quot;, &quot;Posterior&quot;, &quot;Prior&quot;)
cnameset(M.mod_sizes, title)
# Models size CDF
M.models_probs_cum = M.models_probs_cum / NORM
if M.post_n_models_accepted &lt; 100
  factor = 1
else
  factor = int(M.post_n_models_accepted/100)
endif
M.models_probs_cdf = seq(1, M.post_n_models_accepted, factor)'
M.models_probs_cdf = M.models_probs_cum[M.models_probs_cdf] ~ M.models_probs_cdf
# Best 100 models
percents1 = { 5; 25; 50; 75; 100 }
#percents1 = selifr(percents1, percents1 .&gt; M.l_rank)
percents1 = selifr(percents1, percents1 .&lt; M.post_n_models_accepted)
percents1 = percents1 ~ zeros(nelem(percents1))
if rows(percents1) &gt; 0
  loop i=1..rows(percents1) --quiet
    percents1[i,2] = M.models_probs_cum[percents1[i,1]]
  endloop
  percents1 = selifr(percents1, percents1[,2] .&gt; 0)
endif
# We look for certain percentiles
percents2 = { 50; 75; 90; 95; 99 }
if nelem(percents1) &gt; 0
  percents2 = selifr(percents2, percents2 .&gt; percents1[rows(percents1),2]) # In future: use [end,end] syntax
  tmps = percents1[rows(percents1),1]
else
  tmps = 1
endif
percents2 = zeros(nelem(percents2)) ~ percents2
nr = 1
loop i=tmps..M.post_n_models_accepted-1 --quiet
  if 100*M.models_probs_cum[i] &gt;= percents2[nr,2]
    percents2[nr,1] = i
    percents2[nr++,2] = M.models_probs_cum[i]
  endif
  if nr == rows(percents2)+1 || nr &gt; M.post_n_models_accepted
    break
  endif
endloop
percents2 = selifr(percents2, percents2[,1] .&gt; 0)
M.models_probs_percents = percents2 | { M.post_n_models_accepted , 1 }
if nelem(percents1) &gt; 0
  M.models_probs_percents = percents1 | M.models_probs_percents
endif
# We construct Post_Results matrix
matrix bvar = sqrt(M.bvar_avg - M.bhat_avg.^2)
matrix tmp = M.bhat_avg' ~ bvar'
M.Post_Results = M.Post_Results ~ tmp
tmp = M.Post_Results[,2] ./ M.Post_Results[,1]
M.Post_Results = M.Post_Results ~ tmp
tmp = sqrt((M.Post_Results[,3] .* M.Post_Results[,3] .+ M.Post_Results[,2] .* M.Post_Results[,2]) ./ M.Post_Results[,1] .- M.Post_Results[,4] .* M.Post_Results[,4])
M.Post_Results = M.Post_Results ~ tmp
title = defarray(&quot;PIP&quot;, &quot;Mean&quot;, &quot;Std.Dev.&quot;, &quot;Cond.Mean&quot;, &quot;Cond.Std.Dev&quot;)
printf &quot;\n&quot;
cnameset(M.Post_Results, title)
rnameset(M.Post_Results, M.all_names_sp_m)
# Forecasts
if M.h_predict &gt; 0
  M.Yhat_predict_avg = M.Yhat_avg / NORM
  M.Yhat_predict_var_avg = M.Yhat_var_avg / NORM
  M.Yhat_predict_var_avg = sqrt(M.Yhat_predict_var_avg - M.Yhat_predict_avg .^ 2)
  M.prediction = M.Y_mat_predict ~ M.Yhat_predict_avg ~ M.Yhat_predict_var_avg
  cnameset(M.prediction, M.Y_name ~ &quot; Mean Std.Dev.&quot;)
  rnameset(M.prediction, M.predict_obs_names)
endif
# Jointess analysis
if M.do_joint
  # We must clean up principal diagonal
  M.jointness_m[diag] = 0
  M.jointness_m = M.jointness_m / NORM
  if M.with_const == 1
    cnameset(M.jointness_m, M.all_names_sp_m[2:end])
    rnameset(M.jointness_m, M.all_names_sp_m[2:end])
  else
    cnameset(M.jointness_m, M.all_names_sp_m)
    rnameset(M.jointness_m, M.all_names_sp_m)
  endif
endif
# Cleaning up the bundle
delete M.show_progress
delete M.var_numbers2
delete M.big_mat
delete M.ZtZinv_new
delete M.k_new
delete M.lprob_new
delete M.X_new_num
delete M.X_new
delete M.ZtZinv_old
delete M.k_old
delete M.lprob_old
delete M.X_old_num
delete M.dj_new
delete M.dj_old
delete M.X_new_predict
delete M.X_old_predict
delete M.y_dem_sq
delete M.y_mean
delete M.yMy
delete M.mod_struct
delete M.mod_struct_new
delete M.var_prob
delete M.a
delete M.b
delete M.c
delete M.bhat
delete M.bvar
delete M.XtY
delete M.XtXinv
delete M.bhat_avg
delete M.bvar_avg
###
delete M.X_list
delete M.N
delete M.scaling_f
delete M.ess_new
delete M.ess_old
delete M.bhat_tmp
delete M.bvar_tmp
delete M.consthat_avg
delete M.constvar_avg
delete M.big_mat_dem
delete M.model_index_new
delete M.model_index_old
delete M.model_hex_index_new
delete M.model_hex_index_old
###
if M.h_predict &gt; 0
  delete M.big_mat_predict
  delete M.big_mat_dem_predict
  delete M.Y_mat_predict
  delete M.precision
  delete M.Yhat_predict_avg
  delete M.Yhat_predict_var_avg
  delete M.predict_obs_names
  catch delete M.ess
endif
</code>
</gretl-function>
<gretl-function name="BACE_setup" type="bundle" private="1">
 <params count="18">
  <param name="Y" type="series"/>
  <param name="Y_AR_p" type="int"/>
  <param name="X_list_m" type="matrix"/>
  <param name="acc_type" type="int" min="1" max="2" default="1"/>
  <param name="av_model_size" type="scalar" min="0" default="1"/>
  <param name="alpha" type="scalar" min="0" max="1" default="0.6"/>
  <param name="l_rank" type="int" min="2" default="4"/>
  <param name="do_joint" type="int" min="0" max="7" default="0"/>
  <param name="h_predict" type="int" min="0"/>
  <param name="Nrep" type="int" default="1e+06"/>
  <param name="burn" type="int" min="0" max="99" default="10"/>
  <param name="verbosity" type="int" min="1" max="2" default="1"/>
  <param name="Y_name" type="string"/>
  <param name="show_progress" type="bool" default="1"/>
  <param name="with_const" type="int"/>
  <param name="Norig" type="int"/>
  <param name="do_plot" type="bool"/>
  <param name="model_type" type="string"/>
 </params>
<code>/*
This function creates BUNDLE holding all BACE information
#
Local variables:
tmp_str - general purpose string
*/
printf &quot;\n#############################################################################\n&quot;
printf &quot;To do:&quot;
printf &quot;\n * Switch from M.mod_struct to M.mod_struct_old for consistency.&quot;
printf &quot;\n * Get rid off obsolete functions: BACE_model_switch, BACE_ols, BACE_lprob\n\tBACE_matrix_precompute, BACE_new_X_matrix.&quot;
printf &quot;\n * Fix const type selection in GUI.&quot;
printf &quot;\n * Simplify restoring estimates in BACE_collect_results().&quot;
printf &quot;\n * Fix prediction for time-series and/or where missing values.&quot;
printf &quot;\n * What to do with predicted values where we have empty model\n\t(if nelem(models_forecasts[i]) &gt; 0 in BACE_collect_results())?&quot;
printf &quot;\n * Work on speed.&quot;
printf &quot;\n * Clean up the code (including getting rid of stale functions).&quot;
printf &quot;\n#############################################################################\n&quot;
bundle M
list X_list = X_list_m
scalar M.with_const = with_const
if M.with_const == 1
  string M.const_type = &quot;Always&quot;
elif M.with_const == 2
  string M.const_type = &quot;Can be dropped&quot;
  X_list = X_list const
else
  string M.const_type = &quot;Never&quot;
endif
if Y_AR_p &gt; 0
  X_list = lags(Y_AR_p, Y) X_list
endif
list big_list = Y X_list
string tmp_str = &quot;&quot;
# Basic parsing and checking
# Global variables
series M.Y = Y
matrix M.X_list = X_list # Look down - repeated!!!
scalar M.acc_type = acc_type
scalar M.av_model_size = av_model_size
scalar M.alpha = alpha
scalar M.l_rank = l_rank
scalar M.do_joint = do_joint
scalar M.h_predict = h_predict
scalar M.Nrep = Nrep
scalar M.burn = burn
scalar M.verbosity = verbosity
scalar M.show_progress = show_progress
if ok(Norig)
  scalar M.Norig = Norig
endif
scalar M.do_plot = do_plot
# Local variables
matrix M.StartModel = {} # list with variables selected in starting model UWAGA: do wyrzucenia!!!
bundle StartModel_b
bundle M.StartModel_b = StartModel_b
matrix M.X_list = X_list # List of all explanatory variables UWAGA: powtórzone (patrz góra)
scalar M.k = nelem(X_list) # total number of indenpendent variables
scalar M.Nburn = round(burn/100*Nrep) # number of burn-in draws
matrix M.var_numbers = big_list # vector containing numbers of all variables (including Y) in dataset (not in the procedure)
if M.with_const == 2
  matrix M.var_numbers2 = M.var_numbers[2:1+M.k] | seq(2,1+M.k)
else
  matrix M.var_numbers2 = M.var_numbers[2:1+M.k] | seq(2,1+M.k)
  #matrix M.var_numbers2 = transp(msortby(transp(M.var_numbers[2:1+M.k] | seq(2,1+M.k)), 1)) # vector containing the dataset numbers of all variables and their order in the 'big_list'
endif
matrix M.big_mat = { big_list } # matrix M.of all variables (including Y)
matrix M.big_mat_dem = M.big_mat
strings M.DiscreteModelTypes = defarray(&quot;logit&quot;, &quot;probit&quot;)
list D = M.var_numbers2[1,]
eval D
# In case of &quot;out-of-sample&quot; prediction
if h_predict &gt; 0
  scalar M.first_obs = Y_AR_p+1 # the first observation for smpl command
  scalar M.last_obs = $nobs-h_predict # the last observation for smpl command
  matrix M.big_mat_predict = M.big_mat[rows(M.big_mat)-h_predict+1:rows(M.big_mat),] # &quot;out-of-sample&quot; matrix of all variables (including Y)
  matrix M.big_mat_dem_predict = M.big_mat_dem[rows(M.big_mat_dem)-h_predict+1:rows(M.big_mat_dem),] # &quot;out-of-sample&quot; matrix M.of all demeaned variables (including Y)
  matrix M.Y_mat_predict = M.big_mat_predict[,1] # &quot;out-of-sample&quot; matrix of the dependent variable
  matrix M.Yhat_predict = zeros(h_predict) # vector of Y predictions in current draw
  matrix M.Yhat_predict_var = zeros(h_predict) # vector of Y predictions in current draw (variances!!!)
  matrix M.precision = zeros(h_predict,1) # prediction precision
  matrix M.Yhat_predict_avg = zeros(h_predict,1) # vector of Y predictions - average
  matrix M.Yhat_predict_var_avg = zeros(h_predict,1) # predicion variance
  matrix M.prediction = {} # matrix with prediction results
  loop i=($nobs-h_predict+1)..$nobs --quiet
    tmp_str += strsub(obslabel(i), &quot; &quot;, &quot;&quot;) ~ &quot; &quot;
  endloop
  string M.predict_obs_names = tmp_str # obs labels for forecasts
  smpl M.first_obs M.last_obs #$nobs-h_predict-Y_AR_p #M.last_obs # setting sample
  matrix M.big_mat = M.big_mat[1:rows(M.big_mat)-h_predict,] # big_mat for limited sample
  matrix M.big_mat_dem = M.big_mat_dem[1:rows(M.big_mat_dem)-h_predict,] # big_mat_dem for limited sample
else
  matrix M.big_mat_dem_predict = {}
  matrix M.Yhat_avg = {}
  matrix M.Yhat_var_avg = {}
  matrix M.Y_mat_predict = {}
  string M.predict_obs_names = &quot;&quot;
endif
# New model
matrix M.ZtZinv_new = {} # inverse of Z'Z (X's without constant term)
scalar M.k_new = 0 # number of variables in the current (new) model
scalar M.lprob_new = 0 # scalar M.with natural logarithm of marginal density of the new model
matrix M.X_new_num = {} # vector containing numbers of variables in the new model
matrix M.X_new = {} # the X matrix M.for the current (new) model (demeaned)
# Old model
matrix M.ZtZinv_old = {} # old inverse of Z'Z (X's without constant term)
scalar M.k_old = 0 # number of variables in the previous (old) model
scalar M.lprob_old = 0 # scalar M.with natural logarithm of marginal density of the old model
matrix M.X_old_num = {} # vector containing numbers of variables in the old model
scalar M.dj_new = 0 # scalar M.needed for prediction precision computation
scalar M.dj_old = 0 # scalar M.needed for prediction precision computation
matrix M.X_new_predict = {} # &quot;out-of-sample&quot; the X matrix M.for the current (new) model (demeaned)
matrix M.X_old_predict = {} # &quot;out-of-sample&quot; the X matrix M.for the previous (old) model (demeaned)
matrix M.Y_mat = M.big_mat[,1] # matrix of the dependent variable
scalar M.y_dem_sq = M.big_mat_dem[,1]'M.big_mat_dem[,1] # sum of squares of the demeaned Y
scalar M.y_mean = meanc(M.Y_mat) # mean of the Y
scalar M.mod_size = 0 # size of models in MC3 (sum)
scalar M.yMy = 0 # scalar M.for P_y computation
matrix M.scaling_f = zeros(7,1) # vector containing the scaling factors
matrix M.mod_struct = zeros(1,M.k) # 0-1 vector containing the structure of the current model
matrix M.mod_struct_new = zeros(1,M.k) # 0-1 vector containing the structure of the current model
matrices M.mod_rank = array(M.l_rank) #-1 * ones(l_rank,M.k) # 0-1 matrix M.containing structure of models in ranking
matrix M.mod_rank_prob = zeros(l_rank,1) # probability of the models in ranking (analytical)
matrix M.mod_nume_prob = zeros(l_rank,1) # probability of the models in ranking (numerical)
matrices M.mod_rank_estimates = array(l_rank) # estimates of models in ranking
matrix M.var_prob = zeros(1,M.k) # vector containing PIPs
strings M.all_names_sp_m = varnames(X_list)
loop i=1..Y_AR_p --quiet
  M.all_names_sp_m[i] = strsub(M.all_names_sp_m[i], &quot;Y_$i&quot;, Y_name~&quot;_$i&quot;)
endloop
if M.with_const == 1
  strings const_name = defarray(&quot;const&quot;)
  M.all_names_sp_m = const_name + M.all_names_sp_m
endif
string M.Y_name = Y_name # string with name of denpendent variable
if do_joint
  matrix M.jointness_m = zeros(M.k, M.k) # square matrix M.containing counts of coexistence (jointness) of every pair of indenpendent variables
  strings M.jointess_measure_names = defarray(&quot;Doppelhofer-Weeks Measure (DW1)&quot;, &quot;Doppelhofer-Weeks Measure (DW2)&quot;, &quot;Ley-Steel Measure (LS1)&quot;, &quot;Ley-Steel Measure (LS2)&quot;, &quot;Strachan Measure&quot;, &quot;Yule's Q Measure (YQ)&quot;, &quot;Modified Yule's Q Measure (YQM)&quot;)
else
  matrix M.jointness_m = {}
endif
if acc_type == 1 # options for the prior
  string M.prior_name = &quot;Binomial&quot;
  scalar M.a = ln(av_model_size/M.k)
  scalar M.b = ln(1 - av_model_size/M.k)
  scalar M.c = 0
else
  string M.prior_name = &quot;Binomial-Beta&quot;
  scalar M.a = 1
  scalar M.b = (M.k - av_model_size)/av_model_size
  scalar M.c = lngamma(M.a + M.b) - lngamma(M.a) - lngamma(M.b)
endif
# Posterior results
matrix M.bhat = {} # vector containing the estimated coefficients for the current model
matrix M.bvar = {} # vector containing the variances of the coefficients for the current model
matrix M.XtY = {} # X'Y (part of OLS)
matrix M.XtXinv = {} # inverse of X'X (part of OLS)
matrix M.bhat_avg = zeros(M.k, 1) # vector containing average values of coefficients (over MCMC)
matrix M.bvar_avg = zeros(M.k, 1) # vector containing average values of variances of the coefficients (over MCMC)
matrix M.Numerical_Likelihood = {} # column vector containing numerical probabilities for models
matrix M.Post_Results = {} # matrix with all posterior results
matrix M.mod_sizes = {} # Vector with models size distribution
matrix M.models_probs_percents = {} # CDF-like matrix for accepted models
matrix M.models_probs_cdf = {} # accepted models CDF
matrix M.models_probs_cum = {} # accepted models cumulation
string M.model_type = model_type
scalar M.N = rows(M.big_mat)
scalar M.Y_AR_p = Y_AR_p # max Y lag order
matrix M.bhat_tmp = {} # temporary column vector containing the estimated coefficients for the current model (candidates)
matrix M.bvar_tmp = {} # temporary column vector containing the variances of the coefficients for the current model (candidates)
scalar M.ess_new = 0 # Error sum of squares in new model
scalar M.ess_old = 0 # Error sum of squares in old model
scalar M.consthat_avg = 0
scalar M.constvar_avg = 0
scalar M.post_n_models = 0 # number of considered models
scalar M.post_n_models_accepted = 0 # number of accepted models
# Those below to delete: modify BACE_model_switch()
scalar M.model_index_new = 0 # decimal index of new model
scalar M.model_index_old = 0 # decimal index of old model
string M.model_hex_index_new = &quot;&quot; # hex index of model
string M.model_hex_index_old = &quot;&quot; # hex index of model
########################
if verbosity == 1
  set warnings off
endif
return M
</code>
</gretl-function>
<gretl-function name="BACE_show_progress" type="void" private="1">
 <params count="4">
  <param name="rep" type="scalarref"/>
  <param name="percentage" type="scalarref"/>
  <param name="progress" type="scalarref"/>
  <param name="Nrep" type="scalar"/>
 </params>
<code>/*
Function prints overall progress
*/
if (rep == percentage)
  printf &quot;%d%s..&quot;, floor(100 * rep/Nrep), &quot;%&quot;
  percentage += progress
  mwrite({floor(100 * rep/Nrep)}, &quot;BACE_progress&quot;)
endif
#flush
</code>
</gretl-function>
<gretl-function name="BACE_ols" type="void" private="1">
 <params count="1">
  <param name="M" type="bundleref"/>
 </params>
<code>/*
Function computes OLS for BACE
*/
matrix uhat = {}
matrix vcv = {}
if M.k_new &gt; 0
  M.bhat_tmp = mols(M.Y_mat, M.X_new, &amp;uhat, &amp;vcv)
  M.bvar_tmp = diag(vcv)
  M.ess_new = uhat'uhat
  if M.h_predict &gt; 0
    M.XtXinv = invpd(M.X_new'M.X_new)
  endif
else
  M.bhat_tmp = {}
  M.bvar_tmp = {}
  M.ess_new = M.y_dem_sq
endif
</code>
</gretl-function>
<gretl-function name="BACE_estimate" type="void" private="1">
 <params count="1">
  <param name="M" type="bundleref"/>
 </params>
<code>/*
This is wrapper for different estimators used in different methods (for future).
*/
# We re-create series
series Y = M.Y
if M.Y_AR_p &gt; 0
  lags M.Y_AR_p ; Y
endif
# We create a X list on-the-fly
list X = selifc(M.var_numbers2[1,], M.mod_struct_new)
if M.with_const == 1
  X += const
endif
# We estimate current model
if M.k_new &gt; 0
  if M.model_type == &quot;linear&quot;
    ols Y X --quiet
  elif M.model_type == &quot;logit&quot;
    logit Y X --quiet
  elif M.model_type == &quot;probit&quot;
    probit Y X --quiet
  elif M.model_type == &quot;poisson&quot;
    poisson Y X --quiet
  endif
  if M.with_const == 2 &amp;&amp; $ncoeff &gt; 1 &amp;&amp; $model.parnames[1] == &quot;const&quot;
    M.bhat_tmp = $coeff[2:] | $coeff[1]
    M.bvar_tmp = ($stderr[2:] | $stderr[1]).^2
  else
    M.bhat_tmp = $coeff
    M.bvar_tmp = $stderr.^2
  endif
  M.ess_new = $ess
  if M.h_predict &gt; 0
    fcast --out-of-sample --quiet
    M.Yhat_predict = $fcast
    if nelem(instrings(M.DiscreteModelTypes, M.model_type)) == 0
      M.Yhat_predict_var = $fcse.^2 + $fcast.^2
    else
      M.Yhat_predict_var = ones(M.h_predict)*NA
    endif
    #M.XtXinv = $vcv / ($ess / $df)
  endif
  #printf &quot;\n##############\n&quot;
  #eval -.5*M.N*((1+log(2*$pi)-log(M.N))) -.5*M.N*log(M.ess_new)
  #eval $lnl +.5*M.N*((1+log(2*$pi)-log(M.N))) -.5*M.k_new*log(M.N)
  #M.lprob_new = -.5*($bic - M.N*((1+log(2*$pi)-log(M.N))))
  if M.model_type == &quot;linear&quot;
    M.lprob_new = -.5*$bic
  else
    M.lprob_new = $lnl -.5*M.k_new*log(M.N)
  endif
else
  M.bhat_tmp = {}
  M.bvar_tmp = {}
  M.ess_new = M.y_dem_sq
endif
#BACE_ols(&amp;M)
</code>
</gretl-function>
<gretl-function name="BACE_find_model" type="scalar" private="1">
 <params count="5">
  <param name="M" type="bundleref"/>
  <param name="known_models_array" type="bundlesref"/>
  <param name="known_models_bundle" type="bundleref"/>
  <param name="known_models_indexes" type="matrixref"/>
  <param name="known_models_hex_indexes" type="stringsref"/>
 </params>
<code>/*
This function looking for model in known_models_array/bundle
*M							- pointer to the main bundle
*known_models_array			- pointer to the array of (already estimated) models (for small k)
*known_models_bundle		- pointer to the bundle of (already estimated) models (for big k)
*known_models_indexes		- pointer to the matrix with models indexes (for small k)
*known_models_hex_indexes	- pointer to the array of strings with models indexes in hex format (for big k)
#
Returns: 1 if model exists, 0 elswhere.
*/
bundle model
# We restore already estimated model
if M.max_dim_array_of_models == 0
  key = BACE_bintohexconvert(&amp;M)
  #catch model = known_models_bundle[key]
  if inbundle(known_models_bundle, key)
    model = known_models_bundle[key]
  endif
else
  BACE_bintodecconvert(&amp;M)
  model = known_models_array[M.model_index_new]
endif
M.model = model
if (inbundle(model, &quot;count&quot;))
  M.lprob_new = model.lprob
  return 1
else
  return 0
endif
</code>
</gretl-function>
<gretl-function name="BACE_collect_results" type="void" private="1">
 <params count="7">
  <param name="M" type="bundleref"/>
  <param name="known_models" type="bundleref"/>
  <param name="models_counter" type="matrixref"/>
  <param name="models_lprob" type="matrixref"/>
  <param name="models_estimates" type="matricesref"/>
  <param name="models_structure" type="matricesref"/>
  <param name="models_forecasts" type="matricesref" optional="true"/>
 </params>
<code>/*
Function collects results from MC3 experiment.
*/
matrix idx, var_idx, bhat, mod_struct, models_probs, X_new_num #, models_probs_cum, percents1, percents2
matrices models_structure_rank, models_estimates_rank
scalar nr
scalar weight = 0
if M.with_const == 1
  matrix bhat_avg = zeros(M.k+1)
  matrix bvar_avg = zeros(M.k+1)
else
  matrix bhat_avg = zeros(M.k)
  matrix bvar_avg = zeros(M.k)
endif
matrix mod_sizes = zeros(M.k)
matrix var_prob = zeros(1,M.k)
if M.do_joint
  matrix jointness_m = zeros(M.k,M.k)
endif
if M.h_predict
  Yhat_avg = zeros(M.h_predict)
  Yhat_var_avg = zeros(M.h_predict)
endif
# We set the number of visited models
M.post_n_models = nelem(known_models)
known_models = null
# We select objects only for accepted models
idx = selifr(seq(1, M.Nrep+1)', models_counter .&gt; 0)
M.post_n_models_accepted = nelem(idx)
models_counter = models_counter[idx]
models_estimates = models_estimates[idx]
models_structure = models_structure[idx]
if M.h_predict
  models_forecasts = models_forecasts[idx]
endif
# Models size cumulative distribution
models_probs = mreverse(msortby(models_counter ~ idx ~ seq(1, M.post_n_models_accepted)', 1))
M.models_probs_cum = cum(dsort(models_probs[,1]))
# We build analytical and numerical rankings
M.l_rank = xmin(M.l_rank, M.post_n_models_accepted)
models_probs = models_probs[1:M.l_rank,]
M.mod_nume_prob = models_probs[,1]
M.mod_rank_prob = models_lprob[models_probs[,2]]
models_structure_rank = models_structure[models_probs[,3]]
models_estimates_rank = models_estimates[models_probs[,3]]
# We restore estimates for models in ranking
loop i=1..M.l_rank --quiet
  var_idx = {}
  mod_struct = models_structure_rank[i]
  M.mod_rank[i] = mod_struct
  if M.with_const == 1
    var_idx = { 1 } ~ selifc(M.var_numbers2[2,], mod_struct)
  else
    if sum(mod_struct) != 0
      var_idx = selifc(M.var_numbers2[2,], mod_struct) - 1
    endif
  endif
  if nelem(models_estimates_rank[i])
    M.mod_rank_estimates[i] = models_estimates_rank[i][,1] ~ sqrt(models_estimates_rank[i][,2]) ~ transp(var_idx)
  endif
endloop
# We average over all accepted models
loop i=1..nelem(models_counter) --quiet
  weight = models_counter[i]
  mod_struct = models_structure[i]
  ## Original BACE
  if M.with_const == 1
    var_idx = { 1 } ~ selifc(M.var_numbers2[2,], mod_struct)
  else
    if sum(mod_struct) != 0
      var_idx = selifc(M.var_numbers2[2,], mod_struct) - 1
    else
      var_idx = {}
    endif
  endif
  if nelem(models_estimates[i])
    bhat = models_estimates[i][,1]
    bhat_avg[var_idx] += weight * bhat
    bvar_avg[var_idx] += weight * (models_estimates[i][,2] + bhat .^ 2)
    mod_sizes[sum(mod_struct)] += weight
    var_prob += weight * mod_struct
  endif
  if M.do_joint
    jointness_m = upper(jointness_m .+ weight * ((mod_struct .* mod_struct') .&gt; 0))
  endif
  if M.h_predict
    if nelem(models_forecasts[i]) &gt; 0
      Yhat_avg += weight * models_forecasts[i][,1]
      Yhat_var_avg += weight * models_forecasts[i][,2]
    endif
  endif
endloop
# We save collected results in bundle M
# Coefficients and variances
if M.with_const == 1
  M.bhat_avg = bhat_avg[2:,]
  M.bvar_avg = bvar_avg[2:,]
  M.consthat_avg = bhat_avg[1]
  M.constvar_avg = bvar_avg[1]
else
  M.bhat_avg = bhat_avg
  M.bvar_avg = bvar_avg
endif
# Probability of variables
M.var_prob = var_prob
# Average model size
#M.mod_size = mod_size
# Jointness analysis
if M.do_joint
  M.jointness_m = jointness_m
endif
# Forecasts
if M.h_predict
  M.Yhat_avg = Yhat_avg
  M.Yhat_var_avg = Yhat_var_avg
endif
# Models size distribution
M.mod_sizes = seq(1, M.k)' ~ mod_sizes
</code>
</gretl-function>
<gretl-function name="BACE_new_X_matrix_predict" type="matrix" private="1">
 <params count="2">
  <param name="M" type="bundleref"/>
  <param name="model" type="bundleref" optional="true"/>
 </params>
<code>/*
Function constructs X_matrix for out-of-sample forecasts
for given model (if model is 'null' we take mod_struct_new from
the M bundle)
*model	- pointer to the bundle with certain model
*M		- pointer to the main bundle
*/
if !exists(model)
  return selifc(M.big_mat_dem_predict[,2:], M.mod_struct_new)
else
  return selifc(M.big_mat_dem_predict[,2:], model.mod_struct_new)
endif
</code>
</gretl-function>
<gretl-function name="BACE_forecast_BACE" type="void" private="1">
 <params count="4">
  <param name="M" type="bundleref"/>
  <param name="model" type="bundleref"/>
  <param name="Yhat_predict" type="matrixref"/>
  <param name="Yhat_predict_var" type="matrixref"/>
 </params>
<code>/*
This function computes forecast of Y (average mean and average standard deviation) if we use some direct methods (like BACE).
*model				- pointer to the bundle with certain model
*M					- pointer to the main bundle
*Yhat_predict		- pointer to the vector with forecasts
*Yhat_predict_var	- pointer to the vector with forecasts variances
*/
# Local variables
scalar n_AR = 0
if (M.with_const == 1)
  scalar sigma2 = model.ess / (M.N - model.k_new - 1)
else
  scalar sigma2 = model.ess / (M.N - model.k_new)
endif
matrix X_new_predict = BACE_new_X_matrix_predict(&amp;M, &amp;model)
matrix Y_AR_cols
if (M.Y_AR_p != 0)
  matrix Y_AR_struct = transp(model.mod_struct_new[1:M.Y_AR_p])
  Y_AR_cols = selifr(transp(seq(1, M.Y_AR_p)), Y_AR_struct)
  n_AR = sumc(Y_AR_struct)
endif
BACE_forecast_generic(&amp;Yhat_predict, &amp;Yhat_predict_var, M.h_predict, model.bhat, model.XtXinv, &amp;sigma2, M.Y_AR_p, &amp;Y_AR_cols, &amp;n_AR, X_new_predict, 0, M.with_const)
Yhat_predict_var = (Yhat_predict_var + Yhat_predict .^ 2)
</code>
</gretl-function>
<gretl-function name="BACE_forecast_dynamic_matrix" type="void" private="1">
 <params count="4">
  <param name="period" type="scalarref"/>
  <param name="Y_AR_cols" type="matrixref"/>
  <param name="Yhat_predict" type="matrixref"/>
  <param name="X_new_predict_row" type="matrixref"/>
 </params>
<code>/*
This function substitutes lagged Y values in the X_new_predict_row vector
by its forecast calculated for previous periods.
*period				- poriod for which we construct X_new_predict_row vector
*Y_AR_cols			- pointer to the vector indicating cols with AR(p) coefficients
*Yhat_predict		- pointer to the vector with forecasts
*X_new_predict_row	- pointer to the vector with values of X-es (out-of-sample)
#
*/
# Local variables
matrix Y_lags = selifr(period - Y_AR_cols, Y_AR_cols .&lt; period)
scalar Y_lags_rows = rows(Y_lags)
if (Y_lags_rows != 0)
  matrix columns = seq(1, Y_lags_rows)
  X_new_predict_row[columns] = Yhat_predict[Y_lags]'
endif
</code>
</gretl-function>
<gretl-function name="BACE_forecast_generic_variance" type="scalar" private="1">
 <params count="4">
  <param name="XT" type="matrixref"/>
  <param name="XtXinv" type="matrixref"/>
  <param name="sigma2" type="scalarref"/>
  <param name="Yhat_predict_var" type="matrixref" optional="true"/>
 </params>
<code>/*
Function computes forecast variance as:
- scalar, if XT is a row vector
- vector, if XT is matrix
*XT					- pointer to the vector with values of X-es (out-of-sample)
*XtXinv				- pointer to the inverse of covariance matrix
*sigma2				- pointer to the scalar with sigma-square value
*Yhat_predict_var	- pointer to the matrix with forecast variances (null if we return scalar)
Returns: forecast variance (if XT is a vector), NA elsewhere
*/
if rows(XT) &gt; 1
  Yhat_predict_var = diag(sigma2 * (1 + qform(XT, XtXinv)))
  return NA
else
  return sigma2 * (1 + qform(XT, XtXinv))
endif
</code>
</gretl-function>
<gretl-function name="BACE_forecast_generic" type="void" private="1">
 <params count="12">
  <param name="Yhat_predict" type="matrixref"/>
  <param name="Yhat_predict_var" type="matrixref"/>
  <param name="h_predict" type="scalar"/>
  <param name="bhat" type="matrix"/>
  <param name="XtXinv" type="matrix"/>
  <param name="sigma2" type="scalarref"/>
  <param name="Y_AR_p" type="scalar"/>
  <param name="Y_AR_cols" type="matrixref"/>
  <param name="n_AR" type="scalarref"/>
  <param name="X_new_predict" type="matrix"/>
  <param name="random" type="bool" default="0"/>
  <param name="with_const" type="scalar"/>
 </params>
<code>/*
This is a generic function which computes forecasts (static or dynamic)
*Yhat_predict		- pointer to the vector with forecasts
*Yhat_predict_var	- pointer to the vector with forecasts variances
h_predict			- forecasts horizon
bhat				- vector with coefficients
XtXinv				- inverse of covariance matrix
*sigma2				- pointer to the scalar with sigma-square value
Y_AR_p				- order of autoregression (AR(p))
*Y_AR_cols			- pointer to the vector indicating cols with AR(p) coefficients
*n_AR				- number of Y laggs
X_new_predict		- matrix with values of X-es (out-of-sample)
*/
scalar Yhat_predict_current
matrix X_new_predict_row
matrix XT
# Mean and Variance
# Static forecasts
if (n_AR == 0)
  if (with_const == 1)
    XT = ones(h_predict, 1) ~ X_new_predict
  else
    XT = X_new_predict
  endif
  Yhat_predict_expected = XT * bhat
  Yhat_predict = Yhat_predict_expected
  BACE_forecast_generic_variance(&amp;XT, &amp;XtXinv, &amp;sigma2, &amp;Yhat_predict_var)
else
  # Dynamic forecasts if we do have lagged Y (always static for the first period)
  loop i=1..h_predict --quiet
    X_new_predict_row = X_new_predict[i,]
    if (i &gt; 1)
      BACE_forecast_dynamic_matrix(&amp;i, &amp;Y_AR_cols, &amp;Yhat_predict, &amp;X_new_predict_row)
    endif
    if (with_const == 1)
      XT = {1} ~ X_new_predict_row
    else
      XT = X_new_predict_row
    endif
    Yhat_predict_expected = XT * bhat
    Yhat_predict[i] = Yhat_predict_expected
    Yhat_predict_var[i] = BACE_forecast_generic_variance(&amp;XT, &amp;XtXinv, &amp;sigma2)
  endloop
endif
</code>
</gretl-function>
<gretl-function name="BACE_jointness_measure" type="matrix" private="1">
 <params count="1">
  <param name="M" type="bundleref"/>
 </params>
<code>/*
Function computes jointness measure based on given jointness matrix.
Local variables:
var_prob - vector with posterior probability of indenpendent variables
a, b, c, d	 - scalars according to Paul Hofmarcher, Jesus Crespo Cuaresma, Bettina Grün, Stefan Humer, Mathias Moser, Bivariate jointness measures in Bayesian Model Averaging: Solving the conundrum, Journal of Macroeconomics, Volume 57, 2018, Pages 150-165, ISSN 0164-0704, DOI: 10.1016/j.jmacro.2018.05.005.
#
Returns: matrix with computed jointness measure
*/
scalar a
scalar b
scalar c
scalar d
scalar N
scalar loghuge = 999 # proxy for infty
matrix var_prob = M.Post_Results[,1]
matrix jointness_measure = zeros(rows(M.jointness_m), cols(M.jointness_m))
loop i=1..M.k --quiet
  loop j=i+1..M.k --quiet
    # We compute a,b,c,d
    a = M.jointness_m[i,j] # p(i &amp; j)
    b = var_prob[i] - a	   # p(i &amp; ~j)
    c = var_prob[j] - a	   # p(~i &amp; j)
    d = 1 - b - c - a	   # p(~i &amp; ~j)
    N = a + b + c + d
    if M.do_joint == 4 # Ley-Steel Measure (LS2)
      if a == 1
        jointness_measure[i,j] = loghuge
      elif a == 0
        jointness_measure[i,j] = -loghuge
      else
        jointness_measure[i,j] = log(a/(b + c))
      endif
    elif M.do_joint == 2 # Doppelhofer-Weeks Measure (DW2)
      if b * c == 0
        jointness_measure[i,j] = loghuge
      else
        if a * d == 0
          jointness_measure[i,j] = -loghuge
        else
          if (a*d)/(b*c) &lt;= 0
            jointness_measure[i,j] = -loghuge
          else
            jointness_measure[i,j] = log((a*d)/(b*c))
          endif
        endif
      endif
    elif M.do_joint == 3 # Ley-Steel Measure (LS1)
      jointness_measure[i,j] = log(a/(a + b + c))
    elif M.do_joint == 1 # Doppelhofer-Weeks Measure (DW1)
      if a == 0 &amp;&amp; (a + b)*(a + c) != 0
        jointness_measure[i,j] = 0
      elif a == 0 &amp;&amp; (a + b)*(a + c) &gt;= 0
        jointness_measure[i,j] = loghuge
      elif a == 0 &amp;&amp; (a + b)*(a + c) &lt; 0
        jointness_measure[i,j] = -loghuge
      else
        jointness_measure[i,j] = log(a*N/((a + b)*(a + c)))
      endif
    elif M.do_joint == 5 # Strachan Measure
      jointness_measure[i,j] = (a+b)/N * (a+c)/N * log(a*N/(b*c))
    elif M.do_joint == 6 # Yule's Q (YQ)
      jointness_measure[i,j] = (a*d - b*c) / (a*d + b*c)
    elif M.do_joint == 7 # Modified Yule's Q (YQM)
      jointness_measure[i,j] = ((a+0.5)*(d+0.5)-(b+0.5)*(c+0.5)) / ((a+0.5)*(d+0.5)+(b+0.5)*(c+0.5)-0.5)
    endif
  endloop
endloop
cnameset(jointness_measure, cnameget(M.jointness_m))
rnameset(jointness_measure, rnameget(M.jointness_m))
return jointness_measure
</code>
</gretl-function>
<gretl-function name="BACE_main" type="void" private="1">
 <params count="1">
  <param name="M" type="bundleref"/>
 </params>
<code>/*
This is main BACE function with complete MC3 simulation procedure.
*/
# Local variables
scalar progress = floor(M.Nrep/10) # progress of MC3
scalar percentage = progress # percentage of progress of MC3
string model_id # string containing model id (0-1 'image')
scalar model_nr	# iteration number under which model's data are stored in matrices/arrays
scalar model_nr_old
bundle known_models
matrix models_counter = zeros(M.Nrep+1) # this is because starting model has labeled as 1
matrix models_lprob = zeros(M.Nrep+1)
matrix models_ess = zeros(M.Nrep+1)
matrix models_k_new = zeros(M.Nrep+1) # To delete
matrices models_estimates = array(M.Nrep+1)
matrices models_structure = array(M.Nrep+1)
matrix mod_struct_draw
if M.h_predict &gt; 0
  matrices models_forecasts = array(M.Nrep+1)
else
  matrices models_forecasts = null
endif
# Sample setting for prediction
if M.h_predict &gt; 0
  smpl M.first_obs M.last_obs
endif
##################
# Part 1: Starting model
# We estimate starting model and construct starting mod_rank_struct and mod_rank
BACE_initial_model(&amp;M)
model_id = sprintf(&quot;%d&quot;, M.mod_struct)[1:end-1] # we trim the &quot;\n&quot; at the end !!!
model_nr = M.Nrep+1
model_nr_old = model_nr
known_models[model_id] = model_nr
models_structure[model_nr] = M.mod_struct_new
models_lprob[model_nr] = M.lprob_new
models_estimates[model_nr] = M.bhat_tmp ~ M.bvar_tmp
models_ess[model_nr] = M.ess_new
models_k_new[model_nr] = M.k_new # ??? Probably to delete
if M.h_predict &amp;&amp; M.k_new
  #BACE_forecast2(&amp;M)
  models_forecasts[model_nr] = M.Yhat_predict ~ M.Yhat_predict_var
endif
##################
# Part 2: MC3
if M.show_progress == 1
  printf &quot;\nOverall progress: &quot;
endif
flush
loop rep=1..M.Nrep --quiet
  # Saving data for the old model
  #BACE_model_switch(&quot;SAVE&quot;, &amp;M)
  # Now we draw the number of candidate variable
  potential_var = randint(0, M.k)
  # Now we modify the list of variables (remove an existing variable or add a new variable)
  if potential_var &gt; 0
    mod_struct_draw = M.mod_struct
    mod_struct_draw[potential_var] = !mod_struct_draw[potential_var]
    M.k_new = sum(mod_struct_draw)
    M.mod_struct_new = mod_struct_draw
    model_id = sprintf(&quot;%d&quot;, mod_struct_draw)[1:end-1]
    if inbundle(known_models, model_id)
      model_nr = known_models[model_id]
      M.lprob_new = models_lprob[model_nr]
    else
      # We estimate newly drawn model
      #BACE_new_X_matrix(&quot;NORMAL&quot;, &amp;M)
      #BACE_matrix_precompute(&amp;M)
      BACE_estimate(&amp;M)
      #BACE_lprob(&amp;M)
      model_nr = rep
      known_models[model_id] = model_nr
      models_structure[model_nr] = M.mod_struct_new
      models_lprob[model_nr] = M.lprob_new
      models_estimates[model_nr] = M.bhat_tmp ~ M.bvar_tmp
      models_ess[model_nr] = M.ess_new
      models_k_new[model_nr] = M.k_new # ??? Probably to delete
      # Out-of-sample forecasts
      if M.h_predict &amp;&amp; M.k_new
        #BACE_forecast2(&amp;M)
        models_forecasts[model_nr] = M.Yhat_predict ~ M.Yhat_predict_var
      endif
    endif
    # Now we decide if to accept the new model
    BACE_accep_model(&amp;M, &amp;model_nr_old, &amp;model_nr)
  endif
  # Now we count models
  if rep &gt; M.Nburn
    models_counter[model_nr_old] += 1
  endif
  # Flushing output - showing progress
  if M.show_progress == 1
    BACE_show_progress(&amp;rep, &amp;percentage, &amp;progress, M.Nrep)
  endif
endloop
# Now we collect results (averaging and rankings)
BACE_collect_results(&amp;M, &amp;known_models, &amp;models_counter, &amp;models_lprob, &amp;models_estimates, &amp;models_structure, &amp;models_forecasts)
</code>
</gretl-function>
<gretl-function name="BACE_bcheck" type="string" private="1">
 <params count="16">
  <param name="UserOpts" type="bundle" const="true"/>
  <param name="k" type="scalar"/>
  <param name="Y_AR_p" type="scalarref"/>
  <param name="with_const" type="scalarref"/>
  <param name="acc_type" type="scalarref"/>
  <param name="av_model_size" type="scalarref"/>
  <param name="alpha" type="scalarref"/>
  <param name="l_rank" type="scalarref"/>
  <param name="do_joint" type="scalarref"/>
  <param name="h_predict" type="scalarref"/>
  <param name="Nrep" type="scalarref"/>
  <param name="burn" type="scalarref"/>
  <param name="verbosity" type="scalarref"/>
  <param name="show_progress" type="scalarref"/>
  <param name="do_plot" type="scalarref"/>
  <param name="model_type" type="stringref"/>
 </params>
<code>/*
This function checks options bundle and returns error message in
any problem found.
Parameters:
UserOpts - bundle with user-defined options for BACE
k - number of independent variables
*/
string err = &quot;&quot;
scalar err2
bundle Options
scalar arg_val
string arg_name
strings Integers = defarray(&quot;Y_AR_p&quot;, &quot;with_const&quot;, &quot;acc_type&quot;, &quot;l_rank&quot;, &quot;do_joint&quot;, &quot;h_predict&quot;, &quot;Nrep&quot;, &quot;burn&quot;, &quot;verbosity&quot;)
strings Booleans = defarray(&quot;show_progress&quot;, &quot;do_plot&quot;)
strings Scalars = defarray(&quot;av_model_size&quot;, &quot;alpha&quot;)
strings ModelTypes = defarray(&quot;linear&quot;, &quot;logit&quot;, &quot;probit&quot;, &quot;poisson&quot;)
if $version &gt;= 20221 &amp;&amp; $sysinfo.gui_mode == 1
  do_plot_tmp = 1
else
  do_plot_tmp = 0
endif
# We set the default Nrep conditional on k
if k &lt;= 10
  Nrep = 1000
elif k &lt;= 15
  Nrep = 10000
elif k &lt;= 19
  Nrep = 100000
else
  Nrep = 1e+06
endif
# Template bundle with default values
scalar Options[&quot;Y_AR_p&quot;] = 0
scalar Options[&quot;with_const&quot;] = 1
scalar Options[&quot;acc_type&quot;] = 1
scalar Options[&quot;av_model_size&quot;] = k/2
scalar Options[&quot;alpha&quot;] = 0.6
scalar Options[&quot;l_rank&quot;] = xmin(2^(k-1), 40)
scalar Options[&quot;do_joint&quot;] = 0
scalar Options[&quot;h_predict&quot;] = 0
scalar Options[&quot;Nrep&quot;] = Nrep
scalar Options[&quot;burn&quot;] = 10
scalar Options[&quot;verbosity&quot;] = 2
scalar Options[&quot;show_progress&quot;] = 1
scalar Options[&quot;do_plot&quot;] = do_plot_tmp
string Options[&quot;model_type&quot;] = &quot;linear&quot;
# General checking, but still needs some manual work
err2 = bcheck(&amp;Options, UserOpts)
if err2
  err = &quot;Look at the PDF documentation for expected types of arguments.&quot;
endif
# We check integers
loop i=1..nelem(Integers) --quiet
  arg_name = Integers[i]
  arg_val = Options[arg_name]
  if arg_val != int(arg_val)
    err += sprintf(&quot;Argument %s must be an integer&quot;, arg_name)
  endif
endloop
# We check booleans
loop i=1..nelem(Booleans) --quiet
  arg_name = Booleans[i]
  arg_val = Options[arg_name]
  if arg_val != int(arg_val) || arg_val &lt; 0 || arg_val &gt; 1
    err += sprintf(&quot;Argument %s must be a bool&quot;, arg_name)
  endif
endloop
# We check model type
if inbundle(UserOpts, &quot;model_type&quot;) &amp;&amp; strlen(UserOpts[&quot;model_type&quot;]) &amp;&amp; !nelem(instrings(ModelTypes, UserOpts[&quot;model_type&quot;]))
  err += sprintf(&quot;Unknown model type: '%s'&quot;, UserOpts[&quot;model_type&quot;])
endif
# We set arguments
Y_AR_p = Options[&quot;Y_AR_p&quot;]
with_const = Options[&quot;with_const&quot;]
acc_type = Options[&quot;acc_type&quot;]
av_model_size = Options[&quot;av_model_size&quot;]
alpha = Options[&quot;alpha&quot;]
l_rank = Options[&quot;l_rank&quot;]
do_joint = Options[&quot;do_joint&quot;]
h_predict = Options[&quot;h_predict&quot;]
Nrep = Options[&quot;Nrep&quot;]
burn = Options[&quot;burn&quot;]
verbosity = Options[&quot;verbosity&quot;]
show_progress = Options[&quot;show_progress&quot;]
do_plot = Options[&quot;do_plot&quot;]
model_type = Options[&quot;model_type&quot;]
# We check arguments for valid values
if Y_AR_p &lt; 0
  err += &quot;Y lags (Y_AR_p) takes the integer values&quot;
elif with_const &lt; 0 || with_const &gt; 2
  err += &quot;Constant in model takes the integer values in the range [0; 2]&quot;
elif acc_type &lt; 1 || acc_type &gt; 2
  err += &quot;Model prior takes the integer values in the range [1; 2]&quot;
elif alpha &lt; 0 || alpha &gt; 1
  err += &quot;The significance level (alpha) takes the real values in the range [0; 1]&quot;
elif do_joint &lt; 0 || do_joint &gt; 7
  err += &quot;Jointess type (do_joint) takes the integer values in the range [1; 7]&quot;
elif h_predict &lt; 0
  err += &quot;Number of out-of-sample forecasts (h_predict) takes the integer values&quot;
elif h_predict &gt;= round($nobs/2)
  printf(&quot;Number of out-of-sample forecasts is more than 50%s of sample length.\n&quot;, &quot;%&quot;)
elif Nrep &lt; 0
  err += &quot;Total number of replications (Nrep) takes the integer values&quot;
elif burn &lt; 0 || burn &gt; 99
  err += &quot;Percentage of burn-in draws (do_burn) takes the integer values in the range [0; 99]&quot;
elif verbosity &lt; 1 || verbosity &gt; 2
  err += &quot;Verbosity takes the integer values in the range [1; 2]&quot;
endif
return err
</code>
</gretl-function>
<gretl-function name="BACE_forecast2" type="void" private="1">
 <params count="1">
  <param name="M" type="bundleref"/>
 </params>
<code>matrix Y_AR_cols, X_new_predict, Y_AR_struct
Yhat_predict = zeros(M.h_predict)
Yhat_predict_var = zeros(M.h_predict)
n_AR = 0
X_new_predict = selifc(M.big_mat_dem_predict[,2:], M.mod_struct_new)
if M.with_const == 1
  sigma2 = M.ess_new / (M.N - M.k_new - 1)
else
  sigma2 = M.ess_new / (M.N - M.k_new)
endif
if M.Y_AR_p
  Y_AR_struct = transp(M.mod_struct_new[1:M.Y_AR_p])
  Y_AR_cols = selifr(transp(seq(1, M.Y_AR_p)), Y_AR_struct)
  n_AR = sum(Y_AR_struct)
endif
BACE_forecast_generic(&amp;Yhat_predict, &amp;Yhat_predict_var, M.h_predict, M.bhat_tmp, M.XtXinv, &amp;sigma2, M.Y_AR_p, &amp;Y_AR_cols, &amp;n_AR, X_new_predict, 0, M.with_const)
Yhat_predict_var = (Yhat_predict_var + Yhat_predict .^ 2)
M.Yhat_predict = Yhat_predict
M.Yhat_predict_var = Yhat_predict_var
</code>
</gretl-function>
<gretl-function name="BACE_heatmap" type="void" private="1">
 <params count="2">
  <param name="M" type="bundle" const="true"/>
  <param name="MODE" type="string"/>
 </params>
<code>/*
M - BACE result bundle, MODE - string indicating image mode {&quot;inclusions&quot;, &quot;jointness&quot;}
*/
scalar nrows, ncols, tmp, height, width, minval, maxval
string grid, title, xlabel, ylabel, xtics, ytics, colorbox, palette, rotate
matrix m
# We set general image options
if MODE == &quot;inclusions&quot;
  title = sprintf(&quot;Variables Inclusions Based on Best %d Models&quot;, M.l_rank)
  xlabel = &quot;Cumulative Model Probabilities&quot;
  ylabel = &quot;Variable&quot;
  colorbox = &quot;unset colorbox&quot;
  height = xmax(int(M.k/41*768), 480)
  width = xmin(xmax(int(M.l_rank/20*1024), 640), 1024)
  m = zeros(M.l_rank, M.k)
  loop i=1..M.l_rank --quiet
    m[i,] = M.mod_rank[i]
  endloop
  m = mreverse(m')
  palette = &quot;0 'white', 1 'red'&quot;
else
  title = sprintf(&quot;Jointness Based on %s&quot;, M.jointess_measure_names[M.do_joint])
  xlabel = &quot;Variable&quot;
  ylabel = xlabel
  height = xmin(xmax(int(M.k/41*1024), 640), 900)
  width = xmin(xmax(int(M.k/41*1024), 900), 1024)
  m = mreverse(BACE_jointness_measure(&amp;M))
  minval = minc(minr(m))
  maxval = maxc(maxr(m))
  if minval == 0
    palette = sprintf(&quot;0 'white', %s 'red'&quot;, strsub(sprintf(&quot;%f&quot;, maxval), &quot;,&quot;, &quot;.&quot;))
  else
    palette = sprintf(&quot;%s 'blue', 0 'white', %s 'red'&quot;, strsub(sprintf(&quot;%f&quot;, minval), &quot;,&quot;, &quot;.&quot;), strsub(sprintf(&quot;%f&quot;, maxval), &quot;,&quot;, &quot;.&quot;))
  endif
  rotate = &quot;set xtics rotate by 45 right&quot;
endif
nrows = rows(m)
ncols = cols(m)
# We set tics
ytics = &quot;(&quot;
loop i=1..M.k --quiet
  ytics += sprintf(&quot;\&quot;%s\&quot; %d&quot;, M.all_names_sp_m[i], M.k-i)
  if i == M.k
    ytics += sprintf(&quot;)&quot;)
  else
    ytics += sprintf(&quot;, &quot;)
  endif
endloop
xtics = &quot;(&quot;
if MODE == &quot;inclusions&quot;
  tmp = 0
  loop i=1..M.l_rank --quiet
    tmp += M.Numerical_Likelihood[i]
    xtics += sprintf(&quot;\&quot;%.2f\&quot; %d&quot;, tmp, i-1)
    if i == M.l_rank
      xtics += sprintf(&quot;)&quot;)
    else
      xtics += sprintf(&quot;, &quot;)
    endif
  endloop
else
  loop i=1..M.k --quiet
    xtics += sprintf(&quot;\&quot;%s\&quot; %d&quot;, M.all_names_sp_m[i], i-1)
    if i == M.k
      xtics += sprintf(&quot;)&quot;)
    else
      xtics += sprintf(&quot;, &quot;)
    endif
  endloop
endif
# We need to cast given matrix to its string representation
loop i=1..nrows --quiet
  loop j=1..ncols --quiet
    if MODE == &quot;inclusions&quot;
      grid += sprintf(&quot;%d&quot;, m[i,j])
    else
      grid += strsub(sprintf(&quot;%.4f&quot;, m[i,j]), &quot;,&quot;, &quot;.&quot;)
    endif
    if j == ncols
      if i != nrows
        grid += sprintf(&quot;\n&quot;)
      endif
    else
      grid += sprintf(&quot;\t&quot;)
    endif
  endloop
endloop
# We plot heatmap
plot
  printf &quot;set term pngcairo font \&quot;Vera,9\&quot; size %d,%d noenhanced&quot;, width, height
  literal set encoding utf8
  literal set decimalsign '.'
  literal set nokey
  literal set datafile missing &quot;&quot;
  #literal set datafile separator &quot;\t&quot;
  literal set x2tics 1 format '' scale 0,0.001
  literal set y2tics 1 format '' scale 0,0.001
  literal set mx2tics 2
  literal set my2tics 2
  printf &quot;set palette defined (%s)&quot;, palette
  printf &quot;set title \&quot;%s\&quot;&quot;, title
  printf &quot;set xlabel \&quot;%s\&quot;&quot;, xlabel
  printf &quot;set ylabel \&quot;%s\&quot;&quot;, ylabel
  printf &quot;set xtics %s&quot;, xtics
  printf &quot;set ytics %s&quot;, ytics
  printf &quot;%s&quot;, colorbox
  printf &quot;%s&quot;, rotate
  literal set autoscale fix
  literal set link x
  literal set link y
  literal set grid front mx2tics my2tics lw 2 lt -1 lc rgb 'white'
  printf &quot;$map &lt;&lt; EOD&quot;
  printf &quot;%s&quot;, grid
  printf &quot;EOD&quot;
  literal plot $map matrix with image
end plot --output=display
</code>
</gretl-function>
<gretl-function name="BACE_Plot" type="void" private="1">
 <params count="1">
  <param name="M" type="bundleref"/>
 </params>
<code>/*
BACE result bundle plot function.
*/
# Heatmap for variable inclusion
BACE_heatmap(M, &quot;inclusions&quot;)
# Heatmap for jointness
if M.do_joint
  BACE_heatmap(M, &quot;jointness&quot;)
endif
# Models size distribution
plotmat = mreverse(M.mod_sizes, 1)
plot plotmat
  options with-lp fit=none
  printf &quot;set title \&quot;%s\&quot;&quot;, &quot;Model Size Distribution&quot;
  printf &quot;set xlabel \&quot;%s\&quot;&quot;, &quot;Model Size&quot;
  printf &quot;set ylabel \&quot;%s\&quot;&quot;, &quot;Fraction&quot;
end plot --output=display
# Models size CDF
plotmat = M.models_probs_cdf
plot plotmat
  options with-line fit=none
  literal set grid
  printf &quot;set title \&quot;%s\&quot;&quot;, &quot;Model Size CDF&quot;
  printf &quot;set xlabel \&quot;%s\&quot;&quot;, &quot;Number of Models&quot;
  printf &quot;set ylabel \&quot;%s\&quot;&quot;, &quot;Posterior Probability Mass&quot;
end plot --output=display
</code>
</gretl-function>
<sample-script filename="examples/BACE_sample.inp">
set verbose off

# Usage:
open greene9_1.gdt
include BACE.gfn
list greene = capital labor nfirm

# We set the seed in order to exact reproduction of results
set seed 1000000

scalar y_lags = 0
scalar with_const = 1
scalar model_prior = 1
scalar prior_avg_model_size = 1.5
scalar alpha = 0.6
scalar top_ranked_model = 4
scalar joint = 1
scalar forecasts = 0
scalar Nrep = 2000
scalar Nburn = 10
scalar verbosity = 1
scalar progress = 1

BACE_GUI(valadd, y_lags, greene, with_const, model_prior, prior_avg_model_size, alpha, top_ranked_model, joint, forecasts, Nrep, Nburn, verbosity, progress)

/*
The above example consists of three blocks.
The first block is just opening of the so called \cmd{greene9\_1}
dataset, which is bundled in every standard gretl installation.
This dataset contains cross-sectional data on manufacturing
of transportation equipment presented as Table 9.1 in
Greene, Econometric Analysis, 4e}.
We also set the seed in order to exact reproduction of the results.

The second block is the definition of the greene list which
contains three independent variables available in the greene9_1 dataset.

The third block contains the definition for Bayesian Averaging of Classical
Estimates analysis: no lags for Y variable (not applicable since we have
cross-sectional data), constant always included, binomial model prior,
prior average model size set to 1.5 (which means that we have uniform model prior),
significance level for the initial model set to 0.6, 4 top ranked models,
jointness analysis with Ley-Steel Measure, without out-of-sample predictions,
10000 replications with 10% burn-in draws, basic output (verbosity set to 1)
and progress overall progress is printed.
*/
####################################################################################

/*
Suppose we want to run the same analysis but following
Occam's razor principle. The simplest way is setting the prior
average model size to 1. We also want to have ''random'' constant,
i.e. intercept can be dropped in any model. We also want to save
results of the BACE analysis in the bundle \cmd{results\_b},
the code should be as follows:
*/
prior_avg_model_size = 1
with_const = 2
results_b = BACE_GUI(valadd, y_lags, greene, with_const, model_prior, prior_avg_model_size, alpha, top_ranked_model, joint, forecasts, Nrep, Nburn, verbosity, progress)

/*
Suppose we want to compute forecasts for 3 observations and print
additional information in results (verbosity set to 2) and we don't
want to see any progress. The code would be as follows:
*/
/*
forecasts = 3
verbosity = 2
progress = 0
BACE_GUI(valadd, y_lags, greene, with_const, model_prior, prior_avg_model_size, alpha, top_ranked_model, joint, forecasts, Nrep, Nburn, verbosity, progress)
*/

/*
Suppose we want to calculate Doppelhofer-Weeks Measure instead of
already computed Ley-Steel Measure. Since the type of jointness measure
is controlled by do_join field in the result bundle, the only thing
we have to do is to set the value of do_join to 2 and print BACE
results again. The code should be as follows:
*/
results_b.do_joint = 2
BACE_Print(&amp;results_b)

results_b.do_joint = 3
BACE_Print(&amp;results_b)

results_b.do_joint = 4
BACE_Print(&amp;results_b)

results_b.do_joint = 7
BACE_Print(&amp;results_b)
</sample-script>
</gretl-function-package>
</gretl-functions>

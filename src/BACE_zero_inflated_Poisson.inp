/*
   Based on code from Gretl User's Guide, https://gretl.sourceforge.net/guidefiles/example-26.4.inp
   This library is for MLE estimation of zero-inflated Poisson model.
*/

/* compute log probabilities for the plain Poisson model */
function series BACE_ln_poi_prob(series y, list X, matrix *beta)
    xb = lincomb(X, beta)
    
    return -exp(xb) + y*xb - lngamma(y+1)
end function

/* compute log probabilities for the zero-inflated Poisson model */
function series BACE_ln_zip_prob(series *y, list X, matrix *beta, scalar *p0)
    series ret

    # check if the probability is in [0,1]; otherwise, return NA
    if p0 > 1 || p0 < 0
        ret = NA
    else
        ret = BACE_ln_poi_prob(y, X, &beta) + log(1-p0)
        ret = y==0 ? log(p0 + exp(ret)) : ret
    endif
    
    return ret
end function

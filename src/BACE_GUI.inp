function bundle BACE_GUI (
    int model_type[1:6:1] "Model type" {"logit (including ordered)", "probit (including ordered)", "poisson", "tobit", "zip", "linear"},
      series Y "Dependent variable",
      int Y_AR_p[0::0] "Y lags (time-series only)",
      list X_list[null] "List of independent variables (X)",
      int with_const[0:2:1] "Constant in model" {"Never", "Always", "Can be dropped"},
      int model_prior[0:2:1] "Model prior" {"none", "Binomial", "Beta-Binomial"},
      int bic_type[1:4:1] "Bayesian information criterion" {"BIC", "HBIC", "IBIC", "EBIC"},
      int do_joint[0:7:0] "Jointness analysis" {"None", "Doppelhofer-Weeks Measure (DW1)",\
      "Doppelhofer-Weeks Measure (DW2)", "Ley-Steel Measure (LS1)", "Ley-Steel Measure (LS2)",\
      "Strachan Measure (SM)", "Yule's Q Measure (YQ)", "Modified Yule's Q Measure (MYQ)"},
      int Npredict[0::0] "Number of out-of-sample forecasts",
      int verbosity[1:2:2] "Verbosity",
      bool show_progress[1] "Show overall progress",
      bool do_plot[1] "Plot graphs?")

    /*
       GUI-based function to carry out BACE analysis.
       Function is a wrapper to bundle-based BACE() interface.
    */

    # Basic parsing and checking
    bundle Options, RES
    string err

    # Mapping GUI model_types indexes to strings
    strings ModelTypes = defarray("logit", "probit", "poisson", "tobit", "zip", "linear")

    string Y_name = argname(Y)
    series @Y_name = Y
    scalar Options["Y_AR_p"] = Y_AR_p
    scalar Options["with_const"] = with_const
    scalar Options["model_prior"] = model_prior
    scalar Options["do_joint"] = do_joint
    scalar Options["Npredict"] = Npredict
    scalar Options["verbosity"] = verbosity
    scalar Options["show_progress"] = show_progress
    scalar Options["do_plot"] = do_plot
    scalar Options["bic_type"] = bic_type
    string Options["model_type"] = ModelTypes[model_type]
    scalar Options["_gui"] = 1

    RES = BACE(@Y_name, X_list, Options)

    if inbundle(RES, "err")
        err = RES["err"]
        funcerr "@err !!!"
    endif

    return RES
end function

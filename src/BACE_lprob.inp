function void BACE_lprob (bundle *M)
    /*
    Function computes lprob for current draw, i.e. marginal data density
    */
    if M.with_const == 1
        M.lprob_new = -.5*((M.k_new + 1)*log(M.N) + M.N*log(M.ess_new))
    else
        M.lprob_new = -.5*((M.k_new)*log(M.N) + M.N*log(M.ess_new))
    endif
end function

function void BACE_main (bundle *M)
/*
   This is main BACE function with complete MC3 simulation procedure.
    */
    # Local variables
    scalar progress = floor(M.Nrep/10) # progress of MC3
    scalar percentage = progress # percentage of progress of MC3
    scalar kwnown_model = 0 # do we know current (1) or do we have to estimate it (0)
    bundles known_models_array = array(M.max_dim_array_of_models) # we have to manage empty model: we shift the numeration by 1 to the right!!!
    bundle known_models_bundle
    matrix known_models_indexes
    strings known_models_hex_indexes
    ### New code ###
    string model_id # string containing model id (0-1 'image')
    scalar model_nr	# iteration number under which model's data are stored in matrices/arrays
    scalar model_nr_old
    bundle known_models
    matrix models_counter = zeros(M.Nrep+1) # this is because starting model has labeled as 1
    matrix models_lprob = zeros(M.Nrep+1)
    matrix models_ess = zeros(M.Nrep+1)
    matrix models_k_new = zeros(M.Nrep+1) # To delete
    matrices models_estimates = array(M.Nrep+1)
    matrices models_structure = array(M.Nrep+1)
    matrices models_X_new_num = array(M.Nrep+1)
    matrix mod_struct_draw
    if M.h_predict > 0
        matrices models_forecasts = array(M.Nrep+1)
    else
        matrices models_forecasts = null
    endif
    ### End ########
    # Sample setting for prediction
    if M.h_predict > 0
        smpl M.first_obs M.last_obs
    endif
    ##################
    # Part 1: Starting model
    # We estimate starting model
    BACE_initial_model(&M, &known_models_array, &known_models_bundle, &known_models_indexes, &known_models_hex_indexes)
    ### New code ###
    model_id = sprintf("%d", M.mod_struct)[1:end-1] # we trim the "\n" at the end !!!
    model_nr = M.Nrep+1
    model_nr_old = model_nr
    known_models[model_id] = model_nr
    models_structure[model_nr] = M.mod_struct_new
    models_lprob[model_nr] = M.lprob_new
    models_estimates[model_nr] = M.bhat_tmp ~ M.bvar_tmp
    models_ess[model_nr] = M.ess_new
    models_k_new[model_nr] = M.k_new # ??? Probably to delete
    models_X_new_num[model_nr] = M.X_new_num # !!!
    if M.h_predict > 0 && M.k_new > 0
        BACE_forecast(&M)
        models_forecasts[model_nr] = M.Yhat ~ M.Yhat_var
    endif
    ### End ########
    ##################
    # Part 2: MC3
    if M.show_progress == 1
        printf "\nOverall progress: "
    endif
    flush
    loop rep=1..M.Nrep --quiet
        # Saving data for the old model
        BACE_model_switch("SAVE", &M)

        # Now we draw the number of candidate variable
        potential_var = randint(0, M.k)

        # Now we modify the list of variables (remove an existing variable or add a new variable)
        if potential_var > 0
            ### New code ###
            mod_struct_draw = M.mod_struct
            mod_struct_draw[potential_var] = !mod_struct_draw[potential_var]
            M.k_new = sum(mod_struct_draw) # To uncomment
            M.mod_struct_new = mod_struct_draw
            model_id = sprintf("%d", mod_struct_draw)[1:end-1]
            ### End ########

            kwnown_model = BACE_find_model(&M, &known_models_array, &known_models_bundle, &known_models_indexes, &known_models_hex_indexes)
            if kwnown_model == 0
                # We see model for the first time
                # We create the new matrix of indenpendent variables and run some precomputes based on it
                M.k_new = sumr(M.mod_struct_new)
                BACE_new_X_matrix("NORMAL", &M)
                BACE_matrix_precompute(&M)
                BACE_estimate(&M)
                BACE_lprob(&M)
                BACE_known_results(&M, &known_models_array, &known_models_bundle, &known_models_indexes, &known_models_hex_indexes)
            endif

            ### New code ###
            if inbundle(known_models, model_id)
                model_nr = known_models[model_id]
                #M.lprob_new = models_lprob[model_nr] # To uncomment
            else
                # We estimate newly drawn model
                #BMA_estimate(&M)
                model_nr = rep
                known_models[model_id] = model_nr
                models_structure[model_nr] = M.mod_struct_new
                models_lprob[model_nr] = M.lprob_new
                models_estimates[model_nr] = M.bhat_tmp ~ M.bvar_tmp
                models_ess[model_nr] = M.ess_new
                models_k_new[model_nr] = M.k_new # ??? Probably to delete
                models_X_new_num[model_nr] = M.X_new_num # !!!
                # Out-of-sample forecasts
                if M.h_predict > 0 && M.k_new > 0
                    BACE_forecast(&M)
                    models_forecasts[model_nr] = M.Yhat ~ M.Yhat_var
                endif
            endif
            ### End ########

            BACE_accep_model(&M, &known_models_array, &known_models_bundle, &model_nr_old, &model_nr) # Last two added
        endif

        # Essentials of MC3: building of rankings, averaging the results and jointness stuff
        if rep > M.Nburn
            # We count how many times given model has appeared
            BACE_model_count(&M, &known_models_array, &known_models_bundle)
            ### New code ###
            models_counter[model_nr_old] += 1
            ### End ########
        endif

        # Flushing output - showing progress
        if M.show_progress == 1
            BACE_show_progress(&rep, &percentage, &progress, M.Nrep)
        endif
    endloop
    ### New code ###
    bundle M_new = M
    delete M_new.mod_rank # (!!!) => change in BACE_setup()
    matrices M_new.mod_rank = array(M.l_rank) # estimates of models in ranking
    strings const_name = defarray("const")
    if M_new.with_const == 1
        M_new.all_names_sp_m = const_name + M_new.all_names_sp_m    
    endif
    ### End ########

    # Results collection
    BACE_collect_results(&M, &known_models_array, &known_models_bundle, &known_models_indexes, &known_models_hex_indexes)

    # We build rangings
    BACE_build_rank(&M, &known_models_array, &known_models_bundle, &known_models_indexes, &known_models_hex_indexes)

    ### New code ###    
    BACE_collect_results2(&M_new, &known_models, &models_counter,
      &models_lprob, &models_estimates, &models_structure, &models_forecasts)

    ### OK ###
    /*
    loop i=1..nelem(M_new.mod_rank_estimates) --quiet
        tmp = M_new.mod_rank_estimates[i]
        if nelem(tmp)
            tmp2 = tmp[,1] ~ tmp[,2]
            S = M_new.all_names_sp_m[tmp[,3]]
            modprint tmp2 S
        endif
    endloop
    printf "mod_nume_prob: \n%f\n", M_new.mod_nume_prob / (M.Nrep - M.Nburn)
    printf "mod_rank_prob: \n%f\n", M_new.mod_rank_prob / (M.Nrep - M.Nburn)
    printf "post_n_models: %d\n", M_new.post_n_models
    printf "post_n_models_accepted: %d\n", M_new.post_n_models_accepted
    if M_new.with_const == 1
        M_new.bhat_avg = M_new.consthat_avg | M_new.bhat_avg
        M_new.bvar_avg = M_new.constvar_avg | M_new.bvar_avg
    endif
    M_new.bhat_avg = M_new.bhat_avg / (M.Nrep - M.Nburn)
    M_new.bvar_avg = M_new.bvar_avg / (M.Nrep - M.Nburn)
    M_new.var_prob = M_new.var_prob' / (M.Nrep - M.Nburn)
    if M_new.with_const == 1
        M_new.var_prob = {1} | M_new.var_prob
    endif
    tmp = M_new.var_prob ~ M_new.bhat_avg ~ sqrt(M_new.bvar_avg - M_new.bhat_avg .^ 2)
    cnameset(tmp, "PIP Mean Std.Dev")
    rnameset(tmp, M_new.all_names_sp_m)
    eval tmp
    M_new.jointness_m = M_new.jointness_m ./ (M.Nrep - M.Nburn)
    if M_new.with_const == 1
        cnameset(M_new.jointness_m, M_new.all_names_sp_m[2:end])
        rnameset(M_new.jointness_m, M_new.all_names_sp_m[2:end])
    else
        cnameset(M_new.jointness_m, M_new.all_names_sp_m)
        rnameset(M_new.jointness_m, M_new.all_names_sp_m)
    endif    
    eval M_new.jointness_m
    */
    BACE_summary(&M_new)
    BACE_Print(&M_new)
    printf "\n#### bosko ####\n\n\n"
    ### End ########

    # We must delete known_models array (memory free)
    delete known_models_array
    delete known_models_bundle
    delete known_models_indexes
    delete known_models_hex_indexes
end function

